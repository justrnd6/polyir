# Writes TargetTexts.cpp (core/src/translate/TargetTexts.hpp): each targets/<lang>/<Lang>.translate page, and the files under
# its runtime/ folder, as text built into libpolyir, with the page's rules as polyir-translatec compiled them
# (`CompiledPage<Lang>()`, core/CMakeLists.txt). Run by core/CMakeLists.txt with -DTARGETS_DIR=... -DOUTPUT=...
file(GLOB pages "${TARGETS_DIR}/*/*.translate")
list(SORT pages)
set(body "")
set(declarations "")

foreach(page ${pages})
    get_filename_component(folder "${page}" DIRECTORY)
    get_filename_component(language "${folder}" NAME)
    string(TOLOWER "${language}" language)
    file(RELATIVE_PATH shown "${TARGETS_DIR}/.." "${page}")
    file(READ "${page}" text)
    file(GLOB_RECURSE runtime RELATIVE "${folder}" "${folder}/runtime/*")
    list(SORT runtime)
    set(files "")

    foreach(runtime_file ${runtime})
        file(READ "${folder}/${runtime_file}" content)
        string(APPEND files "{\"${runtime_file}\", R\"polyir_target(${content})polyir_target\"}, ")
    endforeach()

    get_filename_component(stem "${page}" NAME_WE)
    string(APPEND declarations "  const TranslateRules& CompiledPage${stem}();\n")
    string(APPEND body "    targets.push_back(Target{\"${language}\", \"${shown}\", R\"polyir_target(${text})polyir_target\", {${files}}, false, {}, {}, &CompiledPage${stem}()});\n")
endforeach()

set(source "// GENERATED by cmake/EmbedTargets.cmake from targets/: edit the .translate pages, not this file.
#include \"translate/TargetTexts.hpp\"

namespace polyir::translate {

${declarations}
  Vector<Target> EmbeddedTargets() {
    Vector<Target> targets;
${body}
    return targets;
  }

}  // namespace polyir::translate
")
file(WRITE "${OUTPUT}.next" "${source}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.next" "${OUTPUT}")
