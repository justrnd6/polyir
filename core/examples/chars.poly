// `char` — a pure alias for `i8` at the LLVM level, with real `'c'`
// literal syntax (one character, no escapes in v1 — same policy as
// `STRING_LIT`). Usable as a `var`/`let` type, and as a `grid`/
// `mutarray` element type.
//
// NOTE: polyir has no cast operator (`as`, etc.) in v1 — a bare `char`
// (i8) value can't be directly RETURNED from an `-> i64` function
// (hits the SAME pre-existing, already-documented "every literal is
// i64 regardless of context, no return-type coercion" gap `README.md`
// already calls out for `i32`). Every function below instead uses a
// `char`/`char`-vs-`char` COMPARISON only as an `if` CONDITION
// (`icmp` between two same-width i8s, never itself returned) and
// returns ordinary `i64` literals — the safe, general pattern for
// working with any narrower scalar type in v1.

func literalEqualsItself() -> i64 {
  let c: char = 'A'
  if (c == 'A') { return 1 }
  return 0
}

func literalsDistinguishCorrectly() -> i64 {
  let a: char = 'a'
  let b: char = 'b'
  if (a == b) { return 0 }
  return 1
}

// `char` as a `grid` element type.
func gridOfCharsRoundTrip() -> i64 {
  let g: grid<char, 1, 3>
  g[0, 0] = 'x'
  g[0, 1] = 'y'
  g[0, 2] = 'z'
  if (g[0, 0] == 'x' && g[0, 1] == 'y' && g[0, 2] == 'z') { return 1 }
  return 0
}

// `char` as a `mutarray` element type — grown via `push`, read back.
func darrayOfCharsRoundTrip() -> i64 {
  let cs: mutarray<char> = mutarray<char>()
  cs.push('h')
  cs.push('i')
  if (cs[0] == 'h' && cs[1] == 'i') { return 1 }
  return 0
}
