// `grid<T,R,C>` — a fixed-size dense 2D array. Representation: a flat
// row-major `[R*C x T]` LLVM array (`g[row,col]` is sugar over
// `flat[row*C+col]`) — same "uninitialized, filled by index-assignment"
// local-only scope as `T[N]`, no literal-constructor syntax.

func fillAndWeight(scale: i64) -> i64 {
  let g: grid<i64, 3, 4>
  for (r = 0; r < 3; r = r + 1) {
    for (c = 0; c < 4; c = c + 1) {
      g[r, c] = (r * 4 + c) * scale
    }
  }
  // A sum weighted by ROW, not just a plain total — this picks a
  // number that comes out DIFFERENT under column-major or transposed
  // indexing, not one that would happen to match by accident.
  var total: i64 = 0
  for (r = 0; r < 3; r = r + 1) {
    for (c = 0; c < 4; c = c + 1) {
      total = total + g[r, c] * (r + 1)
    }
  }
  return total
}

// A direct read-after-write on one cell, isolated from the fill loops
// above — confirms `g[r,c]=val` / `g[r,c]` round-trip exactly, not just
// that SOME plausible-looking number comes out of the bigger example.
func singleCellRoundTrip() -> i64 {
  let g: grid<i64, 2, 2>
  g[0, 0] = 10
  g[0, 1] = 20
  g[1, 0] = 30
  g[1, 1] = 40
  return g[1, 0] - g[0, 1]
}

// `.rows()`/`.cols()` — pure compile-time constants read straight off
// the declared type, no runtime computation.
func dimsCheck() -> i64 {
  let g: grid<i64, 3, 4>
  return g.rows() * 100 + g.cols()
}
