// A tiny 2-layer MLP (2 inputs -> 2 ReLU hidden neurons -> 1 linear
// output) that solves XOR — the classic "hello world" of neural nets,
// and the textbook example of why a single linear layer can't (XOR
// isn't linearly separable, a hidden layer is required). Weights/
// biases are HAND-CHOSEN, not trained — polyir has no autodiff/gradient
// descent, so this is forward-pass (inference) only. The weights
// below are an exact, known solution (not approximate): every
// intermediate value is a small integer representable exactly in
// `double`, so the raw output is EXACTLY `0.0`/`1.0`, not "close to."
//
// Real neural net layers are naturally `tensor<double,...>`-shaped:
// a weight MATRIX (`tensor<double, outDim, inDim>`, 2D) and a bias
// VECTOR (`tensor<double, outDim>`, genuinely 1-dimensional — the
// exact case `tensor<T,N>`'s own indexing bug was just fixed for).
// Batching multiple inputs through the same network would naturally
// add one more leading dimension (`tensor<double, batch, inDim>`) —
// not done here, to keep the single-example forward pass legible.

func relu(x: double) -> double {
  if (x < 0.0) {
    return 0.0
  }
  return x
}

// Hidden layer: `w1` is a 2x2 weight MATRIX (2 neurons, 2 inputs
// each); `b1` is a genuinely 1-DIMENSIONAL bias tensor. Output layer:
// `w2` is a 1D weight tensor (dot product with the hidden
// activations); the output bias is just a plain scalar, since there's
// only one output neuron.
func xorForward(x1: double, x2: double) -> double {
  let w1: tensor<double, 2, 2>
  w1[0, 0] = 1.0
  w1[0, 1] = 1.0
  w1[1, 0] = 1.0
  w1[1, 1] = 1.0

  let b1: tensor<double, 2>
  b1[0] = 0.0
  b1[1] = 0.0 - 1.0

  let hidden: tensor<double, 2>
  for (i = 0; i < 2; i = i + 1) {
    var preActivation: double = b1[i]
    preActivation = preActivation + w1[i, 0] * x1
    preActivation = preActivation + w1[i, 1] * x2
    hidden[i] = relu(preActivation)
  }

  let w2: tensor<double, 2>
  w2[0] = 1.0
  w2[1] = 0.0 - 2.0
  let b2: double = 0.0

  var output: double = b2
  for (i = 0; i < 2; i = i + 1) {
    output = output + w2[i] * hidden[i]
  }
  return output
}

// A thresholded 0/1 CLASSIFICATION on top of the raw forward pass —
// reads more like a genuine classifier than the bare `double` output.
func xorPredict(x1: double, x2: double) -> i64 {
  if (xorForward(x1, x2) >= 0.5) {
    return 1
  }
  return 0
}
