// `v.shuffle(i0, i1, ...)` — a single-vector permute/duplicate over a
// `vec<Elem,N>`, lowered to a real `shufflevector`. Each index must be
// a compile-time `INT_LIT` (same restriction `.dim(i)` already has on
// grid/tensor). Two-vector blending (picking lanes from either of two
// vectors) isn't exposed at the polyir level yet, just this permute.
//
// 4 params would exceed `--jit`'s 0-3 scalar-param v1 ceiling (see
// ../cli/README.md), so the last lane is a literal here instead.

func reverse4(a: i64, b: i64, c: i64) -> i64 {
  let v: vec<i64, 4> = vec[a, b, c, 40]
  let r: vec<i64, 4> = v.shuffle(3, 2, 1, 0)
  return r[0] * 1000 + r[1] * 100 + r[2] * 10 + r[3]
}

// A mask can repeat an index — "duplicate" is just a special case of
// "permute," no separate operation needed.
func duplicateFirstTwo(a: i64, b: i64, c: i64) -> i64 {
  let v: vec<i64, 4> = vec[a, b, c, 4]
  let r: vec<i64, 4> = v.shuffle(0, 0, 1, 1)
  return r[0] * 1000 + r[1] * 100 + r[2] * 10 + r[3]
}
