// `vec<Elem, N>` — SIMD vectors. `vec[...]` literals infer their own
// element type and count, same as how int/float literals need no
// annotation; reading an element (`v[i]`) reuses the ordinary postfix
// `[index]` syntax, routed to `extractelement` instead of `gep`+`load`;
// elementwise `+ - * /` on two vectors routes to the SAME `fadd`/`fmul`
// (float) vs `add`/`mul` (int) dispatch scalar arithmetic already uses
// — `vecMulSum` below is the case that exercises the float-vector fix:
// a `<4 x double>` operand must pick `fmul`, not integer `mul`.

func vecMulSum(a: double, b: double) -> double {
  let v1: vec<double, 4> = vec[a, a + 1.0, a + 2.0, a + 3.0]
  let v2: vec<double, 4> = vec[b, b, b, b]
  let p: vec<double, 4> = v1 * v2
  return p[0] + p[1] + p[2] + p[3]
}

func sumI64Vec(a: i64, b: i64, c: i64) -> i64 {
  let v: vec<i64, 3> = vec[a, b, c]
  return v[0] + v[1] + v[2]
}

// The same reduction as `vecMulSum`, but via a real `var` accumulator
// in a loop instead of a hand-unrolled `p[0] + p[1] + p[2] + p[3]` —
// reads each element with `extractelement` the same way either way,
// but scales to any N without rewriting the sum by hand (real memory,
// not a phi — see control-flow.poly/mutarray.poly for the same `var`
// mechanism applied to non-vector cases).
func vecMulSumViaVar(a: double, b: double) -> double {
  let v1: vec<double, 4> = vec[a, a + 1.0, a + 2.0, a + 3.0]
  let v2: vec<double, 4> = vec[b, b, b, b]
  let p: vec<double, 4> = v1 * v2
  var total: double = 0.0
  for (i = 0; i < 4; i = i + 1) {
    total = total + p[i]
  }
  return total
}
