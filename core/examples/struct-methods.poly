// Struct methods: `func` declared INSIDE a `struct` body, called via
// an explicit receiver (`p.dist()`); `this` resolves to the receiver,
// an ordinary bare-name reference (not a keyword), typed as the
// struct itself — so `this.field`/`this.otherMethod()` work via the
// SAME machinery any other struct-typed value already uses. Purely
// static, mangled-name dispatch (`Point_dist`, `Circle_dist`) — no
// vtables, no virtual dispatch; two different structs can each
// declare a same-named method with no collision.

struct Point(x: double, y: double) {
  func dist() -> double {
    return this.x * this.x + this.y * this.y
  }
}

struct Circle(r: double) {
  func dist() -> double {
    return this.r * this.r
  }
}

func distSum(px: double, py: double, r: double) -> double {
  let p: Point = Point(x: px, y: py)
  let c: Circle = Circle(r: r)
  return p.dist() + c.dist()
}

// A method calling ANOTHER method on `this`.
struct Pair(a: i64, b: i64) {
  func sum() -> i64 {
    return this.a + this.b
  }
  func doubledSum() -> i64 {
    return this.sum() * 2
  }
}

func doubledSumCheck(a: i64, b: i64) -> i64 {
  let p: Pair = Pair(a: a, b: b)
  return p.doubledSum()
}
