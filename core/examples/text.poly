// Strings for writing files: a text block with `${…}`, a StringBuilder filled by a helper, list literals, `for (x in
// list)` and the Text functions (`split`, `join`, `trim`, `fill`). Nothing is imported: the Text library is built in.
//
//   polyir text.poly --run --all       every target gives the same number

struct Dep(name: string, version: string)

func cmakeLists(name: string, sources: mutarray<string>, deps: mutarray<Dep>) -> string {
  let out = StringBuilder()
  for (d in deps) {
    out.line("pkg_check_modules(${d.name} REQUIRED IMPORTED_TARGET ${d.name}>=${d.version})")
  }
  return """
    cmake_minimum_required(VERSION 3.20)
    project(${name} LANGUAGES C)
    find_package(PkgConfig REQUIRED)
    ${out.text().trim()}
    add_executable(${name} ${sources.join(" ")})
    """
}

// A small checksum of the text, so the targets can be compared by their exit status.
func checksum(s: string) -> i64 {
  var sum: i64 = 0
  for (i = 0; i < len(s); i = i + 1) {
    sum = (sum * 31 + s[i].toI64()) % 1000003
  }
  return sum
}

func main() -> i64 {
  let deps: mutarray<Dep> = [Dep(name: "zlib", version: "1.2"), Dep(name: "sdl2", version: "2.0")]
  let text: string = cmakeLists("demo", ["main.c", "util.c"], deps)
  let values: mutmap<string, string> = mutmap<string, string>()
  values["who"] = "polyir"
  let hello: string = fill("hello \${who}", values)
  return (checksum(text) + len("a, b ,c".split(",")) * 7 + len(hello)) % 256
}
