// `variant<A,B,C,...>` — a tagged union over N cases, ONE universal
// `{tag: i64, payload: ptr}` runtime shape (`polyir_variant`) regardless
// of case count/types, same "one struct, type only matters for
// codegen bookkeeping" pattern `polyir_darray`/`polyir_closure` already
// use. `either<Ok,Err>` is sugar over the exact same shape, case 0 is
// always `Ok`, case 1 is always `Err`.
//
// Construction: `variant<A,B,...>(tag, value)` (tag a compile-time
// `INT_LIT`), or `eitherOk<Ok,Err>(value)`/`eitherErr<Ok,Err>(value)`.
// Consumption: `.tag()`, `.isCase(i)`, `.unwrapAt(i)` (general); for
// `either` specifically, `.isOk()`/`.isErr()`/`.unwrapOk()`/
// `.unwrapErr()`. A value stored into a case is CAST (not just bit-
// reinterpreted) to that case's own declared type at construction —
// an `i64` into a `double`-declared case genuinely becomes `x.0`.

func safeDivide(a: i64, b: i64) -> either<i64, i64> {
  if (b == 0) {
    return eitherErr<i64, i64>(99)
  }
  return eitherOk<i64, i64>(a / b)
}

func divideOrDefault(a: i64, b: i64) -> i64 {
  let r: either<i64, i64> = safeDivide(a, b)
  if (r.isErr()) {
    return r.unwrapErr()
  }
  return r.unwrapOk()
}

// `either<double, i64>`'s `Ok` case is declared `double`; storing the
// `i64` literal `3` into it converts (`sitofp`), not reinterprets.
func eitherCoercion() -> i64 {
  let r: either<double, i64> = eitherOk<double, i64>(3)
  return r.unwrapOk().toI64()
}

// A general 3-case variant, mixing `i64` and `double` cases.
func variantSum(which: i64) -> i64 {
  var v: variant<i64, double, i64> = variant<i64, double, i64>(0, 0)
  if (which == 0) { v = variant<i64, double, i64>(0, 10) }
  if (which == 1) { v = variant<i64, double, i64>(1, 2.5) }
  if (which == 2) { v = variant<i64, double, i64>(2, 30) }
  if (v.tag() == 0) { return v.unwrapAt(0) }
  if (v.tag() == 1) { return v.unwrapAt(1).toI64() * 100 }
  return v.unwrapAt(2) * 1000
}

// `.toI8()`/`.toI16()`/`.toI32()`/`.toI64()`/`.toFloat()`/`.toDouble()`
// — a general numeric cast on ANY value, not just a variant/either
// payload (int<->int widens/narrows, int<->float actually converts).
func castRoundTrip() -> i64 {
  let d: double = 9.0
  let asI64: i64 = d.toI64()
  let backToD: double = asI64.toDouble()
  return backToD.toI64() + asI64
}
