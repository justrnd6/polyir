// Every place a native program keeps a reference, each checked while garbage is made around it. Run under POLYIR_GC_STRESS=1 (a collection
// at every safe point), a reference the collector failed to see would be freed while still in use and the answer would be wrong.
// Each line printed is one check; the VM prints the same lines. (A global that holds a reference is a root too: the source language's globals
// hold numbers only, so tests/NativeGcTest.cpp checks one built with PolyIRBuilder.)

struct Pt {
    var x: i64
    y: i64
}

interface Shape {
    func area() -> i64
}

struct Square(side: i64) : Shape {
    func area() -> i64 {
        return this.side * this.side
    }
}

// Garbage: lists made and dropped, each round a safe point.
func churn(n: i64) -> i64 {
    var total: i64 = 0
    for (k = 0; k < n; k = k + 1) {
        let junk: array<i64> = array<i64>().with(k).with(k + 1)
        total = total + junk[1]
    }
    return total
}

func make(x: i64) -> Pt {
    churn(20)
    return Pt { x: x, y: x * 10 }
}

func sumOf(a: Pt, b: Pt) -> i64 {
    churn(20)
    return a.x + b.y
}

// A temporary held only while the rest of the expression runs: make(1) is in no variable while make(2) and sumOf churn. 1 + 20.
func temporaries() -> i64 {
    return sumOf(make(1), make(2))
}

// A struct whose fields are worked out by calls that churn. 3 + 4 * 10.
func fieldsByCalls() -> i64 {
    let p: Pt = Pt { x: make(3).x, y: make(4).y }
    return p.x + p.y
}

// Two closures sharing one captured variable (one cell), called with garbage in between. 3 increments: 3.
func sharedCell() -> i64 {
    var count: i64 = 0
    let inc: closure() -> i64 = closure() -> i64 {
        count = count + 1
        churn(10)
        return count
    }
    let read: closure() -> i64 = closure() -> i64 {
        return count
    }
    inc()
    churn(30)
    inc()
    inc()
    return read()
}

// A closure that outlives the function that made it keeps its captured variable alive. 5 * 7.
func multiplier(factor: i64) -> closure(i64) -> i64 {
    let words: array<string> = array<string>().with("kept")
    return closure(x: i64) -> i64 {
        churn(10)
        return x * factor + len(words[0]) - 4
    }
}

func escapedClosure() -> i64 {
    let times: closure(i64) -> i64 = multiplier(5)
    churn(50)
    return times(7)
}

// Interface values made, kept in a list, and called while the arguments churn. 4 + 9 + 16.
func interfaces() -> i64 {
    let shapes: mutarray<Shape> = mutarray<Shape>()
    for (i = 2; i < 5; i = i + 1) {
        push(shapes, Square(side: i))
        churn(5)
    }
    var total: i64 = 0
    for (i = 0; i < len(shapes); i = i + 1) {
        total = total + shapes[i].area()
    }
    return total
}

// A coroutine that keeps a list in its own frame across its yields and makes garbage in between. 40 + 42.
coro func keeper() -> i64 {
    let kept: array<i64> = array<i64>().with(40)
    churn(30)
    yield kept[0]
    churn(30)
    yield kept[0] + 2
}

func coroutines() -> i64 {
    let c: coro<i64> = keeper()
    let one: variant<i64> = c.resume()
    churn(30)
    let two: variant<i64> = c.resume()
    let alone: variant<i64> = keeper().resume()  // a coroutine nothing else refers to
    let first: i64 = one.unwrapAt(0)
    let second: i64 = two.unwrapAt(0)
    let once: i64 = alone.unwrapAt(0)
    return first + second + once
}

// A throw that leaves functions holding references: their records come off the chain on the way out, and what main holds survives. 7.
func thrower(depth: i64) -> i64 {
    let held: array<i64> = array<i64>().with(depth)
    churn(5)
    if (depth == 0) { throw 7 }
    return thrower(depth - 1) + held[0]
}

func throwing() -> i64 {
    let kept: array<i64> = array<i64>().with(100)
    var code: i64 = 0
    try {
        code = thrower(6)
    } catch (c) {
        code = c
    }
    churn(30)
    return code + kept[0] - 100
}

// Strings joined while garbage is made. "ab-0ab-1ab-2" has 12 bytes.
func strings() -> i64 {
    var text: string = ""
    for (i = 0; i < 3; i = i + 1) {
        text = text + "ab-" + str(i)
        churn(5)
    }
    return len(text)
}

func main() -> i64 {
    print(str(temporaries()))
    print(str(fieldsByCalls()))
    print(str(sharedCell()))
    print(str(escapedClosure()))
    print(str(interfaces()))
    print(str(coroutines()))
    print(str(throwing()))
    print(str(strings()))
    return 0
}
