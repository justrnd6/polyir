// `match`: as a value and as a statement, on numbers, strings, booleans, optionals, eithers, variants and lists, with
// alternatives, conditions and guards. Each check is 0 when it holds. Self-contained (no externs), so MatchMain.poly runs
// every check as one program.

// 0 when `got` is `want`, 1 when not.
func offText(got: string, want: string) -> double {
    if (got == want) {
        return 0.0
    }
    return 1.0
}

// ── numbers ──

func sizeOf(n: i64) -> string {
    return match (n) {
        0 => "none"
        1 | 2 | 3 => "a few"
        -1 => "minus one"
        else => "many"
    }
}

func checkNumbers() -> double {
    return offText(sizeOf(0) + sizeOf(2) + sizeOf(9) + sizeOf(-1), "nonea fewmanyminus one")
}

// Comparisons are conditions, written out: a `match` with no subject.
func signOf(n: i64) -> string {
    let sign = match {
        n < 0 => "negative"
        n == 0 => "zero"
        n >= 100 => "large"
        else => "positive"
    }
    return sign
}

func checkComparisons() -> double {
    return offText(signOf(-3) + " " + signOf(0) + " " + signOf(150) + " " + signOf(5), "negative zero large positive")
}

// A name and a guard where a comparison sits among exact keys.
func gradeOf(score: i64) -> string {
    return match (score) {
        100 => "perfect"
        s if s >= 90 => "A ${s}"
        s if s >= 80 => "B"
        else => "C"
    }
}

func checkGuardsOnTheSubject() -> double {
    return offText(gradeOf(100) + gradeOf(93) + gradeOf(85) + gradeOf(10), "perfectA 93BC")
}

// ── strings and booleans ──

func yes(reply: string) -> bool {
    return match (reply) {
        "y" | "yes" => true
        "n" | "no" => false
        else => false
    }
}

func checkStrings() -> double {
    return offText("${yes("y")} ${yes("yes")} ${yes("no")} ${yes("maybe")}", "true true false false")
}

// Conditions read the subject by its own name, among exact keys; `p if …` is the same test.
func kindOf(path: string) -> string {
    return match (path) {
        "Ninafile" | "Polyfile" => "build"
        path.endsWith(".poly") => "polyir"
        path.startsWith("README") => "docs"
        path.contains("test") && !path.endsWith(".md") => "a test"
        p if p.endsWith(".md") => "markdown ${p}"
        else => "other"
    }
}

func checkConditions() -> double {
    let kinds = [kindOf("Polyfile"), kindOf("a.poly"), kindOf("README.md"), kindOf("my_test.c"), kindOf("notes.md"), kindOf("x.c")]
    return offText(kinds.join(","), "build,polyir,docs,a test,markdown notes.md,other")
}

func word(ready: bool) -> string {
    return match (ready) {
        true => "go"
        false => "wait"
    }
}

func checkBooleans() -> double {
    return offText(word(true) + word(false), "gowait")
}

// ── sums ──

func shown(found: optional<i64>) -> string {
    return match (found) {
        Some(n) if n > 100 => "big ${n}"
        Some(n) => "found ${n}"
        None => "nothing"
    }
}

func checkOptionals() -> double {
    return offText(shown(Some<i64>(500)) + ", " + shown(Some<i64>(5)) + ", " + shown(None<i64>()), "big 500, found 5, nothing")
}

func safeDivide(a: i64, b: i64) -> either<i64, string> {
    if (b == 0) {
        return eitherErr<i64, string>("divide by zero")
    }
    return eitherOk<i64, string>(a / b)
}

// The subject is a call: it runs once.
func message(a: i64, b: i64) -> string {
    return match (safeDivide(a, b)) {
        Ok(q) => "quotient ${q}"
        Err(why) => "error ${why}"
    }
}

func checkEithers() -> double {
    return offText(message(7, 2) + "; " + message(7, 0), "quotient 3; error divide by zero")
}

func textOf(shape: variant<i64, i64, string>) -> string {
    return match (shape) {
        variant(0, r) => "circle ${r}"
        variant(1, s) => "square ${s}"
        variant(2, name) => name
    }
}

func checkVariants() -> double {
    let circle = textOf(variant<i64, i64, string>(0, 2))
    return offText(circle + ", " + textOf(variant<i64, i64, string>(1, 4)) + ", " + textOf(variant<i64, i64, string>(2, "blob")), "circle 2, square 4, blob")
}

// A sum's payload can be tested too: `Some(0)` is an `if` chain.
func zeroOr(found: optional<i64>) -> string {
    return match (found) {
        Some(0) => "zero"
        Some(_) => "other"
        None => "none"
    }
}

func checkPayloadPatterns() -> double {
    return offText(zeroOr(Some<i64>(0)) + zeroOr(Some<i64>(3)) + zeroOr(None<i64>()), "zeroothernone")
}

// ── lists ──

func said(xs: array<i64>) -> string {
    return match (xs) {
        [] => "empty"
        [x] => "just ${x}"
        [0, ...] => "starts at zero"
        [first, ...rest] => "${first}, then ${len(rest)} more"
    }
}

func checkLists() -> double {
    let none: array<i64> = array<i64>()
    return offText(said(none) + "; " + said([7]) + "; " + said([0, 1, 2]) + "; " + said([3, 4, 5]), "empty; just 7; starts at zero; 3, then 2 more")
}

// A guard on a list's element, and a pair.
func pairOf(xs: mutarray<i64>) -> string {
    return match (xs) {
        [a, b] if a == b => "a pair of ${a}"
        [a, b] => "${a} and ${b}"
        [first, ...] if first < 0 => "starts below zero"
        else => "something else"
    }
}

func checkListGuards() -> double {
    let same: mutarray<i64> = [4, 4]
    let two: mutarray<i64> = [1, 2]
    let low: mutarray<i64> = [-1, 2, 3]
    return offText(pairOf(same) + "; " + pairOf(two) + "; " + pairOf(low) + "; " + pairOf([5]), "a pair of 4; 1 and 2; starts below zero; something else")
}

// ── statements ──

// Arms are blocks or single statements; with no `else`, nothing happens when no arm matches.
func command(c: string) -> string {
    var said: string = ""
    match (c) {
        "quit" | "exit" => { return "bye" }
        c.startsWith("say ") => { said = c.slice(4, len(c)) }
        "noop" => {}
    }
    return said
}

func checkStatements() -> double {
    return offText(command("say hi") + "|" + command("quit") + "|" + command("noop") + "|" + command("huh"), "hi|bye||")
}

// A value `match` as an argument, nested in another's arm.
func checkNested() -> double {
    let a: i64 = 2
    let b: i64 = 5
    let text = "${match (a) { 1 => "one" 2 => match (b) { 5 => "two-five" else => "two" } else => "many" }}"
    return offText(text, "two-five")
}
