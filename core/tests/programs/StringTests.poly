// Strings: escapes, text blocks, `${…}`, list literals, `for (x in list)`, the four string built-ins and the Text
// library (split, trim, join, StringBuilder, fill, ...), which is built in: nothing here imports it. Self-contained (no
// externs), so StringMain.poly runs every check on every target: `polyir StringMain.poly --run --all`.

// 0 when `got` is `want`, 1 when not.
func offText(got: string, want: string) -> double {
    if (got == want) {
        return 0.0
    }
    return 1.0
}

// How far `got` is from `want`.
func offInt(got: i64, want: i64) -> double {
    return (got - want).toDouble()
}

func checkEscapes() -> double {
    let s: string = "a\tb\n\"c\" \\ \$"
    return offInt(len(s), 11)
}

func checkCharEscapes() -> double {
    return offInt('\n'.toI64() + '\''.toI64() + '\\'.toI64(), 10 + 39 + 92)
}

func checkInterpolation() -> double {
    let name: string = "zlib"
    let n: i64 = 42
    return offText("lib ${name} v${n + 1} ok=${n > 1}", "lib zlib v43 ok=true")
}

func checkInterpolatedMethodCalls() -> double {
    let words: mutarray<string> = ["a", "b", "c"]
    return offText("[${words.join(", ")}]", "[a, b, c]")
}

func checkTextBlock() -> double {
    let name: string = "demo"
    let text: string = """
        project(${name})
          add("x")

        done
        """
    return offText(text, "project(demo)\n  add(\"x\")\n\ndone\n")
}

func checkTextBlockWithoutFinalNewline() -> double {
    let text: string = """
        one
        two"""
    return offText(text, "one\ntwo")
}

func checkTextBlockKeepsIndentOfMultiLineValue() -> double {
    let inner: string = "a\nb"
    let text: string = """
        list:
          ${inner}
        end
        """
    return offText(text, "list:\n  a\n  b\nend\n")
}

func checkStrOfValues() -> double {
    let c: char = 'x'
    return offText(str(0 - 7) + str(true) + str(false) + str(c) + str("s") + (12).str(), "-7truefalsexs12")
}

func checkCharAt() -> double {
    let s: string = "hello"
    return offInt(s[1].toI64(), 101)
}

func checkSliceAndFind() -> double {
    let s: string = "key=value"
    let at: i64 = s.find("=")
    return offText(s.slice(0, at) + "|" + s.slice(at + 1, len(s)), "key|value") + offInt(s.find("z"), 0 - 1)
}

func checkSliceClamps() -> double {
    let s: string = "abc"
    return offText(s.slice(0 - 5, 99) + s.slice(2, 1), "abc")
}

func checkFindFrom() -> double {
    let s: string = "a.b.c"
    return offInt(s.find(".", 2), 3)
}

func checkListLiteralAndForIn() -> double {
    var total: i64 = 0
    for (w in ["cmake", "-S", "src"]) {
        total = total + len(w)
    }
    return offInt(total, 10)
}

func checkSplitAndJoin() -> double {
    let parts: mutarray<string> = "a,b,,c".split(",")
    return offInt(len(parts), 4) + offText(parts.join("+"), "a+b++c")
}

func checkTrimAndContains() -> double {
    let s: string = "  \tpadded \n"
    return offText(s.trim(), "padded") + offInt(s.contains("dd").toI64(), 1) + offInt(s.contains("x").toI64(), 0)
}

func checkStartsAndEnds() -> double {
    let s: string = "CMakeLists.txt"
    let both: bool = s.startsWith("CMake") && s.endsWith(".txt") && !s.endsWith("CMake")
    return offInt(both.toI64(), 1)
}

func checkReplaceRepeatIndent() -> double {
    let s: string = "a-b-c".replace("-", "::")
    return offText(s + "|" + "ab".repeat(3) + "|" + "x\n\ny".indent(2), "a::b::c|ababab|  x\n\n  y")
}

func checkLines() -> double {
    return offInt(len("one\ntwo\nthree".lines()), 3)
}

func checkFill() -> double {
    let values: mutmap<string, string> = mutmap<string, string>()
    values["name"] = "gcd"
    values["lang"] = "C"
    return offText(fill("project(\${name} LANGUAGES \${lang}) \${missing}", values), "project(gcd LANGUAGES C) \${missing}")
}

func writeDeps(out: StringBuilder, deps: mutarray<string>) -> void {
    out.indent(4)
    for (d in deps) {
        out.line("implementation(\"${d}\")")
    }
    out.dedent()
}

func checkStringBuilder() -> double {
    let out = StringBuilder()
    out.line("dependencies {")
    writeDeps(out, ["a:b:1", "c:d:2"])
    out.line("}")
    let want: string = """
        dependencies {
            implementation("a:b:1")
            implementation("c:d:2")
        }
        """
    return offText(out.text(), want) + offInt(out.isEmpty().toI64(), 0)
}
