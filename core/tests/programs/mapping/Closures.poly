// Coroutines that yield structs, linked optionals, nested closures over one variable, closures held by structs, globals of several types,
// a `return` out of nested loops, `try` in a loop, labels that carry strings (one of them a state machine) and operator precedence.
// rust-check.sh checks the result against Java (54).

struct Node(var value: i64, var next: optional<Node>);

struct Holder(op: closure(i64) -> i64, name: string) {
  func run(x: i64) -> i64 {
    let f: closure(i64) -> i64 = this.op
    return f(x)
  }
  func viaLater() -> closure(i64) -> i64 {
    return closure(y: i64) -> i64 {
      let f: closure(i64) -> i64 = this.op
      return f(y) + len(this.name)
    }
  }
}

global flag: i1 = false
global ratio: double = 1.5
global hits: i64 = 0

coro func pairs(n: i64) -> Node {
  for (i = 0; i < n; i = i + 1) {
    yield Node(value: i, next: None<Node>())
  }
}

func sumNodes(n: i64) -> i64 {
  let g: coro<Node> = pairs(n)
  var s: i64 = 0
  var done: i1 = false
  for (k = 0; k < 20 && done == false; k = k + 1) {
    let r: variant<Node> = g.resume()
    if (r.isCase(1)) {
      done = true
    } else {
      s = s + r.unwrapAt(0).value
    }
  }
  return s
}

func chain() -> i64 {
  let a: Node = Node(value: 1, next: None<Node>())
  let b: Node = Node(value: 2, next: Some<Node>(a))
  let c: Node = Node(value: 3, next: Some<Node>(b))
  var sum: i64 = 0
  var cur: optional<Node> = Some<Node>(c)
  for (i = 0; i < 5 && cur.isSome(); i = i + 1) {
    let n: Node = cur.unwrap()
    sum = sum + n.value
    cur = n.next
  }
  a.value = 10
  return sum * 100 + b.next.unwrap().value
}

func nestedClosures(a: i64) -> i64 {
  var total: i64 = 0
  let outer: closure(i64) -> i64 = closure(x: i64) -> i64 {
    let inner: closure(i64) -> i64 = closure(y: i64) -> i64 {
      total = total + y
      return x * y + a
    }
    return inner(x + 1) + inner(2)
  }
  let r: i64 = outer(3)
  return r * 1000 + total
}

func strClosure(prefix: string) -> i64 {
  let tail: string = "!"
  let f: closure(string) -> string = closure(s: string) -> string { return prefix + s + tail }
  return len(f("abc"))
}

func holders() -> i64 {
  let h: Holder = Holder(op: closure(x: i64) -> i64 { return x * x }, name: "hh")
  let later: closure(i64) -> i64 = h.viaLater()
  return h.run(5) + later(2)
}

func globals() -> i64 {
  hits = hits + 5
  flag = true
  ratio = ratio * 2.0
  var r: i64 = hits
  if (flag) { r = r + 100 }
  if (ratio > 2.5) { r = r + 1000 }
  return r
}

func findFirst(limit: i64) -> i64 {
  for (i = 0; i < limit; i = i + 1) {
    for (j = 0; j < limit; j = j + 1) {
      if (i * j == 12) { return i * 100 + j }
    }
  }
  return 0 - 1
}

func tryInLoop(n: i64) -> i64 {
  var s: i64 = 0
  for (i = 0; i < n; i = i + 1) {
    try {
      if (i % 2 == 1) { throw i }
      s = s + 10
    } catch (code) {
      s = s + code
    }
  }
  return s
}

func lines(a: string, b: string) -> string {
  goto start(a, 0)
label start(acc: string, n: i64):
  branch n < 3 ? more(acc, n) : done(acc)
label more(acc: string, n: i64):
  goto start(acc + b, n + 1)
label done(acc: string):
  return acc
}

func lineLen() -> i64 { return len(lines("x", "yz")) }

func machineStrings(n: i64) -> i64 {
  branch n == 0 ? ping(n, "p") : pong(n, "q")
label ping(p: i64, s: string):
  branch p > 4 ? done(s, p) : pong(p + 1, s + "a")
label pong(q: i64, s: string):
  branch q > 4 ? done(s, q) : ping(q + 1, s + "b")
label done(s: string, r: i64):
  return r * 100 + len(s)
}

func precedence(a: i64, b: i64) -> i64 {
  let x: i64 = (a + b) * (a - b) / 3
  let y: i64 = a & b | a ^ b
  let z: i64 = a << 2 + b >> 1
  var s: i64 = x + y + z
  if (a & 1 == 1 && b > 2 || a == 0) { s = s + 1 }
  let w: i32 = a.toI32()
  if (w.toI64() < 100 && (a + b).toI32() < 1000) { s = s + 2 }
  return s
}

func main() -> i64 {
  var score: i64 = sumNodes(5) + chain() + nestedClosures(2) + strClosure("ab")
  score = score + holders() + globals() + findFirst(10) + tryInLoop(6)
  score = score + lineLen() + machineStrings(0) + machineStrings(1) + precedence(13, 7)
  return score % 251
}
