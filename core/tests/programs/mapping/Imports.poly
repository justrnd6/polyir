// `import java "…"` writes the declarations of a JDK class (from `javap`) into .polyir.d/java/ and imports them. Those files are checked
// in beside this program, so building needs no JDK; delete one to generate it again. Imports.java is the result.
import java "java.util.Arrays"
import java "java.lang.StringBuilder"

func main() -> i64 {
  let numbers: LongArray = LongArray.new(3)
  numbers.setAt(0, 30)
  numbers.setAt(1, 10)
  numbers.setAt(2, 20)
  Arrays.sortLongArray(numbers)

  let text: StringBuilder = StringBuilder.new()
  text.appendString("ab")
  text.appendLong(7)
  return numbers.get(0) + numbers.get(2) + text.length().toI64()
}
