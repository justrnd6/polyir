// LIVE SOUND: a stream whose sound is made WHILE it plays. Instead of building the whole sound first
// (as compose.poly does) the program hands the speakers a FILL FUNCTION; the system calls it a few
// dozen times a second, whenever the hardware is about to run out of samples, and the function makes
// the next few thousand frames on the spot. This is how a game, a synthesizer or any instrument
// that responds to you works.
//
// Here the fill function makes a STEREO sound: a tone in the left channel that glides up from 220 Hz
// to 440 Hz in one second (an octave), and in the right channel the same tone a perfect fifth
// higher (1.5 times the frequency). The function keeps its place between calls in a small block of
// memory it is given (the "state"): the position within each wave, so the waves continue smoothly
// from one buffer to the next with no click at the join.
//
// The program also CHECKS that the machinery works: it records every sample that was made and then
// verifies the number of frames, that the waves are smooth across buffer boundaries, that they have the
// right pitch (by counting zero crossings), and that the stream took about as long as the sound lasts
// (the speakers really consumed it in real time).
//
//   polyir live.poly --out live && ./live                (silent: the speakers run at volume 0)
//   POLYIR_PLAY=1 ./live                                   (you hear it)
//
// Exit 0 means every check held. 10 no audio device, 11 the stream failed to start, 12 wrong number
// of frames, 13 not smooth, 14 wrong pitch, 15 wrong duration. Builds natively only (macOS, Linux and
// Windows back ends: see ideas/audio-output/Audio.poly; only macOS has been run).
import "../../audio/Wave.poly"
import "../Audio.poly"
import "../../gpu/examples/shared/print.poly"

extern func calloc(count: i64, size: i64) -> i64
extern func floor(x: double) -> double
extern func getenv(name: string) -> i64

func glideRate() -> double {
    return 44100.0
}

// The fill function: makes `frames` frames of stereo sound starting at frame `first`. `state` is a block of memory
// the program gave the stream, read two ways: as doubles [0] left phase and [1] right phase (in whole cycles),
// and as whole numbers [2] frames made so far, [3] times called, [4] the address of the recording (left, right, ...).
func glide(state: i64, buf: ptr<float>, frames: i64, first: i64) -> i64 {
    let phases: ptr<double> = state.toPtr()
    let counters: ptr<i64> = state.toPtr()
    let recording: ptr<float> = counters[4].toPtr()
    for (i = 0; i < frames; i = i + 1) {
        let t: double = (first + i).toDouble() / glideRate()
        let left: double = 220.0 + 220.0 * t
        phases[0] = phases[0] + left / glideRate()
        phases[1] = phases[1] + 1.5 * left / glideRate()
        phases[0] = phases[0] - floor(phases[0])
        phases[1] = phases[1] - floor(phases[1])
        buf[i * 2] = 0.5 * sine(phases[0].toFloat())
        buf[i * 2 + 1] = 0.5 * sine(phases[1].toFloat())
        recording[(first + i) * 2] = buf[i * 2]
        recording[(first + i) * 2 + 1] = buf[i * 2 + 1]
    }
    counters[2] = counters[2] + frames
    counters[3] = counters[3] + 1
    return frames
}

// How many times the wave in `channel` of the recording crosses zero going upward (once per cycle).
func risingCrossings(recording: ptr<float>, frames: i64, channel: i64) -> i64 {
    var count: i64 = 0
    for (i = 1; i < frames; i = i + 1) {
        if (recording[(i - 1) * 2 + channel] < 0.0 && recording[i * 2 + channel] >= 0.0) { count = count + 1 }
    }
    return count
}

// The biggest step from one sample to the next in `channel`. A smooth wave of height 0.5 at frequency f changes by at
// most 2 * pi * 0.5 * f / rate; a wave restarted at a buffer boundary would jump by much more.
func biggestStep(recording: ptr<float>, frames: i64, channel: i64) -> float {
    var biggest: float = 0.0
    for (i = 1; i < frames; i = i + 1) {
        var step: float = recording[i * 2 + channel] - recording[(i - 1) * 2 + channel]
        if (step < 0.0) { step = 0.0 - step }
        if (step > biggest) { biggest = step }
    }
    return biggest
}

func main() -> i64 {
    let state: i64 = calloc(8, 8)
    let counters: ptr<i64> = state.toPtr()
    let recording: ptr<float> = calloc(44100 * 2 + 4, 4).toPtr()
    counters[4] = recording.toI64()
    var volume: float = 0.0
    if (getenv("POLYIR_PLAY") != 0) { volume = 1.0 }
    let started: i64 = wallMs()
    let fill: ptr<func(i64, ptr<float>, i64, i64) -> i64> = glide
    let status: i64 = audioStreamAt(fill, state, 2, 44100, 1.0, volume)
    let elapsed: i64 = wallMs() - started
    if (status != 0) { return reportFailure(status) }
    return verify(counters, recording, elapsed)
}

// The sound system could not start: most often there is no audio device (a server, a container).
func reportFailure(status: i64) -> i64 {
    say("no audio output available (system code ")
    sayNumber(status)
    say(")")
    newline()
    return 10
}

func verify(counters: ptr<i64>, recording: ptr<float>, elapsed: i64) -> i64 {
    let frames: i64 = counters[2]
    say("fill function called ")
    sayNumber(counters[3])
    say(" times for ")
    sayNumber(frames)
    say(" frames in ")
    sayNumber(elapsed)
    say(" ms")
    newline()
    if (frames != 44100) { return 12 }
    // The glide's slope is 220 Hz per second; the right channel is 1.5 times as high, so it moves fastest: 660 Hz at the end.
    if (biggestStep(recording, frames, 0) > 0.04 || biggestStep(recording, frames, 1) > 0.06) { return 13 }
    return verifyPitch(recording, frames, elapsed)
}

// Left glides 220 to 440 Hz: its average is 330 Hz, so about 330 cycles in the second; right is 1.5 times that, about 495.
func verifyPitch(recording: ptr<float>, frames: i64, elapsed: i64) -> i64 {
    let left: i64 = risingCrossings(recording, frames, 0)
    let right: i64 = risingCrossings(recording, frames, 1)
    say("cycles counted: left ")
    sayNumber(left)
    say(", right ")
    sayNumber(right)
    newline()
    if (left < 328 || left > 332 || right < 492 || right > 498) { return 14 }
    // The speakers consume the sound in real time: one second of sound takes about one second.
    if (elapsed < 800 || elapsed > 3000) { return 15 }
    return 0
}
