// STUDIO: a tour of the Sound library's mixing tools: STEREO (placing sounds left and right), WAV files
// (writing a mix and reading it back), RESAMPLING (changing the sample rate), and EQUALIZER filters
// (lifting or cutting parts of the spectrum, removing a hum, imitating a telephone). Every claim is
// checked by measuring the sound, and the filters' response curves are drawn as pictures:
//
//   polyir studio.poly --out studio && ./studio                 (run in this folder)
//   POLYIR_PLAY=1 ./studio                                       (also plays the stereo mix)
//
// Writes studio-mix.wav (stereo, 44,100 Hz) and studio-eq.pgm, studio-hum.pgm, studio-phone.pgm
// (response curves: frequency from 20 Hz to 20 kHz left to right on a logarithmic scale, gain in
// decibels up and down). Exit 0 means every check held; 11 the mix could not be saved or read back,
// 12 the panning is wrong, 13 resampling is wrong, 14 the equalizer does not match its prediction,
// 15 the hum was not removed, 16 the telephone filter is wrong, 17 playback failed.
import "../../audio/Sound.poly"
import "../Audio.poly"
import "../../gpu/examples/shared/print.poly"
import "../../gpu/examples/shared/picture.poly"
import "../../gpu/examples/shared/plot.poly"

extern func getenv(name: string) -> i64
extern func calloc(count: i64, size: i64) -> i64
extern func log10(x: double) -> double
extern func pow(x: double, y: double) -> double

// ── 1. a stereo mix ──────────────────────────────────────────────────────────────────────
// Four seconds: a 440 Hz melody note panned left, a 100 Hz sawtooth bass in the middle, and a 660 Hz
// chord note panned right. A mono sound becomes stereo with `pan` (-1 all left ... +1 all right); the
// stereo sounds are then mixed into a bed with `add`.
func stereoMix() -> Sound {
    let mix: Sound = soundNewChannels(4.0, 44100, 2)
    let melody: Sound = soundNew(4.0, 44100)
    melody.tone(0, 440.0, 0.4, 0.0, 4.0)
    let bass: Sound = soundNew(4.0, 44100)
    bass.tone(2, 100.0, 0.1, 0.0, 4.0)
    let chord: Sound = soundNew(4.0, 44100)
    chord.tone(0, 660.0, 0.3, 0.0, 4.0)
    mix.add(melody.pan(0.0 - 0.6), 0.0, 1.0)
    mix.add(bass.pan(0.0), 0.0, 1.0)
    mix.add(chord.pan(0.6), 0.0, 1.0)
    return mix
}

// Save the mix, read it back, and compare every sample (a 16-bit file keeps about 4 decimal places).
func checkFile(mix: Sound) -> i64 {
    if (mix.saveWav("studio-mix.wav") == 0) { return 11 }
    let back: Sound = soundLoadWav("studio-mix.wav")
    if (back.count != mix.count || back.channels != 2 || back.rate != 44100) { return 11 }
    var worst: float = 0.0
    for (k = 0; k < mix.count * 2; k = k + 1) {
        var gap: float = back.samples[k] - mix.samples[k]
        if (gap < 0.0) { gap = 0.0 - gap }
        if (gap > worst) { worst = gap }
    }
    say("studio-mix.wav: saved and read back, largest difference ")
    sayDecimal(worst * 1000.0)
    say(" thousandths")
    newline()
    if (worst > 0.001) { return 11 }
    return 0
}

// Where a pure tone sits in the stereo picture: its strength in each channel. A tone panned by p is
// left cos((p + 1) pi / 4) and right sin((p + 1) pi / 4) times its height. (The bass is 100 Hz, so none of its
// harmonics land on 440 or 660 Hz and disturb the measurement.)
func checkPan(mix: Sound) -> i64 {
    let left: float = mix.channel(0).strength(440.0, 1.0, 2.0)
    let right: float = mix.channel(1).strength(440.0, 1.0, 2.0)
    say("the 440 Hz melody: left ")
    sayDecimal(left)
    say(", right ")
    sayDecimal(right)
    newline()
    // Panned -0.6: left = 0.4 * cos(0.1 pi) = 0.380, right = 0.4 * sin(0.1 pi) = 0.124.
    if (left < 0.37 || left > 0.39 || right < 0.115 || right > 0.133) { return 12 }
    let chordRight: float = mix.channel(1).strength(660.0, 1.0, 2.0)
    // Panned +0.6: right = 0.3 * sin(0.4 pi) = 0.285.
    if (chordRight < 0.27 || chordRight > 0.30) { return 12 }
    return 0
}

// ── 2. resampling ────────────────────────────────────────────────────────────────────────
// The same four seconds at 48,000 Hz and at 22,050 Hz: same length in seconds, same pitch, same loudness.
func checkResample(mix: Sound) -> i64 {
    let up: Sound = mix.resample(48000)
    let down: Sound = mix.resample(22050)
    let before: float = mix.channel(0).strength(440.0, 1.0, 2.0)
    let atUp: float = up.channel(0).strength(440.0, 1.0, 2.0)
    let atDown: float = down.channel(0).strength(440.0, 1.0, 2.0)
    say("resampled to 48,000 Hz: ")
    sayNumber(up.count)
    say(" frames, the 440 Hz melody still ")
    sayDecimal(atUp)
    say(" (was ")
    sayDecimal(before)
    say("); to 22,050 Hz: ")
    sayNumber(down.count)
    say(" frames, melody ")
    sayDecimal(atDown)
    newline()
    if (up.count != 192000 || down.count != 88200 || up.channels != 2) { return 13 }
    if (atUp < before - 0.005 || atUp > before + 0.005 || atDown < before - 0.005 || atDown > before + 0.005) { return 13 }
    return 0
}

// The danger in going to a LOWER rate: a 3,000 Hz tone sampled 8,000 times a second, kept at only 4,000 samples a second
// (every second sample), is above half the new rate (2,000 Hz), so it comes back as a false 1,000 Hz tone at full
// strength (aliasing). `resample` filters first, so the tone is simply gone.
func checkAliasing() -> i64 {
    let tone: Sound = soundNew(1.0, 8000)
    for (i = 0; i < tone.count; i = i + 1) {
        tone.samples[i] = sine(3000.0 * i.toFloat() / 8000.0)
    }
    let naive: Sound = soundNew(1.0, 4000)
    for (i = 0; i < naive.count; i = i + 1) { naive.samples[i] = tone.samples[i * 2] }
    let careful: Sound = tone.resample(4000)
    let alias: float = naive.strength(1000.0, 0.25, 0.5)
    let kept: float = careful.strength(1000.0, 0.25, 0.5)
    say("3,000 Hz tone at 8,000 Hz down to 4,000 Hz: dropping every second sample gives a false 1,000 Hz tone of ")
    sayDecimal(alias)
    say("; resample gives ")
    sayDecimal(kept)
    newline()
    if (alias < 0.99 || kept > 0.01) { return 13 }
    return 0
}

// ── 3. an equalizer ──────────────────────────────────────────────────────────────────────
// Three filters in a row: +6 dB of bass below 200 Hz, -6 dB around 1,000 Hz, +3 dB of treble above 6,000 Hz.
func applyEqualizer(s: Sound) -> i64 {
    s.lowShelf(200.0, 6.0)
    s.bell(1000.0, 1.0, 0.0 - 6.0)
    s.highShelf(6000.0, 3.0)
    return 0
}

// What the three filters together do to a tone of `hz`: their gains multiply.
func equalizerGain(hz: float) -> float {
    let low: Biquad = biquadLowShelf(44100, 200.0, 6.0)
    let middle: Biquad = biquadBell(44100, 1000.0, 1.0, 0.0 - 6.0)
    let high: Biquad = biquadHighShelf(44100, 6000.0, 3.0)
    return low.gain(hz, 44100) * middle.gain(hz, 44100) * high.gain(hz, 44100)
}

// A test tone of `hz` (height 1) through the equalizer: its measured height, from the last half second.
func measuredEqualizer(hz: float) -> float {
    let tone: Sound = soundNew(1.0, 44100)
    for (i = 0; i < tone.count; i = i + 1) {
        tone.samples[i] = sine(hz * i.toFloat() / 44100.0)
    }
    applyEqualizer(tone)
    return tone.strength(hz, 0.5, 0.5)
}

func checkEqualizer() -> i64 {
    let tones: ptr<float> = calloc(8, 4).toPtr()
    tones[0] = 50.0
    tones[1] = 100.0
    tones[2] = 200.0
    tones[3] = 500.0
    tones[4] = 1000.0
    tones[5] = 2000.0
    tones[6] = 6000.0
    tones[7] = 12000.0
    say("equalizer, tone by tone: predicted gain / measured gain")
    newline()
    var worst: float = 0.0
    for (k = 0; k < 8; k = k + 1) {
        let predicted: float = equalizerGain(tones[k])
        let measured: float = measuredEqualizer(tones[k])
        sayRight(tones[k].toI64(), 7)
        say(" Hz   ")
        sayDecimal(predicted)
        say("   ")
        sayDecimal(measured)
        newline()
        var gap: float = (measured - predicted) / predicted
        if (gap < 0.0) { gap = 0.0 - gap }
        if (gap > worst) { worst = gap }
    }
    if (worst > 0.01) { return 14 }
    return drawEqualizer()
}

// ── response curves, drawn ───────────────────────────────────────────────────────────────
// The curve of a gain function from 20 Hz to 20 kHz, 320 points spaced evenly in log(frequency), in decibels.
func frequencyAt(column: i64) -> float {
    return pow(10.0, 1.30103 + 3.0 * column.toDouble() / 319.0).toFloat()
}

// Faint vertical lines at 100 Hz, 1,000 Hz and 10,000 Hz (a tenth of the way along the picture is not 100 Hz: the axis
// is logarithmic, so each decade, a tenfold step in frequency, takes the same width).
func markDecades(pic: ptr<float>, w: i64, h: i64) -> i64 {
    for (d = 0; d < 3; d = d + 1) {
        let column: i64 = ((0.69897 + d.toFloat()) / 3.0 * (w - 1).toFloat()).toI64()
        for (y = 0; y < h; y = y + 1) {
            if (pic[y * w + column] > 0.9) { pic[y * w + column] = 0.8 }
        }
    }
    return 0
}

func decibels(gain: float) -> float {
    return (20.0 * log10(gain.toDouble() + 0.0000001)).toFloat()
}

func drawEqualizer() -> i64 {
    let curve: ptr<float> = calloc(320, 4).toPtr()
    for (x = 0; x < 320; x = x + 1) { curve[x] = decibels(equalizerGain(frequencyAt(x))) }
    let pic: ptr<float> = calloc(320 * 96, 4).toPtr()
    drawCurve(pic, 320, 96, curve, 320, 0.0 - 12.0, 12.0)
    markDecades(pic, 320, 96)
    savePicture("studio-eq.pgm", pic, 320, 96)
    return 0
}

// ── 4. removing a hum ────────────────────────────────────────────────────────────────────
// A 440 Hz tone with a 50 Hz mains hum added; a NOTCH filter at 50 Hz takes the hum out and leaves the tone.
func checkHum() -> i64 {
    let s: Sound = soundNew(2.0, 44100)
    s.tone(0, 440.0, 0.5, 0.0, 2.0)
    for (i = 0; i < s.count; i = i + 1) {
        s.samples[i] = s.samples[i] + 0.3 * sine(50.0 * i.toFloat() / 44100.0)
    }
    let humBefore: float = s.strength(50.0, 1.0, 1.0)
    s.notch(50.0, 10.0)
    let humAfter: float = s.strength(50.0, 1.0, 1.0)
    let toneAfter: float = s.strength(440.0, 1.0, 1.0)
    say("hum at 50 Hz: ")
    sayDecimal(humBefore)
    say(" before the notch, ")
    sayDecimal(humAfter)
    say(" after; the 440 Hz tone is ")
    sayDecimal(toneAfter)
    newline()
    if (humAfter > 0.01 || toneAfter < 0.47 || toneAfter > 0.51) { return 15 }
    return drawHum()
}

func drawHum() -> i64 {
    let notch: Biquad = biquadNotch(44100, 50.0, 10.0)
    let curve: ptr<float> = calloc(320, 4).toPtr()
    for (x = 0; x < 320; x = x + 1) { curve[x] = decibels(notch.gain(frequencyAt(x), 44100)) }
    let pic: ptr<float> = calloc(320 * 96, 4).toPtr()
    drawCurve(pic, 320, 96, curve, 320, 0.0 - 40.0, 3.0)
    markDecades(pic, 320, 96)
    savePicture("studio-hum.pgm", pic, 320, 96)
    return 0
}

// ── 5. a telephone ───────────────────────────────────────────────────────────────────────
// A telephone passes only about 300 to 3,400 Hz: a steep high-pass at 300 and a steep low-pass at 3,400.
func telephoneGain(hz: float) -> float {
    let high: Biquad = biquadHighPass(44100, 300.0, 0.7071)
    let low: Biquad = biquadLowPass(44100, 3400.0, 0.7071)
    return high.gain(hz, 44100) * low.gain(hz, 44100)
}

func checkTelephone() -> i64 {
    say("telephone gain at 100 Hz, 1,000 Hz and 8,000 Hz: ")
    sayDecimal(telephoneGain(100.0))
    say(", ")
    sayDecimal(telephoneGain(1000.0))
    say(", ")
    sayDecimal(telephoneGain(8000.0))
    newline()
    if (telephoneGain(100.0) > 0.15 || telephoneGain(1000.0) < 0.95 || telephoneGain(8000.0) > 0.25) { return 16 }
    let curve: ptr<float> = calloc(320, 4).toPtr()
    for (x = 0; x < 320; x = x + 1) { curve[x] = decibels(telephoneGain(frequencyAt(x))) }
    let pic: ptr<float> = calloc(320 * 96, 4).toPtr()
    drawCurve(pic, 320, 96, curve, 320, 0.0 - 40.0, 3.0)
    markDecades(pic, 320, 96)
    savePicture("studio-phone.pgm", pic, 320, 96)
    return 0
}

func main() -> i64 {
    let mix: Sound = stereoMix()
    var code: i64 = checkFile(mix)
    if (code == 0) { code = checkPan(mix) }
    if (code == 0) { code = checkResample(mix) }
    if (code == 0) { code = checkAliasing() }
    if (code == 0) { code = checkEqualizer() }
    if (code == 0) { code = checkHum() }
    if (code == 0) { code = checkTelephone() }
    if (code == 0 && getenv("POLYIR_PLAY") != 0) {
        if (soundPlay(mix) != 0) { code = 17 }
    }
    return code
}
