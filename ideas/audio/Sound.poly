// SOUND: an audio buffer you can build, mix, filter, resample, load and save in a few lines. The
// second slice of waveforms as part of polyir (after Wave.poly, which it uses).
//
//   import "../Sound.poly"        (the path is relative to the importing file)
//
//   let song: Sound = soundNew(3.0, 44100)               // 3 seconds of silence at 44,100 Hz
//   song.tone(0, 440.0, 0.4, 0.0, 1.0)                    // a 440 Hz sine, 0.4 loud, from 0 s for 1 s
//   song.tone(2, 330.0, 0.2, 0.5, 2.0)                    // a sawtooth joins at 0.5 s
//   song.bell(1000.0, 2.0, 6.0)                           // lift the area around 1,000 Hz by 6 decibels
//   song.normalize(0.9)                                   // scale so the loudest sample is 0.9
//   song.saveWav("song.wav")                              // a WAV file any player opens
//   let heard: Sound = soundLoadWav("song.wav")           // ... and read one back
//
// A Sound is a handful of numbers (where the samples live, how many frames, how fast they play,
// how many channels) plus operations that change the samples in place. Samples are floats from -1
// to +1; saving to a file converts them to 16-bit whole numbers. Playing a Sound through the
// speakers is `soundPlay` in ideas/audio-output/Audio.poly (a separate import, because it only works in a
// native build).
//
// FRAMES AND CHANNELS. A FRAME is one moment of sound: one sample for each channel. `count` is the
// number of frames, so `count / rate` is the length in seconds whether the sound is mono (1 channel)
// or stereo (2: left and right) or has more. The samples are INTERLEAVED, the way sound hardware and
// WAV files want them: left sample of frame 0, right sample of frame 0, left of frame 1, and so on;
// frame f, channel c lives at `samples[f * channels + c]`. Most operations treat every channel alike.
import "Wave.poly"
import "Biquad.poly"
import "Resample.poly"

extern func calloc(count: i64, size: i64) -> i64
extern func fopen(path: string, mode: string) -> i64
extern func fwrite(data: i64, size: i64, count: i64, file: i64) -> i64
extern func fread(data: i64, size: i64, count: i64, file: i64) -> i64
extern func fseek(file: i64, offset: i64, whence: i64) -> i64
extern func ftell(file: i64) -> i64
extern func fclose(file: i64) -> i64
extern func sinf(x: float) -> float
extern func cosf(x: float) -> float

struct Sound(samples: ptr<float>, count: i64, rate: i64, channels: i64) {

    // The length in seconds.
    func seconds() -> float {
        return this.count.toFloat() / this.rate.toFloat()
    }

    // Multiply every sample by `gain` (a gain of 0.5 is half the amplitude, about 6 decibels quieter).
    func scale(gain: float) -> i64 {
        let data: ptr<float> = this.samples
        for (i = 0; i < this.count * this.channels; i = i + 1) {
            data[i] = data[i] * gain
        }
        return 0
    }

    // MIX another sound into this one: add `other`, scaled by `gain`, starting `start` seconds in
    // (parts that would run past the end are dropped). Mixing is just adding the numbers. Channel c
    // of this sound receives channel c of `other`; a mono `other` goes into every channel.
    func add(other: Sound, start: float, gain: float) -> i64 {
        let data: ptr<float> = this.samples
        let source: ptr<float> = other.samples
        let first: i64 = (start * this.rate.toFloat()).toI64()
        for (i = 0; i < other.count; i = i + 1) {
            let at: i64 = first + i
            if (at >= 0 && at < this.count) {
                for (c = 0; c < this.channels; c = c + 1) {
                    data[at * this.channels + c] = data[at * this.channels + c] + gain * source[i * other.channels + c % other.channels]
                }
            }
        }
        return 0
    }

    // Add one note of a simple waveform: `shape` 0 sine, 1 square, 2 sawtooth, 3 triangle; the given
    // frequency (Hz) and amplitude; from `start` for `length` seconds, with a short fade in and out
    // so it does not click. Several tones at once make a chord. Every channel gets the note.
    func tone(shape: i64, frequency: float, amplitude: float, start: float, length: float) -> i64 {
        let data: ptr<float> = this.samples
        let first: i64 = (start * this.rate.toFloat()).toI64()
        let n: i64 = (length * this.rate.toFloat()).toI64()
        for (i = 0; i < n; i = i + 1) {
            let at: i64 = first + i
            if (at >= 0 && at < this.count) {
                let t: float = i.toFloat() / this.rate.toFloat()
                let value: float = amplitude * fade(t, 0.02, 0.05, length) * oscillator(shape, frequency * t)
                for (c = 0; c < this.channels; c = c + 1) {
                    data[at * this.channels + c] = data[at * this.channels + c] + value
                }
            }
        }
        return 0
    }

    // Add hiss: a repeatable pseudo-random number from `-amplitude` to `+amplitude` at every sample
    // (a different one in each channel).
    func noise(amplitude: float, seed: i64) -> i64 {
        let data: ptr<float> = this.samples
        for (i = 0; i < this.count * this.channels; i = i + 1) {
            data[i] = data[i] + amplitude * noise((seed + i).toI32())
        }
        return 0
    }

    // The loudest sample, ignoring its sign (0 for silence, 1 for the loudest a speaker can play).
    func peak() -> float {
        let data: ptr<float> = this.samples
        var loudest: float = 0.0
        for (i = 0; i < this.count * this.channels; i = i + 1) {
            var level: float = data[i]
            if (level < 0.0) { level = 0.0 - level }
            if (level > loudest) { loudest = level }
        }
        return loudest
    }

    // Scale the sound so its loudest sample is exactly `level` (0 to 1). Mixing many sounds can
    // go past 1, which a speaker cannot reproduce (it clips): normalizing prevents that.
    func normalize(level: float) -> i64 {
        let loudest: float = this.peak()
        if (loudest > 0.0) { this.scale(level / loudest) }
        return 0
    }

    // How strong the pure tone of `hz` is in channel 0 from `start` to `start + length` seconds: the height of the
    // sine wave of that frequency hiding in the sound, found by multiplying the samples by a sine and a cosine of that
    // frequency and adding up (a Fourier transform at one frequency). A tone of height 0.5 reads 0.5; a frequency that is
    // not there reads near 0. Exact when the stretch holds a whole number of cycles of `hz`; otherwise close.
    func strength(hz: float, start: float, length: float) -> float {
        let first: i64 = (start * this.rate.toFloat()).toI64()
        let n: i64 = (length * this.rate.toFloat()).toI64()
        return strengthOfArray(this.takeChannel(0), first, n, this.rate, hz)
    }

    // ── channels: stereo and beyond ────────────────────────────────────────────────────────
    // Channel `c` on its own: a new array of `count` samples (a copy), and `putChannel` copies
    // such an array back. The filters below run on one channel at a time with these.
    func takeChannel(c: i64) -> ptr<float> {
        let one: ptr<float> = calloc(this.count + 1, 4).toPtr()
        let data: ptr<float> = this.samples
        for (i = 0; i < this.count; i = i + 1) {
            one[i] = data[i * this.channels + c]
        }
        return one
    }

    func putChannel(c: i64, one: ptr<float>) -> i64 {
        let data: ptr<float> = this.samples
        for (i = 0; i < this.count; i = i + 1) {
            data[i * this.channels + c] = one[i]
        }
        return 0
    }

    // Channel `c` as a mono Sound of its own (a copy).
    func channel(c: i64) -> Sound {
        return Sound(samples: this.takeChannel(c), count: this.count, rate: this.rate, channels: 1)
    }

    // Every channel averaged into one: a stereo mix played on a mono speaker.
    func toMono() -> Sound {
        let result: Sound = soundNewFrames(this.count, this.rate, 1)
        let out: ptr<float> = result.samples
        let data: ptr<float> = this.samples
        for (i = 0; i < this.count; i = i + 1) {
            for (c = 0; c < this.channels; c = c + 1) {
                out[i] = out[i] + data[i * this.channels + c] / this.channels.toFloat()
            }
        }
        return result
    }

    // A mono sound placed in a stereo picture. `position` runs from -1 (all in the left speaker)
    // through 0 (the middle) to +1 (all in the right). The two volumes follow the constant-power
    // rule: left = cos(angle), right = sin(angle), so the total loudness does not change as the
    // sound moves (in the middle each side is 0.707, 3 decibels down, not 0.5). A sound that already
    // has several channels is mixed to mono first.
    func pan(position: float) -> Sound {
        let mono: Sound = this.toMono()
        let result: Sound = soundNewFrames(this.count, this.rate, 2)
        let out: ptr<float> = result.samples
        let angle: float = (position + 1.0) * 0.7853982
        for (i = 0; i < this.count; i = i + 1) {
            out[i * 2] = cosf(angle) * mono.samples[i]
            out[i * 2 + 1] = sinf(angle) * mono.samples[i]
        }
        return result
    }

    // A stereo copy of a mono sound (the same samples in both channels, no change in loudness).
    func toStereo() -> Sound {
        let result: Sound = soundNewFrames(this.count, this.rate, 2)
        let out: ptr<float> = result.samples
        let data: ptr<float> = this.samples
        for (i = 0; i < this.count; i = i + 1) {
            out[i * 2] = data[i * this.channels]
            out[i * 2 + 1] = data[i * this.channels + this.channels - 1]
        }
        return result
    }

    // ── filters: reshape the spectrum (see section 23 of the guide) ───────────────────────
    // LOW-PASS: lets slow waves through and softens fast ones (a "dull" or "muffled" sound).
    // A one-pole filter: each output moves a fraction `alpha` of the way from the previous output
    // toward the new input sample. Above the cutoff (Hz) the volume falls by half for every
    // doubling of frequency (6 decibels per octave); at the cutoff itself it is 71% (-3 dB).
    func lowPass(cutoff: float) -> i64 {
        for (c = 0; c < this.channels; c = c + 1) {
            let one: ptr<float> = this.takeChannel(c)
            lowPassArray(one, this.count, this.rate, cutoff)
            this.putChannel(c, one)
        }
        return 0
    }

    // HIGH-PASS: the opposite: removes slow waves (rumble, a constant offset) and keeps fast ones
    // (a "thin" sound). Its response is the low-pass's mirror image around the cutoff.
    func highPass(cutoff: float) -> i64 {
        for (c = 0; c < this.channels; c = c + 1) {
            let one: ptr<float> = this.takeChannel(c)
            highPassArray(one, this.count, this.rate, cutoff)
            this.putChannel(c, one)
        }
        return 0
    }

    // Run any biquad filter (see Biquad.poly) over every channel. The named filters below are
    // each one line that builds a Biquad and applies it; apply several in a row to build an equalizer.
    func apply(filter: Biquad) -> i64 {
        for (c = 0; c < this.channels; c = c + 1) {
            let one: ptr<float> = this.takeChannel(c)
            filter.run(one, this.count)
            this.putChannel(c, one)
        }
        return 0
    }

    // Steeper filters than lowPass/highPass: 12 decibels per octave (the volume falls to a quarter
    // for every doubling of frequency). `q` is the resonance: 0.707 is the flattest; a larger q
    // adds a bump at the cutoff, as on a synthesizer; a smaller one rounds the corner.
    func lowPassSteep(cutoff: float, q: float) -> i64 {
        return this.apply(biquadLowPass(this.rate, cutoff, q))
    }

    func highPassSteep(cutoff: float, q: float) -> i64 {
        return this.apply(biquadHighPass(this.rate, cutoff, q))
    }

    // BAND-PASS: keeps only a band around `center` Hz (a telephone-like or "wah" sound); `q` is how
    // narrow the band is (the band is about center / q Hz wide).
    func bandPass(center: float, q: float) -> i64 {
        return this.apply(biquadBandPass(this.rate, center, q))
    }

    // NOTCH: removes a narrow band around `center` Hz and keeps the rest: kills a 50 or 60 Hz mains hum.
    func notch(center: float, q: float) -> i64 {
        return this.apply(biquadNotch(this.rate, center, q))
    }

    // BELL (a peaking equalizer): boosts (positive `gainDb`) or cuts (negative) the band around
    // `center` Hz by that many decibels and leaves everything else alone. +6 decibels doubles the amplitude.
    func bell(center: float, q: float, gainDb: float) -> i64 {
        return this.apply(biquadBell(this.rate, center, q, gainDb))
    }

    // SHELVES: the "bass" and "treble" knobs: change everything below (or above) `corner` Hz by `gainDb`.
    func lowShelf(corner: float, gainDb: float) -> i64 {
        return this.apply(biquadLowShelf(this.rate, corner, gainDb))
    }

    func highShelf(corner: float, gainDb: float) -> i64 {
        return this.apply(biquadHighShelf(this.rate, corner, gainDb))
    }

    // ECHO with feedback: every sample also gets `gain` times the output heard `delay` seconds earlier,
    // so each repeat of a sound is `gain` as loud as the one before it (gain 0.5 halves it every time).
    // Make the sound long enough first (add silence) or the last repeats are cut off.
    func echo(delay: float, gain: float) -> i64 {
        let data: ptr<float> = this.samples
        let gap: i64 = (delay * this.rate.toFloat()).toI64() * this.channels
        for (i = gap; i < this.count * this.channels; i = i + 1) {
            data[i] = data[i] + gain * data[i - gap]
        }
        return 0
    }

    // REVERB: a room's dense wash of echoes, imitated with four echoes of different short delays
    // (about 30 to 44 milliseconds) running side by side and added up (a "Schroeder reverberator").
    // `wet` is how much of the processed sound to blend in (0 = none, 1 = only reverb). As with echo,
    // give the sound some silence at the end for the tail to ring into.
    func reverb(wet: float) -> i64 {
        for (c = 0; c < this.channels; c = c + 1) {
            let one: ptr<float> = this.takeChannel(c)
            reverbArray(one, this.count, this.rate, wet)
            this.putChannel(c, one)
        }
        return 0
    }

    // CONVOLUTION: replace every sample of this sound by a copy of the whole `response` sound, scaled by
    // that sample, and add all the copies. The result is `response.count - 1` samples longer. With a
    // response of a few spikes this is an echo; with a recording of a real room's response to a single
    // click it is that room's reverb; with a short smooth response it is a low-pass filter. This direct
    // form does count * response.count multiplications, so it suits short responses. Channel c of this
    // sound meets channel c of the response (a mono response is used for every channel).
    func convolve(response: Sound) -> Sound {
        let result: Sound = soundNewFrames(this.count + response.count - 1, this.rate, this.channels)
        for (c = 0; c < this.channels; c = c + 1) {
            let one: ptr<float> = this.takeChannel(c)
            let weights: ptr<float> = response.takeChannel(c % response.channels)
            result.putChannel(c, convolveArrays(one, this.count, weights, response.count))
        }
        return result
    }

    // A copy of this sound at another sample rate, with the same pitch and the same length in seconds
    // (see Resample.poly for how, and why going to a lower rate also low-pass filters).
    func resample(newRate: i64) -> Sound {
        let result: Sound = soundNewFrames(resampledCount(this.count, this.rate, newRate), newRate, this.channels)
        for (c = 0; c < this.channels; c = c + 1) {
            let one: ptr<float> = this.takeChannel(c)
            result.putChannel(c, resampleArray(one, this.count, this.rate, newRate))
        }
        return result
    }

    // Write a 16-bit WAV file: a 44-byte header (the sample rate, the number of channels, the
    // size of each sample) then every sample as a whole number from -32768 to 32767, low byte
    // first, interleaved. Samples outside -1..1 are clipped. Returns 1 if the file was written, 0 if not.
    func saveWav(path: string) -> i64 {
        let values: i64 = this.count * this.channels
        let total: i64 = 44 + values * 2
        let bytes: ptr<i8> = calloc(total, 1).toPtr()
        var at: i64 = soundLetters(bytes, 0, 82, 73, 70, 70)
        at = soundNumber32(bytes, at, total - 8)
        at = soundLetters(bytes, at, 87, 65, 86, 69)
        at = soundLetters(bytes, at, 102, 109, 116, 32)
        at = soundNumber32(bytes, at, 16)
        at = soundNumber16(bytes, at, 1)
        at = soundNumber16(bytes, at, this.channels)
        at = soundNumber32(bytes, at, this.rate)
        at = soundNumber32(bytes, at, this.rate * 2 * this.channels)
        at = soundNumber16(bytes, at, 2 * this.channels)
        at = soundNumber16(bytes, at, 16)
        at = soundLetters(bytes, at, 100, 97, 116, 97)
        at = soundNumber32(bytes, at, values * 2)
        let data: ptr<float> = this.samples
        for (k = 0; k < values; k = k + 1) {
            let level: float = clamp(data[k], 0.0 - 1.0, 1.0)
            var whole: i64 = (level * 32767.0).toI64()
            if (whole < 0) { whole = whole + 65536 }
            soundNumber16(bytes, 44 + 2 * k, whole)
        }
        let file: i64 = fopen(path, "wb")
        if (file == 0) { return 0 }
        fwrite(bytes.toI64(), 1, total, file)
        fclose(file)
        return 1
    }
}

// A new, silent mono sound `seconds` long.
func soundNew(seconds: float, rate: i64) -> Sound {
    return soundNewFrames((seconds * rate.toFloat()).toI64(), rate, 1)
}

// A new, silent sound `seconds` long with `channels` channels (2 for stereo).
func soundNewChannels(seconds: float, rate: i64, channels: i64) -> Sound {
    return soundNewFrames((seconds * rate.toFloat()).toI64(), rate, channels)
}

// A new, silent sound of exactly `frames` frames.
func soundNewFrames(frames: i64, rate: i64, channels: i64) -> Sound {
    return Sound(samples: calloc(frames * channels + 1, 4).toPtr(), count: frames, rate: rate, channels: channels)
}

// A stereo sound from two mono sounds (the longer one decides the length; the shorter ends in silence).
func soundStereo(left: Sound, right: Sound) -> Sound {
    var frames: i64 = left.count
    if (right.count > frames) { frames = right.count }
    let result: Sound = soundNewFrames(frames, left.rate, 2)
    let out: ptr<float> = result.samples
    for (i = 0; i < left.count; i = i + 1) { out[i * 2] = left.samples[i * left.channels] }
    for (i = 0; i < right.count; i = i + 1) { out[i * 2 + 1] = right.samples[i * right.channels] }
    return result
}

// The strength of the pure tone of `hz` in `count` samples of `data` starting at `start` (see Sound.strength).
func strengthOfArray(data: ptr<float>, start: i64, count: i64, rate: i64, hz: float) -> float {
    var re: double = 0.0
    var im: double = 0.0
    for (k = 0; k < count; k = k + 1) {
        let angle: double = 6.283185307179586 * hz.toDouble() * (start + k).toDouble() / rate.toDouble()
        re = re + data[start + k].toDouble() * cos(angle)
        im = im + data[start + k].toDouble() * sin(angle)
    }
    return (2.0 * sqrt(re * re + im * im) / count.toDouble()).toFloat()
}

// ── the same filters on a plain array ─────────────────────────────────────────────────────
// One-pole low-pass: `previous` moves a fraction alpha of the way toward each new input.
func lowPassArray(data: ptr<float>, count: i64, rate: i64, cutoff: float) -> i64 {
    let dt: float = 1.0 / rate.toFloat()
    let rc: float = 1.0 / (6.2831853 * cutoff)
    let alpha: float = dt / (rc + dt)
    var previous: float = 0.0
    for (i = 0; i < count; i = i + 1) {
        previous = previous + alpha * (data[i] - previous)
        data[i] = previous
    }
    return 0
}

// One-pole high-pass: what the low-pass would remove, keeping the fast changes.
func highPassArray(data: ptr<float>, count: i64, rate: i64, cutoff: float) -> i64 {
    let dt: float = 1.0 / rate.toFloat()
    let rc: float = 1.0 / (6.2831853 * cutoff)
    let alpha: float = rc / (rc + dt)
    var lastIn: float = 0.0
    var lastOut: float = 0.0
    for (i = 0; i < count; i = i + 1) {
        let x: float = data[i]
        lastOut = alpha * (lastOut + x - lastIn)
        lastIn = x
        data[i] = lastOut
    }
    return 0
}

// Four feedback echoes (see Sound.reverb), added and blended with the original.
func reverbArray(data: ptr<float>, count: i64, rate: i64, wet: float) -> i64 {
    let sum: ptr<float> = calloc(count + 1, 4).toPtr()
    for (c = 0; c < 4; c = c + 1) {
        let gap: i64 = (combDelay(c) * rate.toFloat()).toI64()
        let feedback: float = combFeedback(c)
        let line: ptr<float> = calloc(count + 1, 4).toPtr()
        for (i = 0; i < count; i = i + 1) {
            var v: float = data[i]
            if (i >= gap) { v = v + feedback * line[i - gap] }
            line[i] = v
            sum[i] = sum[i] + 0.25 * (1.0 - feedback) * v
        }
    }
    for (i = 0; i < count; i = i + 1) {
        data[i] = (1.0 - wet) * data[i] + wet * sum[i]
    }
    return 0
}

// The full convolution of two arrays: nx + nh - 1 samples.
func convolveArrays(x: ptr<float>, nx: i64, h: ptr<float>, nh: i64) -> ptr<float> {
    let out: ptr<float> = calloc(nx + nh, 4).toPtr()
    for (i = 0; i < nx; i = i + 1) {
        for (j = 0; j < nh; j = j + 1) {
            out[i + j] = out[i + j] + x[i] * h[j]
        }
    }
    return out
}

// The delays (seconds) and feedbacks of the four echoes inside `reverb`.
func combDelay(c: i64) -> float {
    if (c == 0) { return 0.0297 }
    if (c == 1) { return 0.0371 }
    if (c == 2) { return 0.0411 }
    return 0.0437
}

func combFeedback(c: i64) -> float {
    if (c == 0) { return 0.805 }
    if (c == 1) { return 0.827 }
    if (c == 2) { return 0.783 }
    return 0.764
}

// One sample of the oscillator numbered `shape` at `phase` whole cycles (see Wave.poly).
func oscillator(shape: i64, phase: float) -> float {
    if (shape == 1) { return square(phase) }
    if (shape == 2) { return sawtooth(phase) }
    if (shape == 3) { return triangle(phase) }
    return sine(phase)
}

// ── reading WAV files ────────────────────────────────────────────────────────────────────
// A WAV file is a RIFF container: the letters RIFF, a size, the letters WAVE, then CHUNKS, each a
// four-letter name, a 32-bit size, and that many bytes (padded to an even number). The "fmt "
// chunk says how the samples are stored; the "data" chunk holds them; others (LIST: the artist's
// name, and so on) are skipped. Supported: whole-number samples of 8 (unsigned), 16, 24 and 32
// bits, and floating-point samples of 32 and 64 bits, with any number of channels, including the
// "extensible" header newer programs write.
//
// `soundLoadWav` returns a Sound with `count` 0 if the file is missing or is not a WAV file we read.
func soundLoadWav(path: string) -> Sound {
    let slot: ptr<i64> = calloc(1, 8).toPtr()
    let size: i64 = soundReadFile(path, slot)
    let bytes: ptr<i8> = slot[0].toPtr()
    let info: WavInfo = wavParse(bytes, size)
    if (info.format == 0) { return soundNewFrames(0, 0, 1) }
    return wavDecode(bytes, info)
}

// Where the samples are and how they are stored.
struct WavInfo(format: i64, channels: i64, rate: i64, bits: i64, dataStart: i64, dataBytes: i64)

// Reads the whole file into memory: returns the number of bytes (0 if it cannot be read) and
// stores the memory's address in `out[0]`.
func soundReadFile(path: string, out: ptr<i64>) -> i64 {
    let file: i64 = fopen(path, "rb")
    if (file == 0) { return 0 }
    fseek(file, 0, 2)
    let size: i64 = ftell(file)
    fseek(file, 0, 0)
    let memory: i64 = calloc(size + 8, 1)
    let got: i64 = fread(memory, 1, size, file)
    fclose(file)
    out[0] = memory
    return got
}

// Walks the chunks. `format` in the result is 0 if the file is not a usable WAV file, else 1 (whole
// numbers) or 3 (floating point). (A struct is a value, not memory, so the result is built whole.)
func wavParse(bytes: ptr<i8>, size: i64) -> WavInfo {
    let none: WavInfo = WavInfo(format: 0, channels: 0, rate: 0, bits: 0, dataStart: 0, dataBytes: 0)
    if (size < 12 || soundWord(bytes, 0) != soundTag(82, 73, 70, 70) || soundWord(bytes, 8) != soundTag(87, 65, 86, 69)) { return none }
    var found: WavInfo = none
    var at: i64 = 12
    for (step = 0; step < 64; step = step + 1) {
        if (at + 8 <= size) {
            let name: i64 = soundWord(bytes, at)
            let length: i64 = soundWord(bytes, at + 4)
            if (name == soundTag(102, 109, 116, 32) && at + 24 <= size) { found = wavFormat(bytes, at + 8, length) }
            if (name == soundTag(100, 97, 116, 97) && found.format != 0) {
                return WavInfo(format: found.format, channels: found.channels, rate: found.rate, bits: found.bits, dataStart: at + 8, dataBytes: wavDataBytes(length, size - at - 8))
            }
            at = at + 8 + length + length % 2
        }
    }
    return none
}

// A data chunk may claim more bytes than the file holds (a recording cut short): use what is there.
func wavDataBytes(claimed: i64, available: i64) -> i64 {
    if (claimed > available) { return available }
    return claimed
}

// Four letters (by character code) as one number, low byte first: how a chunk name is compared.
func soundTag(a: i64, b: i64, c: i64, d: i64) -> i64 {
    return a + 256 * b + 65536 * c + 16777216 * d
}

// The "fmt " chunk: tag (1 whole numbers, 3 floating point, 65534 extensible: the real tag is
// inside), channels, rate, then bits per sample. Anything else is reported as format 0.
func wavFormat(bytes: ptr<i8>, at: i64, length: i64) -> WavInfo {
    var tag: i64 = soundSigned(bytes, at, 2)
    if (tag < 0) { tag = tag + 65536 }
    if (tag == 65534 && length >= 40) { tag = soundByte(bytes, at + 24) + 256 * soundByte(bytes, at + 25) }
    let bits: i64 = soundByte(bytes, at + 14) + 256 * soundByte(bytes, at + 15)
    var format: i64 = 0
    if (tag == 1 && (bits == 8 || bits == 16 || bits == 24 || bits == 32)) { format = 1 }
    if (tag == 3 && (bits == 32 || bits == 64)) { format = 3 }
    return WavInfo(format: format, channels: soundByte(bytes, at + 2) + 256 * soundByte(bytes, at + 3), rate: soundWord(bytes, at + 4), bits: bits, dataStart: 0, dataBytes: 0)
}

// Converts every stored sample to a float from -1 to +1.
func wavDecode(bytes: ptr<i8>, info: WavInfo) -> Sound {
    let width: i64 = info.bits / 8
    let frames: i64 = info.dataBytes / (width * info.channels)
    let result: Sound = soundNewFrames(frames, info.rate, info.channels)
    let out: ptr<float> = result.samples
    let scratch: ptr<i8> = calloc(8, 1).toPtr()
    for (k = 0; k < frames * info.channels; k = k + 1) {
        out[k] = wavSample(bytes, info.dataStart + k * width, info.format, info.bits, scratch)
    }
    return result
}

func wavSample(bytes: ptr<i8>, at: i64, format: i64, bits: i64, scratch: ptr<i8>) -> float {
    if (format == 3) { return wavFloat(bytes, at, bits, scratch) }
    if (bits == 8) { return (soundByte(bytes, at) - 128).toFloat() / 128.0 }
    if (bits == 16) { return soundSigned(bytes, at, 2).toFloat() / 32768.0 }
    if (bits == 24) { return soundSigned(bytes, at, 3).toFloat() / 8388608.0 }
    return soundSigned(bytes, at, 4).toFloat() / 2147483648.0
}

// A floating-point sample: copy its bytes to a properly aligned spot, then read it as a number.
func wavFloat(bytes: ptr<i8>, at: i64, bits: i64, scratch: ptr<i8>) -> float {
    for (k = 0; k < bits / 8; k = k + 1) { scratch[k] = bytes[at + k] }
    if (bits == 64) {
        let wide: ptr<double> = scratch.toI64().toPtr()
        return wide[0].toFloat()
    }
    let narrow: ptr<float> = scratch.toI64().toPtr()
    return narrow[0]
}

// A byte as a number from 0 to 255 (a byte read from memory may come back negative).
func soundByte(bytes: ptr<i8>, at: i64) -> i64 {
    var value: i64 = bytes[at].toI64()
    if (value < 0) { value = value + 256 }
    return value
}

// `width` bytes, low byte first, as a whole number that may be negative (two's complement).
func soundSigned(bytes: ptr<i8>, at: i64, width: i64) -> i64 {
    var value: i64 = 0
    var weight: i64 = 1
    for (k = 0; k < width; k = k + 1) {
        value = value + soundByte(bytes, at + k) * weight
        weight = weight * 256
    }
    if (value >= weight / 2) { value = value - weight }
    return value
}

// Four bytes, low byte first, as a number from 0 up (the sizes and rates in a WAV header).
func soundWord(bytes: ptr<i8>, at: i64) -> i64 {
    return soundByte(bytes, at) + 256 * soundByte(bytes, at + 1) + 65536 * soundByte(bytes, at + 2) + 16777216 * soundByte(bytes, at + 3)
}

// WAV header helpers: four letters (by character code), then 32-bit and 16-bit numbers, low byte first.
func soundLetters(bytes: ptr<i8>, at: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    bytes[at] = a
    bytes[at + 1] = b
    bytes[at + 2] = c
    bytes[at + 3] = d
    return at + 4
}

func soundNumber32(bytes: ptr<i8>, at: i64, value: i64) -> i64 {
    bytes[at] = value % 256
    bytes[at + 1] = (value / 256) % 256
    bytes[at + 2] = (value / 65536) % 256
    bytes[at + 3] = (value / 16777216) % 256
    return at + 4
}

func soundNumber16(bytes: ptr<i8>, at: i64, value: i64) -> i64 {
    bytes[at] = value % 256
    bytes[at + 1] = (value / 256) % 256
    return at + 2
}
