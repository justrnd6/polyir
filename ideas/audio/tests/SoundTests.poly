// The Sound library (ideas/audio/Sound.poly), mono: building, mixing, scaling, filters, echo, reverb,
// convolution. A 125 Hz tone at 1000 samples a second has a whole number of samples per quarter
// cycle, so its loudest sample is exactly its amplitude.
import "../Sound.poly"
import "../../../core/tests/programs/Check.poly"

func quietTone() -> Sound {
    let s: Sound = soundNew(0.1, 1000)
    s.tone(0, 125.0, 0.5, 0.0, 0.1)
    return s
}

func checkNewSoundIsMono() -> double { return offInt(soundNew(1.0, 8000).channels, 1) }

func checkNewSoundLength() -> double { return offInt(soundNew(2.5, 8000).count, 20000) }

func checkSeconds() -> double { return off(soundNew(2.5, 8000).seconds(), 2.5) }

func checkTonePeak() -> double { return off(quietTone().peak(), 0.5) }

func checkSquareTonePeak() -> double {
    let s: Sound = soundNew(0.1, 1000)
    s.tone(1, 125.0, 0.4, 0.0, 0.1)
    return off(s.peak(), 0.4)
}

func checkScale() -> double {
    let s: Sound = quietTone()
    s.scale(0.5)
    return off(s.peak(), 0.25)
}

// Two equal tones in phase add to twice the height.
func checkMixAdds() -> double {
    let a: Sound = quietTone()
    a.add(quietTone(), 0.0, 1.0)
    return off(a.peak(), 1.0)
}

func checkNormalize() -> double {
    let s: Sound = soundNew(0.1, 1000)
    s.tone(0, 125.0, 0.3, 0.0, 0.1)
    s.normalize(0.9)
    return off(s.peak(), 0.9)
}

// Mixing a short sound in half a second late does not change the length, and the first half second stays silent.
func checkDelayedMixKeepsLength() -> double {
    let a: Sound = soundNew(1.0, 1000)
    a.add(quietTone(), 0.5, 1.0)
    return offInt(a.count, 1000)
}

func checkDelayedMixIsSilentBefore() -> double {
    let a: Sound = soundNew(1.0, 1000)
    a.add(quietTone(), 0.5, 1.0)
    return off(a.samples[499], 0.0)
}

// The note's sample number 25 (at 525 once delayed) is 0.5 * sine(125 * 0.025 cycles) = 0.5 * 0.7071.
func checkDelayedMixStartsLater() -> double {
    let a: Sound = soundNew(1.0, 1000)
    a.add(quietTone(), 0.5, 1.0)
    return off(a.samples[525], 0.35355339)
}

// The stretch of a tone's samples that is level (after the fade in, before the fade out).
func checkToneFadesIn() -> double {
    let s: Sound = soundNew(0.5, 8000)
    s.tone(0, 440.0, 1.0, 0.0, 0.5)
    return off(s.samples[0], 0.0)
}

func checkNoiseAmplitude() -> double {
    let s: Sound = soundNew(0.1, 8000)
    s.noise(0.25, 7)
    let loudest: float = s.peak()
    if (loudest > 0.25) { return 1.0 }
    if (loudest < 0.2) { return 1.0 }
    return 0.0
}

// ── filters ────────────────────────────────────────────────────────────────────────────────
// A one-second sine of `hz` at 8000 samples a second through a one-pole filter; the loudest sample of its last quarter second.
func filterGain(kind: i64, hz: float, cutoff: float) -> float {
    let s: Sound = soundNew(1.0, 8000)
    let data: ptr<float> = s.samples
    for (i = 0; i < 8000; i = i + 1) {
        data[i] = sine(hz * i.toFloat() / 8000.0)
    }
    if (kind == 0) { s.lowPass(cutoff) } else { s.highPass(cutoff) }
    var loudest: float = 0.0
    for (i = 6000; i < 8000; i = i + 1) {
        var level: float = data[i]
        if (level < 0.0) { level = 0.0 - level }
        if (level > loudest) { loudest = level }
    }
    return loudest
}

// The expected numbers come from running the same recurrence in a separate program (Python).
func checkLowPassCutsHighTone() -> double { return off(filterGain(0, 1000.0, 500.0), 0.3987) }

func checkLowPassKeepsLowTone() -> double { return off(filterGain(0, 200.0, 500.0), 0.9031) }

func checkHighPassKeepsHighTone() -> double { return off(filterGain(1, 1000.0, 500.0), 0.7225) }

func checkHighPassCutsLowTone() -> double { return off(filterGain(1, 200.0, 500.0), 0.3613) }

// An impulse with an echo of 0.1 s at gain 0.5 is 0.5 at sample 100 and 0.25 at sample 200.
func checkEchoFirstRepeat() -> double {
    let s: Sound = soundNew(0.5, 1000)
    s.samples[0] = 1.0
    s.echo(0.1, 0.5)
    return off(s.samples[100], 0.5)
}

func checkEchoSecondRepeat() -> double {
    let s: Sound = soundNew(0.5, 1000)
    s.samples[0] = 1.0
    s.echo(0.1, 0.5)
    return off(s.samples[200], 0.25)
}

// [1, 2] convolved with [1, 0, 3] is [1, 2, 3, 6].
func convolved() -> Sound {
    let a: Sound = soundNew(0.002, 1000)
    let r: Sound = soundNew(0.003, 1000)
    a.samples[0] = 1.0
    a.samples[1] = 2.0
    r.samples[0] = 1.0
    r.samples[2] = 3.0
    return a.convolve(r)
}

func checkConvolutionLength() -> double { return offInt(convolved().count, 4) }

func checkConvolutionValues() -> double {
    let y: ptr<float> = convolved().samples
    return off(y[0], 1.0) + off(y[1], 2.0) + off(y[2], 3.0) + off(y[3], 6.0)
}

// Reverb of an impulse (wet = 1): sample 0 is 0.25 * the sum of (1 - feedback) over four lines = 0.20525; the first echo
// of the shortest line lands at sample 297 (0.0297 s at 10,000 Hz) with 0.25 * (1 - 0.805) * 0.805 = 0.03924.
func reverbOfImpulse() -> Sound {
    let s: Sound = soundNew(1.0, 10000)
    s.samples[0] = 1.0
    s.reverb(1.0)
    return s
}

func checkReverbStart() -> double { return off(reverbOfImpulse().samples[0], 0.20525) }

func checkReverbFirstEcho() -> double { return off(reverbOfImpulse().samples[297], 0.03924) }
