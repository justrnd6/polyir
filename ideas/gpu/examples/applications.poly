// GPU kernels for geometry and math, glued into an ordinary CPU program (Metal).
//
//   polyir --emit-msl applications.poly > applications.metal
//   polyir applications.poly --out applications && ./applications   (Apple Silicon; run in this folder)
//
// Four kernels, four ideas:
//   circleHit  geometry: which pixels of a grid lie inside a circle (2D grid from a 1D index)
//   rotate     geometry: rotate points around the origin (a 2x2 matrix times a vector)
//   mandel     math: iterate z = z*z + c for every point and count the steps (loop per thread)
//   transform  geometry: a 4x4 matrix (rotate, then move) applied to many 3D points
//   dotTerm    math: multiply two arrays element by element; the CPU then adds the products
//              up (the GPU does the parallel part, the CPU the sum: a "reduction" the easy way)
//
// The program also shows how to glue a kernel to normal code: `scaleAll` runs on the
// GPU when there is one and the input is big enough to be worth it, and otherwise
// calls the very same kernel on the CPU. Exit 0 means every result was right;
// 10 no GPU, 20 + n means check n failed.
import "../Metal.poly"
import "shared/matrix.poly"

extern func sqrtf(x: float) -> float

// ── geometry ────────────────────────────────────────────────────────────────
// A w-by-w grid is stored as one row after another, so element i sits at column
// i % w and row i / w. 1 when that cell's centre is inside the circle.
kernel func circleHit(index i: i32, uniform w: i32, uniform radius: float) -> i32 {
    let dx: float = (i % w).toFloat() - w.toFloat() * 0.5
    let dy: float = (i / w).toFloat() - w.toFloat() * 0.5
    if (dx * dx + dy * dy <= radius * radius) { return 1 }
    return 0
}

// A point is (x, y) in the first two slots of a vec4. Rotating by an angle whose
// cosine and sine are c and s is the matrix [c -s; s c] times the point.
kernel func rotate(p: vec<float, 4>, uniform c: float, uniform s: float) -> vec<float, 4> {
    return vec[c * p[0] - s * p[1], s * p[0] + c * p[1], 0.0, 0.0]
}

// ── math ────────────────────────────────────────────────────────────────────
// How many steps z = z*z + c takes to leave the circle of radius 2 (at most
// `limit`), for the point of a w-by-h picture that element i stands for.
kernel func mandel(index i: i32, uniform w: i32, uniform limit: i32) -> i32 {
    let cr: float = (i % w).toFloat() * 3.0 / w.toFloat() - 2.0
    let ci: float = (i / w).toFloat() * 2.0 / w.toFloat() - 1.0
    var zr: float = 0.0
    var zi: float = 0.0
    var steps: i32 = 0
    for (k = 0; k < limit; k = k + 1) {
        if (zr * zr + zi * zi <= 4.0) {
            let next: float = zr * zr - zi * zi + cr
            zi = 2.0 * zr * zi + ci
            zr = next
            steps = steps + 1
        }
    }
    return steps
}

kernel func dotTerm(a: float, b: float) -> float {
    return a * b
}

// ── gluing a kernel to CPU code ─────────────────────────────────────────────
// One entry point for callers: `out[i] = x[i] * k` for i < n. Callers never see Metal.
// Below `smallest` elements the GPU is not worth its set-up cost, so the CPU runs
// the same kernel in a loop; so it does when there is no GPU or Metal refuses.
func scaleAll(x: ptr<float>, out: ptr<float>, n: i64, k: float, smallest: i64) -> i64 {
    if (n >= smallest) {
        if (scaleOnGpu(x, out, n, k) == 1) { return 1 }
    }
    for (i = 0; i < n; i = i + 1) {
        out[i] = scale(x[i], k)
    }
    return 0
}

kernel func scale(x: float, uniform k: float) -> float {
    return x * k
}

// Returns 1 when the GPU did the work, 0 when it could not.
func scaleOnGpu(x: ptr<float>, out: ptr<float>, n: i64, k: float) -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 0 }
    let pipeline: i64 = metalPipeline(device, metalReadFile("applications.metal"), "scale")
    if (pipeline == 0) { return 0 }
    let factor: float[1]
    factor[0] = k
    let bytes: i64 = n * 4
    let result: i64 = metalEmptyBuffer(device, bytes)
    let ok: i64 = metalDispatch(device, pipeline, n, metalBuffer(device, x.toI64(), bytes), metalBuffer(device, factor.toI64(), 4), result, 0)
    if (ok == 0) { return 0 }
    copyFloats(metalContents(result).toPtr(), out, n)
    return 1
}

func copyFloats(from: ptr<float>, to: ptr<float>, n: i64) -> i64 {
    for (i = 0; i < n; i = i + 1) {
        to[i] = from[i]
    }
    return 0
}

// ── the program ─────────────────────────────────────────────────────────────
func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let source: string = metalReadFile("applications.metal")
    if (checkCircle(device, source) != 0) { return 21 }
    if (checkRotate(device, source) != 0) { return 22 }
    if (checkMandel(device, source) != 0) { return 23 }
    if (checkDot(device, source) != 0) { return 24 }
    if (checkTransform(device, source) != 0) { return 26 }
    if (checkGlue() != 0) { return 25 }
    return 0
}

func checkCircle(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "circleHit")
    if (pipeline == 0) { return 1 }
    let w: i32[1]
    w[0] = 16
    let r: float[1]
    r[0] = 6.0
    let out: i64 = metalEmptyBuffer(device, 1024)
    metalDispatch(device, pipeline, 256, metalBuffer(device, w.toI64(), 4), metalBuffer(device, r.toI64(), 4), out, 0)
    let got: ptr<i32> = metalContents(out).toPtr()
    var inside: i64 = 0
    for (i = 0; i < 256; i = i + 1) {
        if (got[i] != circleHit(i, 16, 6.0)) { return 1 }
        inside = inside + got[i].toI64()
    }
    if (inside < 100 || inside > 130) { return 1 }
    return 0
}

func checkRotate(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "rotate")
    if (pipeline == 0) { return 1 }
    let pts: float[8]
    pts[0] = 1.0
    pts[1] = 0.0
    pts[2] = 0.0
    pts[3] = 0.0
    pts[4] = 2.0
    pts[5] = 3.0
    pts[6] = 0.0
    pts[7] = 0.0
    let c: float[1]
    c[0] = 0.0
    let s: float[1]
    s[0] = 1.0
    let out: i64 = metalEmptyBuffer(device, 32)
    metalDispatch(device, pipeline, 2, metalBuffer(device, pts.toI64(), 32), metalBuffer(device, c.toI64(), 4), metalBuffer(device, s.toI64(), 4), out)
    let got: ptr<float> = metalContents(out).toPtr()
    // A quarter turn takes (1, 0) to (0, 1) and (2, 3) to (-3, 2).
    if (got[0] != 0.0 || got[1] != 1.0) { return 1 }
    if (got[4] != 0.0 - 3.0 || got[5] != 2.0) { return 1 }
    return 0
}

func checkMandel(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "mandel")
    if (pipeline == 0) { return 1 }
    let w: i32[1]
    w[0] = 24
    let limit: i32[1]
    limit[0] = 50
    let out: i64 = metalEmptyBuffer(device, 2304)
    metalDispatch(device, pipeline, 576, metalBuffer(device, w.toI64(), 4), metalBuffer(device, limit.toI64(), 4), out, 0)
    let got: ptr<i32> = metalContents(out).toPtr()
    // The GPU may round the last bit of a float differently, which can change the
    // count for a point right on the edge, so a few differences are allowed.
    var differ: i64 = 0
    for (i = 0; i < 576; i = i + 1) {
        if (got[i] != mandel(i, 24, 50)) { differ = differ + 1 }
    }
    if (differ > 5) { return 1 }
    return 0
}

func checkDot(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "dotTerm")
    if (pipeline == 0) { return 1 }
    let a: float[4]
    let b: float[4]
    for (i = 0; i < 4; i = i + 1) {
        a[i] = (i + 1).toFloat()
        b[i] = (i + 2).toFloat()
    }
    let out: i64 = metalEmptyBuffer(device, 16)
    metalDispatch(device, pipeline, 4, metalBuffer(device, a.toI64(), 16), metalBuffer(device, b.toI64(), 16), out, 0)
    let got: ptr<float> = metalContents(out).toPtr()
    // The CPU adds the products: 1*2 + 2*3 + 3*4 + 4*5 = 40.
    var total: float = 0.0
    for (i = 0; i < 4; i = i + 1) {
        total = total + got[i]
    }
    if (total != 40.0) { return 1 }
    return 0
}

// The same call, once big enough for the GPU and once too small.
func checkGlue() -> i64 {
    let x: float[8]
    for (i = 0; i < 8; i = i + 1) {
        x[i] = i.toFloat()
    }
    let big: float[8]
    let small: float[8]
    let xs: ptr<float> = x.toI64().toPtr()
    let onGpu: i64 = scaleAll(xs, big.toI64().toPtr(), 8, 2.5, 4)
    let onCpu: i64 = scaleAll(xs, small.toI64().toPtr(), 8, 2.5, 1000)
    if (onGpu != 1 || onCpu != 0) { return 1 }
    for (i = 0; i < 8; i = i + 1) {
        if (big[i] != small[i] || big[i] != i.toFloat() * 2.5) { return 1 }
    }
    return 0
}

// The 4x4 matrix for "turn a quarter turn around z, then move by (1, 2, 3)" is the move
// matrix times the turn matrix (the one applied FIRST is written on the right).
// The other order, move then turn, gives different answers: matrix order matters.
func checkTransform(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "transform")
    if (pipeline == 0) { return 1 }
    let turn: float[16]
    let move: float[16]
    identity(turn.toI64().toPtr())
    identity(move.toI64().toPtr())
    // Quarter turn around z: cos = 0, sin = 1, so x' = -y, y' = x.
    turn[0] = 0.0
    turn[1] = 0.0 - 1.0
    turn[4] = 1.0
    turn[5] = 0.0
    move[3] = 1.0
    move[7] = 2.0
    move[11] = 3.0
    let turnThenMove: float[16]
    multiply4(move.toI64().toPtr(), turn.toI64().toPtr(), turnThenMove.toI64().toPtr())
    let pts: float[12]
    pts[0] = 1.0
    pts[1] = 0.0
    pts[2] = 0.0
    pts[3] = 1.0
    pts[4] = 0.0
    pts[5] = 2.0
    pts[6] = 0.0
    pts[7] = 1.0
    pts[8] = 1.0
    pts[9] = 1.0
    pts[10] = 1.0
    pts[11] = 1.0
    let out: i64 = metalEmptyBuffer(device, 48)
    metalDispatch(device, pipeline, 3, metalBuffer(device, pts.toI64(), 48), metalBuffer(device, turnThenMove.toI64(), 64), out, 0)
    let got: ptr<float> = metalContents(out).toPtr()
    // (1,0,0) turns to (0,1,0), then moves to (1,3,3); (0,2,0) to (-2,0,0) to (-1,2,3); (1,1,1) to (-1,1,1) to (0,3,4).
    if (got[0] != 1.0 || got[1] != 3.0 || got[2] != 3.0) { return 1 }
    if (got[4] != 0.0 - 1.0 || got[5] != 2.0 || got[6] != 3.0) { return 1 }
    if (got[8] != 0.0 || got[9] != 3.0 || got[10] != 4.0) { return 1 }
    // Move first, then turn: the matrix is turn times move, and (1,0,0) ends at (-2,2,3).
    let moveThenTurn: float[16]
    multiply4(turn.toI64().toPtr(), move.toI64().toPtr(), moveThenTurn.toI64().toPtr())
    let out2: i64 = metalEmptyBuffer(device, 48)
    metalDispatch(device, pipeline, 3, metalBuffer(device, pts.toI64(), 48), metalBuffer(device, moveThenTurn.toI64(), 64), out2, 0)
    let other: ptr<float> = metalContents(out2).toPtr()
    if (other[0] != 0.0 - 2.0 || other[1] != 2.0 || other[2] != 3.0) { return 1 }
    return 0
}
