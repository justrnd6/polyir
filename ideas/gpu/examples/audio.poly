// SOUND on the GPU (Metal) and out of the speakers (AudioQueue): synthesize sounds by adding
// sine waves, look at their frequencies with the Fourier transform, save them as WAV files,
// and (when asked) play them.
//
//   polyir --emit-msl audio.poly > audio.metal
//   polyir audio.poly --out audio && ./audio                  (Apple Silicon; run in this folder)
//   POLYIR_PLAY=1 ./audio                                      (also plays the chord and the melody)
//
// What it does, in order:
//   1. ANALYSIS (8,000 samples a second, 2,000 samples): a pure tone, a chord, two tones that
//      BEAT, a square wave (the sign of a sine) and the sine sums that build square, sawtooth
//      and triangle waves. The GPU's Fourier transform must find the frequencies that were put
//      in, with the right heights. Plots are saved as audio-*.pgm.
//   2. SOUND (44,100 samples a second): a C major chord and a short melody, written as
//      audio-chord.wav and audio-melody.wav, and played if POLYIR_PLAY is set.
//
// Exit 0 means every check passed. 10 no GPU, 11 the Metal source is missing, 12 a dispatch
// failed, 13 a frequency analysis disagreed with what was synthesized, 14 the GPU's melody
// differed from the CPU's, 15 playback failed.
import "../Metal.poly"
import "../../audio-output/Audio.poly"
import "shared/picture.poly"
import "shared/plot.poly"
import "shared/spectrum.poly"
import "shared/audio.poly"
import "../../audio/Sound.poly"

extern func getenv(name: string) -> i64

// ── running kernels ──────────────────────────────────────────────────────────
// One kernel over `count` samples with one array of settings; returns the samples.
func synthesize(device: i64, source: string, name: string, settings: ptr<float>, settingBytes: i64, count: i64) -> ptr<float> {
    let pipeline: i64 = metalPipeline(device, source, name)
    if (pipeline == 0) { return 0.toPtr() }
    let out: i64 = metalEmptyBuffer(device, count * 4)
    if (metalDispatch(device, pipeline, count, metalBuffer(device, settings.toI64(), settingBytes), out, 0, 0) == 0) { return 0.toPtr() }
    return metalContents(out).toPtr()
}

// The strength of each frequency of a signal of n samples, by the GPU's Fourier transform:
// bin k is the frequency k * rate / n.
func spectrumOf(device: i64, source: string, signal: ptr<float>, n: i64) -> ptr<float> {
    let pipeline: i64 = metalPipeline(device, source, "dft")
    if (pipeline == 0) { return 0.toPtr() }
    let size: ptr<float> = calloc(2, 4).toPtr()
    size[0] = n.toFloat()
    let out: i64 = metalEmptyBuffer(device, n * 4)
    if (metalDispatch(device, pipeline, n, metalBuffer(device, signal.toI64(), n * 4), metalBuffer(device, size.toI64(), 8), out, 0) == 0) { return 0.toPtr() }
    return metalContents(out).toPtr()
}

// ── settings for the synthesizer (see `synth` in shared/audio.poly) ─────────
func setSynth(p: ptr<float>, rate: float, partials: i64, total: float, attack: float, release: float, volume: float) -> i64 {
    p[0] = rate
    p[1] = partials.toFloat()
    p[2] = attack
    p[3] = release
    p[4] = total
    p[5] = 0.0
    p[6] = 0.0
    p[7] = volume
    return 0
}

func setPartial(p: ptr<float>, which: i64, frequency: float, amplitude: float) -> i64 {
    p[8 + 2 * which] = frequency
    p[9 + 2 * which] = amplitude
    return 0
}

func near(a: float, b: float, tolerance: float) -> i64 {
    var gap: float = a - b
    if (gap < 0.0) { gap = 0.0 - gap }
    if (gap <= tolerance) { return 1 }
    return 0
}

// Save a picture of the first `shown` samples of a signal and of the first `bins` bins of its spectrum.
func plotPair(nameA: string, nameB: string, signal: ptr<float>, shown: i64, spectrum: ptr<float>, bins: i64, signalHigh: float, spectrumHigh: float, continuous: i64) -> i64 {
    let pic: ptr<float> = calloc(320 * 96, 4).toPtr()
    if (continuous == 1) {
        drawWave(pic, 320, 96, signal, shown, 0.0 - signalHigh, signalHigh)
    } else {
        drawStems(pic, 320, 96, signal, shown, 0.0 - signalHigh, signalHigh)
    }
    savePicture(nameA, pic, 320, 96)
    drawStems(pic, 320, 96, spectrum, bins, 0.0, spectrumHigh)
    savePicture(nameB, pic, 320, 96)
    return 0
}

func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let source: string = metalReadFile("audio.metal")
    if (analysis(device, source) != 0) { return 13 }
    return sound(device, source)
}

// ── part 1: do the frequencies we put in come back out? ──────────────────────
// 2,000 samples at 8,000 per second last a quarter of a second, so frequency f makes f / 4
// whole cycles, and the transform's bin number for f is f / 4: 400 Hz is bin 100.
func analysis(device: i64, source: string) -> i64 {
    let n: i64 = 2000
    let p: ptr<float> = calloc(32, 4).toPtr()
    // A pure tone: 400 Hz, height 1. One spike, at bin 100, of height 1.
    setSynth(p, 8000.0, 1, 0.25, 0.0, 0.0, 1.0)
    setPartial(p, 0, 400.0, 1.0)
    let tone: ptr<float> = synthesize(device, source, "synth", p, 128, n)
    if (tone.toI64() == 0) { return 1 }
    let toneSpectrum: ptr<float> = spectrumOf(device, source, tone, n)
    if (near(toneSpectrum[100], 1.0, 0.02) == 0 || near(toneSpectrum[125], 0.0, 0.02) == 0) { return 1 }
    plotPair("audio-1-sine.pgm", "audio-1-sine-spectrum.pgm", tone, 100, toneSpectrum, 200, 1.3, 1.3, 0)
    // A chord: 400, 500 and 600 Hz (the ratios 4 : 5 : 6 of a major chord), heights 1, 0.8, 0.6.
    setSynth(p, 8000.0, 3, 0.25, 0.0, 0.0, 0.5)
    setPartial(p, 0, 400.0, 1.0)
    setPartial(p, 1, 500.0, 0.8)
    setPartial(p, 2, 600.0, 0.6)
    let chord: ptr<float> = synthesize(device, source, "synth", p, 128, n)
    if (chord.toI64() == 0) { return 1 }
    let chordSpectrum: ptr<float> = spectrumOf(device, source, chord, n)
    if (near(chordSpectrum[100], 0.5, 0.02) == 0 || near(chordSpectrum[125], 0.4, 0.02) == 0 || near(chordSpectrum[150], 0.3, 0.02) == 0) { return 1 }
    plotPair("audio-2-chord.pgm", "audio-2-chord-spectrum.pgm", chord, 320, chordSpectrum, 200, 1.0, 0.6, 1)
    // Beats: 400 Hz and 404 Hz together. The waves drift in and out of step, so the loudness
    // swells and fades 4 times a second (404 - 400): exactly one swell in this quarter second.
    setSynth(p, 8000.0, 2, 0.25, 0.0, 0.0, 1.0)
    setPartial(p, 0, 400.0, 1.0)
    setPartial(p, 1, 404.0, 1.0)
    let beats: ptr<float> = synthesize(device, source, "synth", p, 128, n)
    if (beats.toI64() == 0) { return 1 }
    let beatSpectrum: ptr<float> = spectrumOf(device, source, beats, n)
    if (near(beatSpectrum[100], 1.0, 0.03) == 0 || near(beatSpectrum[101], 1.0, 0.03) == 0) { return 1 }
    plotPair("audio-3-beats.pgm", "audio-3-beats-spectrum.pgm", beats, 2000, beatSpectrum, 200, 2.2, 1.3, 1)
    return squareAndSums(device, source)
}

// ── the sign of a sine, and building shapes by adding sines ──────────────────
func squareAndSums(device: i64, source: string) -> i64 {
    let n: i64 = 2000
    let p: ptr<float> = calloc(8, 4).toPtr()
    // sign(sin): 100 Hz is 25 cycles. A square wave contains only the ODD harmonics (1, 3, 5, ...)
    // of its frequency, with heights 4/pi, (4/pi)/3, (4/pi)/5 ... = 1.273, 0.424, 0.255 ...
    p[0] = 8000.0
    p[1] = 100.0
    let square: ptr<float> = synthesize(device, source, "squareWave", p, 32, n)
    if (square.toI64() == 0) { return 1 }
    let squareSpectrum: ptr<float> = spectrumOf(device, source, square, n)
    if (near(squareSpectrum[25], 1.2732, 0.05) == 0 || near(squareSpectrum[75], 0.4244, 0.05) == 0 || near(squareSpectrum[50], 0.0, 0.05) == 0) { return 1 }
    plotPair("audio-4-square.pgm", "audio-4-square-spectrum.pgm", square, 240, squareSpectrum, 200, 1.4, 1.4, 0)
    // The same wave, built by adding sines: 1, 3 and 9 harmonics (each shape is two periods of 200 samples).
    p[0] = 200.0
    p[1] = 0.0
    let pic: ptr<float> = calloc(320 * 96, 4).toPtr()
    p[2] = 1.0
    drawWave(pic, 320, 96, synthesize(device, source, "partialSum", p, 32, 400), 400, 0.0 - 1.5, 1.5)
    savePicture("audio-5-square-1.pgm", pic, 320, 96)
    p[2] = 3.0
    drawWave(pic, 320, 96, synthesize(device, source, "partialSum", p, 32, 400), 400, 0.0 - 1.5, 1.5)
    savePicture("audio-5-square-3.pgm", pic, 320, 96)
    p[2] = 9.0
    let nine: ptr<float> = synthesize(device, source, "partialSum", p, 32, 400)
    drawWave(pic, 320, 96, nine, 400, 0.0 - 1.5, 1.5)
    savePicture("audio-5-square-9.pgm", pic, 320, 96)
    // The square wave with 9 harmonics overshoots the flat top by about 9% of the jump (the
    // "Gibbs" overshoot): the highest sample should sit a little above 1.
    var highest: float = 0.0
    for (k = 0; k < 400; k = k + 1) {
        if (nine[k] > highest) { highest = nine[k] }
    }
    if (highest < 1.05 || highest > 1.25) { return 1 }
    // Sawtooth and triangle waves, 9 harmonics each.
    p[1] = 1.0
    drawWave(pic, 320, 96, synthesize(device, source, "partialSum", p, 32, 400), 400, 0.0 - 1.5, 1.5)
    savePicture("audio-6-sawtooth-9.pgm", pic, 320, 96)
    p[1] = 2.0
    drawWave(pic, 320, 96, synthesize(device, source, "partialSum", p, 32, 400), 400, 0.0 - 1.5, 1.5)
    savePicture("audio-6-triangle-9.pgm", pic, 320, 96)
    return 0
}

// ── part 2: real sounds ──────────────────────────────────────────────────────
func sound(device: i64, source: string) -> i64 {
    let rate: i64 = 44100
    // A C major chord, in equal temperament: the keys with MIDI numbers 60, 64 and 67 (C4, E4, G4),
    // their frequencies from the Wave library's noteFrequency, a second and a half long.
    let seconds: i64 = 1
    let p: ptr<float> = calloc(32, 4).toPtr()
    setSynth(p, 44100.0, 3, 1.5, 0.03, 0.4, 0.25)
    setPartial(p, 0, noteFrequency(60.0), 1.0)
    setPartial(p, 1, noteFrequency(64.0), 1.0)
    setPartial(p, 2, noteFrequency(67.0), 1.0)
    let chordCount: i64 = 66150
    let chord: ptr<float> = synthesize(device, source, "synth", p, 128, chordCount)
    if (chord.toI64() == 0) { return 12 }
    let chordSound: Sound = Sound(samples: chord, count: chordCount, rate: rate, channels: 1)
    chordSound.saveWav("audio-chord.wav")
    // A melody: the C major scale, then the chord held. Three numbers per note: start, length, frequency.
    let notes: ptr<float> = calloc(48, 4).toPtr()
    writeMelody(notes)
    let melodySettings: ptr<float> = calloc(4, 4).toPtr()
    melodySettings[0] = 44100.0
    melodySettings[1] = 12.0
    melodySettings[2] = 0.12
    let melodyCount: i64 = 149940
    let tune: ptr<float> = playableMelody(device, source, notes, melodySettings, melodyCount)
    if (tune.toI64() == 0) { return 12 }
    // The GPU's melody must equal the CPU's, sample by sample (to within rounding).
    for (i = 0; i < melodyCount; i = i + 997) {
        if (near(tune[i], melody(i, notes, melodySettings), 0.01) == 0) { return 14 }
    }
    let tuneSound: Sound = Sound(samples: tune, count: melodyCount, rate: rate, channels: 1)
    tuneSound.saveWav("audio-melody.wav")
    let shape: ptr<float> = calloc(320 * 96, 4).toPtr()
    drawWave(shape, 320, 96, tune, melodyCount, 0.0 - 1.6, 1.6)
    savePicture("audio-7-melody.pgm", shape, 320, 96)
    // Only make noise when asked.
    if (getenv("POLYIR_PLAY") != 0) {
        if (soundPlay(chordSound) != 0) { return 15 }
        if (soundPlay(tuneSound) != 0) { return 15 }
    }
    return 0
}

func playableMelody(device: i64, source: string, notes: ptr<float>, settings: ptr<float>, count: i64) -> ptr<float> {
    let pipeline: i64 = metalPipeline(device, source, "melody")
    if (pipeline == 0) { return 0.toPtr() }
    let out: i64 = metalEmptyBuffer(device, count * 4)
    if (metalDispatch(device, pipeline, count, metalBuffer(device, notes.toI64(), 192), metalBuffer(device, settings.toI64(), 16), out, 0) == 0) { return 0.toPtr() }
    return metalContents(out).toPtr()
}

// The eight notes of the C major scale (MIDI keys 60, 62, 64, 65, 67, 69, 71, 72), 0.3 seconds
// each, then C, E, G and C an octave up as a chord. Frequencies from the Wave library.
func writeMelody(notes: ptr<float>) -> i64 {
    let keys: float[8]
    keys[0] = 60.0
    keys[1] = 62.0
    keys[2] = 64.0
    keys[3] = 65.0
    keys[4] = 67.0
    keys[5] = 69.0
    keys[6] = 71.0
    keys[7] = 72.0
    for (k = 0; k < 8; k = k + 1) {
        notes[3 * k] = k.toFloat() * 0.3
        notes[3 * k + 1] = 0.3
        notes[3 * k + 2] = noteFrequency(keys[k])
    }
    let chord: float[4]
    chord[0] = 60.0
    chord[1] = 64.0
    chord[2] = 67.0
    chord[3] = 72.0
    for (k = 0; k < 4; k = k + 1) {
        notes[24 + 3 * k] = 2.4
        notes[25 + 3 * k] = 1.0
        notes[26 + 3 * k] = noteFrequency(chord[k])
    }
    return 0
}
