// SPLITTING ONE JOB ACROSS SEVERAL GPUs (Vulkan). A "worker" here is a Vulkan context with its own device, its own queue and
// its own memory. The job is cut into parts, one part for each worker; the parts are started one after another WITHOUT waiting
// for the earlier ones (so the workers can run at the same time), and only then does the program wait for all of them. The
// separate memories are the point: the workers cannot see each other's data, so anything one part needs from another (the
// boundary rows of the Game of Life) has to be carried across by the CPU.
//
// How many workers? If the computer has several GPUs, one worker for each (up to 4). If it has just one GPU, the program makes
// TWO independent logical devices on it and says so: they behave like two GPUs with separate memory, so the splitting code is
// exercised for real, but of course there is no extra hardware to speed anything up.
//
// Two jobs are split, from shared/classics.poly (chapter 26):
//   Monte Carlo pi    needs no communication: each worker does a block of the threads; the parts must add up to the whole.
//   Game of Life      needs a boundary exchange: each worker owns a strip of rows and gets a copy of its neighbours' edge rows
//                     every generation; the stitched board must equal the whole board's, every generation.
//
//   polyir --emit-glsl multigpu-vulkan.poly       (one shader per kernel; tests/gpu.sh splits and compiles them)
//   polyir multigpu-vulkan.poly --out multigpu-vulkan && ./multigpu-vulkan    (run in this folder)
//
// Exit 0 means every part matched the whole. 10 no Vulkan GPU, 11 a shader is missing, 12 a launch failed, 13 the split result
// differs from the whole. Only one physical GPU was available when this was written, so the several-GPU case has not been run.
import "../Vulkan.poly"
import "shared/print.poly"
import "shared/classics.poly"

// ---- the two functions shared/classics.poly expects (this program uses its helpers, not its demonstrations) ----

func makePipeline(ctx: i64, source: string, name: string) -> i64 {
    return vulkanPipeline(ctx, name + ".spv", 4, 4)
}

func launch(ctx: i64, pipeline: i64, a: ptr<float>, aCount: i64, b: ptr<float>, bCount: i64, opts: ptr<float>, outCount: i64) -> ptr<float> {
    let results: ptr<float> = launchStart(ctx, pipeline, a, aCount, b, bCount, opts, outCount)
    vulkanFinish(ctx)
    return results
}

// ---- starting a launch without waiting ----

// Submits the job and returns at once. The returned pointer holds the results only AFTER vulkanFinish(ctx) has returned.
func launchStart(ctx: i64, pipeline: i64, a: ptr<float>, aCount: i64, b: ptr<float>, bCount: i64, opts: ptr<float>, outCount: i64) -> ptr<float> {
    let push: i64 = words(2)
    let slots: ptr<i32> = push.toPtr()
    slots[0] = outCount.toI32()
    let buffers: ptr<i64> = calloc(4, 8).toPtr()
    buffers[0] = vulkanBuffer(ctx, a.toI64(), aCount * 4)
    buffers[1] = vulkanBuffer(ctx, b.toI64(), bCount * 4)
    buffers[2] = vulkanBuffer(ctx, opts.toI64(), 16)
    buffers[3] = vulkanEmptyBuffer(ctx, outCount * 4)
    if (vulkanDispatchBuffersAsync(ctx, pipeline, outCount, push, buffers, 4) == 0) { return calloc(outCount, 4).toPtr() }
    return vulkanContents(buffers[3]).toPtr()
}

// ---- the workers ----

// Starts the workers and returns how many there are (their contexts are put in `workers`).
func startWorkers(instance: i64, workers: ptr<i64>) -> i64 {
    let gpus: i64 = vulkanGpuCount(instance)
    var count: i64 = gpus
    if (count > 4) { count = 4 }
    if (gpus < 2) { count = 2 }
    for (w = 0; w < count; w = w + 1) {
        var which: i64 = w
        if (gpus < 2) { which = 0 }
        workers[w] = vulkanStartOn(instance, which)
        if (workers[w] == 0) { return 0 }
    }
    say("GPUs found: ")
    sayNumber(gpus)
    say(" (")
    say(vulkanGpuName(workers[0]))
    say(")")
    newline()
    say("workers: ")
    sayNumber(count)
    if (gpus < 2) {
        say("  (only one GPU, so these are separate logical devices on it: separate queues and memory, shared hardware)")
    } else {
        say("  (one for each GPU)")
    }
    newline()
    return count
}

// The same kernel built once for every worker (a pipeline belongs to the device that made it).
func pipelinesFor(workers: ptr<i64>, count: i64, name: string) -> ptr<i64> {
    let pipes: ptr<i64> = calloc(count, 8).toPtr()
    for (w = 0; w < count; w = w + 1) {
        pipes[w] = makePipeline(workers[w], "", name)
    }
    return pipes
}

func allBuilt(pipes: ptr<i64>, count: i64) -> i64 {
    for (w = 0; w < count; w = w + 1) {
        if (pipes[w] == 0) { return 0 }
    }
    return 1
}

func finishAll(workers: ptr<i64>, count: i64) -> i64 {
    for (w = 0; w < count; w = w + 1) {
        if (vulkanFinish(workers[w]) == 0) { return 0 }
    }
    return 1
}

// ---- job 1: Monte Carlo, no communication ----

// 65,536 threads of 2,048 darts each, on one worker, then split into equal blocks, one block for each worker, started together.
func splitMonteCarlo(workers: ptr<i64>, count: i64) -> i64 {
    let pipes: ptr<i64> = pipelinesFor(workers, count, "hits")
    if (allBuilt(pipes, count) == 0) { return 11 }
    let threads: i64 = 65536
    let each: i64 = threads / count
    var mark: i64 = wallMs()
    let whole: ptr<float> = launch(workers[0], pipes[0], spare(), 1, spare(), 1, settings(2048.0, 0.0, 0.0), threads)
    let wholeMs: i64 = wallMs() - mark
    mark = wallMs()
    let parts: ptr<i64> = calloc(count, 8).toPtr()
    for (w = 0; w < count; w = w + 1) {
        parts[w] = launchStart(workers[w], pipes[w], spare(), 1, spare(), 1, settings(2048.0, (w * each).toFloat(), 0.0), each).toI64()
    }
    if (finishAll(workers, count) == 0) { return 12 }
    let splitMs: i64 = wallMs() - mark
    for (w = 0; w < count; w = w + 1) {
        let piece: ptr<float> = parts[w].toPtr()
        for (t = 0; t < each; t = t + 1) {
            if (near(piece[t], whole[w * each + t], 0.0) == 0) { return 13 }
        }
    }
    say("Monte Carlo, 65,536 threads x 2,048 darts: one worker ")
    sayNumber(wholeMs)
    say(" ms, split over ")
    sayNumber(count)
    say(" workers ")
    sayNumber(splitMs)
    say(" ms; every thread's count equals the single worker's")
    newline()
    return 0
}

// ---- job 2: Game of Life, boundary rows carried between the workers ----

// One generation on a board `n` rows by `n` columns, as `count` strips (one for each worker). Strip s owns rows s*h .. s*h+h-1
// and is given the row above and the row below (copies, taken from its neighbours) so it can compute its edges.
func lifeInStrips(workers: ptr<i64>, pipes: ptr<i64>, count: i64, board: ptr<float>, n: i64) -> ptr<float> {
    let h: i64 = n / count
    let blocks: ptr<i64> = calloc(count, 8).toPtr()
    let outs: ptr<i64> = calloc(count, 8).toPtr()
    let opts: ptr<float> = settings(n.toFloat(), (h + 2).toFloat(), 0.0)
    for (s = 0; s < count; s = s + 1) {
        let block: ptr<float> = calloc((h + 2) * n, 4).toPtr()
        copyRows(board, (s * h + n - 1) % n, block, 0, n, 1)
        copyRows(board, s * h, block, 1, n, h)
        copyRows(board, ((s + 1) * h) % n, block, h + 1, n, 1)
        blocks[s] = block.toI64()
        outs[s] = launchStart(workers[s], pipes[s], block, (h + 2) * n, spare(), 1, opts, (h + 2) * n).toI64()
    }
    finishAll(workers, count)
    let next: ptr<float> = calloc(n * n, 4).toPtr()
    for (s = 0; s < count; s = s + 1) {
        copyRows(outs[s].toPtr(), 1, next, s * h, n, h)
    }
    return next
}

// The Life board on one worker and as strips over all the workers, for 20 generations; they must agree every generation.
func splitLife(workers: ptr<i64>, count: i64) -> i64 {
    let pipes: ptr<i64> = pipelinesFor(workers, count, "lifeStep")
    if (allBuilt(pipes, count) == 0) { return 11 }
    let n: i64 = 64
    var whole: ptr<float> = calloc(n * n, 4).toPtr()
    for (p = 0; p < n * n; p = p + 1) {
        if (pseudo(p + 7, 100) < 35) { whole[p] = 1.0 }
    }
    var strips: ptr<float> = whole
    let opts: ptr<float> = settings(n.toFloat(), n.toFloat(), 0.0)
    for (g = 0; g < 20; g = g + 1) {
        whole = launch(workers[0], pipes[0], whole, n * n, spare(), 1, opts, n * n)
        strips = lifeInStrips(workers, pipes, count, strips, n)
        if (sameNumbers(whole, strips, n * n, 0.0) == 0) { return 13 }
    }
    say("Game of Life, 64 x 64 for 20 generations as ")
    sayNumber(count)
    say(" strips: the stitched board equals the whole board every generation")
    newline()
    say("    each generation the CPU carried ")
    sayNumber(count * 2)
    say(" boundary rows between the workers' separate memories")
    newline()
    return 0
}

func main() -> i64 {
    let instance: i64 = vulkanInstance()
    if (instance == 0) { return 10 }
    if (vulkanGpuCount(instance) == 0) { return 10 }
    let workers: ptr<i64> = calloc(4, 8).toPtr()
    let count: i64 = startWorkers(instance, workers)
    if (count == 0) { return 10 }
    var code: i64 = splitMonteCarlo(workers, count)
    if (code != 0) { return code }
    code = splitLife(workers, count)
    return code
}
