// A DOOM-STYLE VIEW on the GPU (Metal): the "2.5D" camera of 1990s shooters.
// The world is a flat map seen from above; the player is a position (x, y) and ONE
// angle. Every screen column shoots one ray across the map until it hits a wall,
// and the wall's distance decides how tall that column of wall is drawn.
//
//   polyir --emit-msl raycaster.poly > raycaster.metal
//   polyir raycaster.poly --out raycaster && ./raycaster      (Apple Silicon; run in this folder)
//
// Three pictures are saved (doom-1, doom-2, doom-3.pgm) and checked against the CPU
// running the same kernel. Exit 0 means they match; 10 no GPU, 11 the Metal source
// is missing, 12 dispatch failed, 13 a picture differs from the CPU's.
import "../Metal.poly"
import "shared/picture.poly"

extern func sinf(x: float) -> float
extern func cosf(x: float) -> float
extern func fabsf(x: float) -> float

// view:  0 player x   1 player y   2 the angle the player faces (radians)
//        3 tan(half the field of view)   4 picture width   5 picture height
//        6 map width   7 map height      8 vertical shift (the "look up/down" trick)
// map:   one number per square, row after row: 1 = wall, 0 = empty floor
//
// Per pixel: find its column, build that column's ray, walk the ray from square to
// square across the map (the "DDA" walk) until it enters a wall square, then work out
// whether this pixel's row is wall, ceiling or floor.
kernel func castView(index i: i32, uniform view: ptr<float>, uniform cells: ptr<float>) -> float {
    let w: i32 = view[4].toI32()
    let mapW: i32 = view[6].toI32()
    let row: float = (i / w).toFloat() - view[8]
    // The camera plane: column 0 is the left edge (-1), the last column the right edge (+1).
    let across: float = 2.0 * (i % w).toFloat() / view[4] - 1.0
    let dirX: float = cosf(view[2])
    let dirY: float = sinf(view[2])
    let rayX: float = dirX - dirY * view[3] * across
    let rayY: float = dirY + dirX * view[3] * across
    // How far the ray travels to cross one whole square sideways, and the first crossing.
    var squareX: i32 = view[0].toI32()
    var squareY: i32 = view[1].toI32()
    var deltaX: float = 1000000.0
    var deltaY: float = 1000000.0
    if (fabsf(rayX) > 0.000001) { deltaX = fabsf(1.0 / rayX) }
    if (fabsf(rayY) > 0.000001) { deltaY = fabsf(1.0 / rayY) }
    var stepX: i32 = 1
    var nextX: float = (squareX.toFloat() + 1.0 - view[0]) * deltaX
    if (rayX < 0.0) {
        stepX = 0 - 1
        nextX = (view[0] - squareX.toFloat()) * deltaX
    }
    var stepY: i32 = 1
    var nextY: float = (squareY.toFloat() + 1.0 - view[1]) * deltaY
    if (rayY < 0.0) {
        stepY = 0 - 1
        nextY = (view[1] - squareY.toFloat()) * deltaY
    }
    // Walk: always step across whichever square edge is nearer. Stop (hit) at a wall.
    var hit: i32 = 0
    var sideways: i32 = 0
    for (n = 0; n < 48; n = n + 1) {
        if (hit == 0) {
            if (nextX < nextY) {
                nextX = nextX + deltaX
                squareX = squareX + stepX
                sideways = 0
            } else {
                nextY = nextY + deltaY
                squareY = squareY + stepY
                sideways = 1
            }
            if (cells[squareY * mapW + squareX] > 0.5) { hit = 1 }
        }
    }
    // Distance measured ALONG THE VIEW DIRECTION (not along the ray), so straight walls stay straight.
    var distance: float = nextX - deltaX
    if (sideways == 1) { distance = nextY - deltaY }
    let wallHeight: float = view[5] / distance
    let top: float = view[5] * 0.5 - wallHeight * 0.5
    if (row >= top && row <= top + wallHeight) {
        var shade: float = 1.0 / (1.0 + distance * 0.35)
        if (sideways == 1) { shade = shade * 0.6 }
        return shade
    }
    if (row < top) { return 0.05 }
    return 0.12 + 0.3 * (row - view[5] * 0.5) / (view[5] * 0.5)
}

// A 12 x 12 map: a wall all round, a pillar, and a short wall.
func buildMap(cells: ptr<float>) -> i64 {
    for (y = 0; y < 12; y = y + 1) {
        for (x = 0; x < 12; x = x + 1) {
            var cell: float = 0.0
            if (x == 0 || y == 0 || x == 11 || y == 11) { cell = 1.0 }
            if (x == 6 && y == 6) { cell = 1.0 }
            if (y == 8 && x >= 2 && x <= 4) { cell = 1.0 }
            cells[y * 12 + x] = cell
        }
    }
    return 0
}

func setView(view: ptr<float>, x: float, y: float, angle: float, shift: float) -> i64 {
    view[0] = x
    view[1] = y
    view[2] = angle
    view[3] = 0.9
    view[4] = 320.0
    view[5] = 200.0
    view[6] = 12.0
    view[7] = 12.0
    view[8] = shift
    return 0
}

func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let pipeline: i64 = metalPipeline(device, metalReadFile("raycaster.metal"), "castView")
    if (pipeline == 0) { return 11 }
    let cells: ptr<float> = calloc(144, 4).toPtr()
    buildMap(cells)
    let view: ptr<float> = calloc(9, 4).toPtr()
    // 1: looking along the map. 2: the same spot, turned. 3: as 1, but "looked up" (the picture slid down 40 rows).
    setView(view, 2.5, 2.5, 0.7, 0.0)
    if (render(device, pipeline, view, cells, "doom-1.pgm") != 0) { return 13 }
    setView(view, 2.5, 2.5, 2.2, 0.0)
    if (render(device, pipeline, view, cells, "doom-2.pgm") != 0) { return 13 }
    setView(view, 2.5, 2.5, 0.7, 40.0)
    return render(device, pipeline, view, cells, "doom-3.pgm")
}

// Draw on the GPU, save, then compare every pixel with the CPU running the same kernel.
func render(device: i64, pipeline: i64, view: ptr<float>, cells: ptr<float>, name: string) -> i64 {
    let n: i64 = 320 * 200
    let out: i64 = metalEmptyBuffer(device, n * 4)
    let ok: i64 = metalDispatch(device, pipeline, n, metalBuffer(device, view.toI64(), 36), metalBuffer(device, cells.toI64(), 576), out, 0)
    if (ok == 0) { return 1 }
    let gpu: ptr<float> = metalContents(out).toPtr()
    savePicture(name, gpu, 320, 200)
    var differ: i64 = 0
    for (i = 0; i < n; i = i + 1) {
        var gap: float = gpu[i] - castView(i, view, cells)
        if (gap < 0.0) { gap = 0.0 - gap }
        if (gap > 0.01) { differ = differ + 1 }
    }
    if (differ > 60) { return 1 }
    return 0
}
