// KERNELS THAT WRITE ARRAYS on the GPU (Metal): scatter, a histogram of a million values
// (with and without the atomic), and a galaxy of 400,000 points splatted into a picture.
//
//   polyir --emit-msl scatter.poly > scatter.metal
//   polyir scatter.poly --out scatter && ./scatter        (Apple Silicon; run in this folder)
//
// Saves splat.pgm. Exit 0 means the GPU arrays equal what the CPU produced with the same
// kernels (the splat grid may differ in a few cells: the GPU rounds sin and cos slightly differently). 10 no GPU, 11 the Metal source is missing, 12 a dispatch failed, 13 reverseCopy
// differs, 14 the histogram differs, 15 the splat differs, 16 the unprotected one-bin
// histogram lost no updates at all, or counted too many (it should lose most of them).
import "../Metal.poly"
import "shared/picture.poly"
import "shared/scatter.poly"

extern func logf(x: float) -> float

func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let source: string = metalReadFile("scatter.metal")
    if (checkReverse(device, source) != 0) { return 13 }
    if (checkHistogram(device, source) != 0) { return 14 }
    if (checkSplat(device, source) != 0) { return 15 }
    if (checkRace(device, source) != 0) { return 16 }
    return 0
}

// Run a kernel over n threads with: a read-only array, one number, a WRITABLE array and
// the (unused) result buffer. Returns the writable array's contents, or 0 if it failed.
func runWriter(device: i64, source: string, name: string, readOnly: i64, readBytes: i64, number: i32, writeBytes: i64, n: i64) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, name)
    if (pipeline == 0) { return 0 }
    let one: i32[1]
    one[0] = number
    let written: i64 = metalEmptyBuffer(device, writeBytes)
    let result: i64 = metalEmptyBuffer(device, n * 4)
    if (metalDispatch(device, pipeline, n, metalBuffer(device, readOnly, readBytes), metalBuffer(device, one.toI64(), 4), written, result) == 0) { return 0 }
    return metalContents(written)
}

func checkReverse(device: i64, source: string) -> i64 {
    let n: i64 = 1000
    let src: ptr<float> = calloc(n, 4).toPtr()
    for (i = 0; i < n; i = i + 1) {
        src[i] = i.toFloat() * 0.5
    }
    let gpu: ptr<float> = runWriter(device, source, "reverseCopy", src.toI64(), n * 4, n.toI32(), n * 4, n).toPtr()
    for (i = 0; i < n; i = i + 1) {
        if (gpu[i] != src[n - 1 - i]) { return 1 }
    }
    return 0
}

func checkHistogram(device: i64, source: string) -> i64 {
    let n: i64 = 1000000
    let bins: i64 = 16
    let data: ptr<i32> = calloc(n, 4).toPtr()
    for (i = 0; i < n; i = i + 1) {
        data[i] = ((i * 37 + 11) % 1000).toI32()
    }
    let cpu: ptr<i32> = calloc(bins, 4).toPtr()
    for (i = 0; i < n; i = i + 1) {
        histogram(i, data, bins.toI32(), cpu)
    }
    let gpu: ptr<i32> = runWriter(device, source, "histogram", data.toI64(), n * 4, bins.toI32(), bins * 4, n).toPtr()
    for (b = 0; b < bins; b = b + 1) {
        if (gpu[b] != cpu[b]) { return 1 }
    }
    return 0
}

// The same job with plain adds, in the worst case for it: ONE bin, so every thread adds to
// the same slot. Each thread reads the old count, adds 1 and writes it back, and the threads
// running at the same time overwrite each other: most updates are lost. (On a CPU with one
// thread this would count to exactly n.)
func checkRace(device: i64, source: string) -> i64 {
    let n: i64 = 1000000
    let data: ptr<i32> = calloc(n, 4).toPtr()
    let racy: ptr<i32> = runWriter(device, source, "histogramRacy", data.toI64(), n * 4, 1, 4, n).toPtr()
    let total: i64 = racy[0].toI64()
    if (total > n) { return 1 }
    // At least one update must have been lost, or the test shows nothing.
    if (total == n) { return 1 }
    return 0
}

func checkSplat(device: i64, source: string) -> i64 {
    let w: i64 = 256
    let n: i64 = 400000
    let p: ptr<float> = calloc(2, 4).toPtr()
    p[0] = w.toFloat()
    let pipeline: i64 = metalPipeline(device, source, "splat")
    if (pipeline == 0) { return 1 }
    let cells: i64 = metalEmptyBuffer(device, w * w * 4)
    let result: i64 = metalEmptyBuffer(device, n * 4)
    if (metalDispatch(device, pipeline, n, metalBuffer(device, p.toI64(), 8), cells, result, 0) == 0) { return 1 }
    let gpu: ptr<i32> = metalContents(cells).toPtr()
    let cpu: ptr<i32> = calloc(w * w, 4).toPtr()
    for (i = 0; i < n; i = i + 1) {
        splat(i, p, cpu)
    }
    // The counts are whole numbers added atomically, so no update is lost. But the GPU's sine
    // and cosine round the last bit differently from the CPU's, which moves a handful of
    // points across a cell edge: allow a few cells to differ.
    var biggest: i32 = 1
    var differ: i64 = 0
    for (c = 0; c < w * w; c = c + 1) {
        if (gpu[c] != cpu[c]) { differ = differ + 1 }
        if (gpu[c] > biggest) { biggest = gpu[c] }
    }
    if (differ > 200) { return 1 }
    savePicture("splat.pgm", brightness(gpu, w * w, biggest), w, w)
    return 0
}

// Count to a 0..1 brightness; the logarithm keeps the thin outer arms visible next to the
// dense centre.
func brightness(counts: ptr<i32>, n: i64, biggest: i32) -> ptr<float> {
    let out: ptr<float> = calloc(n, 4).toPtr()
    let scale: float = 1.0 / logf(1.0 + biggest.toFloat())
    for (c = 0; c < n; c = c + 1) {
        out[c] = logf(1.0 + counts[c].toFloat()) * scale
    }
    return out
}
