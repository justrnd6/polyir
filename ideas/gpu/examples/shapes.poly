// KERNEL SHAPES on the GPU (Metal): nine buffers in one launch, a grid of threads (a plasma picture and a
// vignette made from it), and the atomics `atomicAddFloat`, `atomicMin` and `atomicMax`.
//
//   polyir --emit-msl shapes.poly > shapes.metal
//   polyir shapes.poly --out shapes && ./shapes        (Apple Silicon; run in this folder)
//
// Saves shapes-plasma.pgm and shapes-vignette.pgm. Exit 0 means every GPU answer equals the CPU's running
// the same kernels (the pictures to a small tolerance: the GPU's sine rounds differently). 10 no GPU, 11 the
// Metal source is missing, 12 a dispatch failed, 13 nine buffers, 14 the grid, 15 the atomics are wrong.
import "../Metal.poly"
import "shared/picture.poly"
import "shared/shapes.poly"

func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let source: string = metalReadFile("shapes.metal")
    var code: i64 = checkManyBuffers(device, source)
    if (code == 0) { code = checkGrid(device, source) }
    if (code == 0) { code = checkAtomics(device, source) }
    return code
}

// The GPU computes blend7 for 100,000 elements with NINE buffers: seven inputs, k, and the result.
func checkManyBuffers(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "blend7")
    if (pipeline == 0) { return 12 }
    let n: i64 = 100000
    let inputs: ptr<i64> = makeInputs(7, n)
    let buffers: ptr<i64> = calloc(9, 8).toPtr()
    for (k = 0; k < 7; k = k + 1) { buffers[k] = metalBuffer(device, inputs[k], n * 4) }
    let scale: float[1]
    scale[0] = 1.5
    buffers[7] = metalBuffer(device, scale.toI64(), 4)
    buffers[8] = metalEmptyBuffer(device, n * 4)
    if (metalDispatchBuffers(device, pipeline, n, buffers, 9) == 0) { return 12 }
    return blendMatches(inputs, metalContents(buffers[8]).toPtr(), n)
}

// `count` arrays of `n` floats; the address of each is kept in an array of addresses.
func makeInputs(count: i64, n: i64) -> ptr<i64> {
    let inputs: ptr<i64> = calloc(count, 8).toPtr()
    for (k = 0; k < count; k = k + 1) {
        let data: ptr<float> = calloc(n, 4).toPtr()
        for (i = 0; i < n; i = i + 1) { data[i] = (i % (k + 3)).toFloat() * 0.25 }
        inputs[k] = data.toI64()
    }
    return inputs
}

func blendMatches(inputs: ptr<i64>, got: ptr<float>, n: i64) -> i64 {
    for (i = 0; i < n; i = i + 1) {
        if (nearly(got[i], blendAt(inputs, i), 0.0001) == 0) { return 13 }
    }
    return 0
}

// The CPU's blend7 of element i of the seven arrays.
func blendAt(inputs: ptr<i64>, i: i64) -> float {
    let a: ptr<float> = inputs[0].toPtr()
    let b: ptr<float> = inputs[1].toPtr()
    let c: ptr<float> = inputs[2].toPtr()
    let d: ptr<float> = inputs[3].toPtr()
    let e: ptr<float> = inputs[4].toPtr()
    let f: ptr<float> = inputs[5].toPtr()
    let g: ptr<float> = inputs[6].toPtr()
    return blend7(a[i], b[i], c[i], d[i], e[i], f[i], g[i], 1.5)
}

// A 320 x 200 plasma from a grid launch, then a vignette made from it (a grid kernel with an element input).
func checkGrid(device: i64, source: string) -> i64 {
    let width: i64 = 320
    let height: i64 = 200
    let pipeline: i64 = metalPipeline(device, source, "plasma")
    if (pipeline == 0) { return 12 }
    let size: i32[2]
    size[0] = width.toI32()
    size[1] = height.toI32()
    let phase: float[1]
    phase[0] = 0.7
    let image: i64 = metalEmptyBuffer(device, width * height * 4)
    let args: ptr<i64> = calloc(4, 8).toPtr()
    args[0] = metalBuffer(device, size.toI64(), 4)
    args[1] = metalBuffer(device, size.toI64() + 4, 4)
    args[2] = metalBuffer(device, phase.toI64(), 4)
    args[3] = image
    if (metalDispatch2D(device, pipeline, width, height, args, 4) == 0) { return 12 }
    if (plasmaMatches(metalContents(image).toPtr(), width, height) == 0) { return 14 }
    savePicture("shapes-plasma.pgm", metalContents(image).toPtr(), width, height)
    return checkVignette(device, source, image, width, height)
}

func plasmaMatches(pic: ptr<float>, width: i64, height: i64) -> i64 {
    for (y = 0; y < height; y = y + 1) {
        for (x = 0; x < width; x = x + 1) {
            let want: float = plasma(x.toI32(), y.toI32(), width.toI32(), height.toI32(), 0.7)
            if (nearly(pic[y * width + x], want, 0.001) == 0) { return 0 }
        }
    }
    return 1
}

func checkVignette(device: i64, source: string, image: i64, width: i64, height: i64) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "vignette")
    if (pipeline == 0) { return 12 }
    let size: i32[2]
    size[0] = width.toI32()
    size[1] = height.toI32()
    let out: i64 = metalEmptyBuffer(device, width * height * 4)
    let args: ptr<i64> = calloc(4, 8).toPtr()
    args[0] = image
    args[1] = metalBuffer(device, size.toI64(), 4)
    args[2] = metalBuffer(device, size.toI64() + 4, 4)
    args[3] = out
    if (metalDispatch2D(device, pipeline, width, height, args, 4) == 0) { return 12 }
    if (vignetteMatches(metalContents(image).toPtr(), metalContents(out).toPtr(), width, height) == 0) { return 14 }
    savePicture("shapes-vignette.pgm", metalContents(out).toPtr(), width, height)
    return 0
}

func vignetteMatches(source: ptr<float>, pic: ptr<float>, width: i64, height: i64) -> i64 {
    for (y = 0; y < height; y = y + 1) {
        for (x = 0; x < width; x = x + 1) {
            let want: float = vignette(source[y * width + x], x.toI32(), y.toI32(), width.toI32(), height.toI32())
            if (nearly(pic[y * width + x], want, 0.0005) == 0) { return 0 }
        }
    }
    return 1
}

// A million threads report to the shared tallies. The whole-number counts and the float totals are exact (every
// thread adds 1 or 0.5 and the sums stay below 2^24, so float addition loses nothing), whatever order the
// threads run in. The smallest and largest reported values are found without a race.
func checkAtomics(device: i64, source: string) -> i64 {
    let pipeline: i64 = metalPipeline(device, source, "tally")
    if (pipeline == 0) { return 12 }
    let n: i64 = 1000000
    let counts: i32[4]
    let sums: float[4]
    let lows: i32[1]
    let highs: i32[1]
    for (b = 0; b < 4; b = b + 1) {
        counts[b] = 0
        sums[b] = 0.0
    }
    lows[0] = 2147483647
    highs[0] = 0 - 1
    let buffers: ptr<i64> = calloc(5, 8).toPtr()
    buffers[0] = metalBuffer(device, counts.toI64(), 16)
    buffers[1] = metalBuffer(device, sums.toI64(), 16)
    buffers[2] = metalBuffer(device, lows.toI64(), 4)
    buffers[3] = metalBuffer(device, highs.toI64(), 4)
    buffers[4] = metalEmptyBuffer(device, n * 4)
    if (metalDispatchBuffers(device, pipeline, n, buffers, 5) == 0) { return 12 }
    return compareTallies(buffers, n)
}

// The CPU's smallest and largest reported value over the same million threads.
func compareTallies(buffers: ptr<i64>, n: i64) -> i64 {
    let counts: ptr<i32> = metalContents(buffers[0]).toPtr()
    let sums: ptr<float> = metalContents(buffers[1]).toPtr()
    let lows: ptr<i32> = metalContents(buffers[2]).toPtr()
    let highs: ptr<i32> = metalContents(buffers[3]).toPtr()
    var low: i32 = 2147483647
    var high: i32 = 0 - 1
    for (i = 0; i < n; i = i + 1) {
        let value: i32 = reported(i.toI32())
        if (value < low) { low = value }
        if (value > high) { high = value }
    }
    for (b = 0; b < 4; b = b + 1) {
        if (counts[b].toI64() != n / 4) { return 15 }
        if (sums[b] != (n / 4).toFloat() * 0.5) { return 15 }
    }
    if (lows[0] != low || highs[0] != high) { return 15 }
    return 0
}
