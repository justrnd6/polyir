// The kernels and checks shared by colour.poly (Metal) and colour-vulkan.poly (Vulkan): colour as a signal.
// Once a picture is split into brightness (Y) and two colour numbers (I, Q), every colour edit is ordinary
// signal processing on those three channels:
//
//   luma, hueOnly    VIEW the channels apart: brightness alone, then colour alone (at constant brightness)
//   rotateHue        a hue change is a ROTATION of (I, Q)
//   scaleColour      a saturation change is a SCALING of (I, Q); 0 leaves a grey picture
//   chromaBlur       low-pass filter ONLY the colour: the picture still looks sharp
//   lumaBlur         low-pass filter ONLY the brightness: the picture turns to mush
//   sharpenLuma      sharpen ONLY the brightness: no coloured halos
//
// (The helper kernels `lumaAt`, `inphaseAt`, `quadAt`, `toRgb` and `neighbour` take their array under the same name
// as the kernels that call them, `src` and `opts`: Vulkan has no pointers, so a kernel can only call a kernel that
// reads an array when the two use the same name for it.)
// The importing file needs picture.poly (saveColorPicture, savePicture, calloc).


// The three channels of one pixel `p`.
kernel func lumaAt(uniform src: ptr<float>, p: i32) -> float {
    return 0.299 * src[p * 4] + 0.587 * src[p * 4 + 1] + 0.114 * src[p * 4 + 2]
}

kernel func inphaseAt(uniform src: ptr<float>, p: i32) -> float {
    return 0.596 * src[p * 4] - 0.274 * src[p * 4 + 1] - 0.322 * src[p * 4 + 2]
}

kernel func quadAt(uniform src: ptr<float>, p: i32) -> float {
    return 0.211 * src[p * 4] - 0.523 * src[p * 4 + 1] + 0.312 * src[p * 4 + 2]
}

// Back from (Y, I, Q) to a pixel.
kernel func toRgb(y: float, ci: float, cq: float) -> vec<float, 4> {
    return vec[y + 0.956 * ci + 0.621 * cq, y - 0.272 * ci - 0.647 * cq, y - 1.106 * ci + 1.703 * cq, 1.0]
}

// The pixel `dx` columns and `dy` rows from pixel `i`, with the picture's edge repeated outwards.
kernel func neighbour(uniform opts: ptr<float>, i: i32, dx: i32, dy: i32) -> i32 {
    let w: i32 = opts[0].toI32()
    let h: i32 = opts[1].toI32()
    var x: i32 = i % w + dx
    var y: i32 = i / w + dy
    if (x < 0) { x = 0 }
    if (x > w - 1) { x = w - 1 }
    if (y < 0) { y = 0 }
    if (y > h - 1) { y = h - 1 }
    return y * w + x
}

kernel func luma(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    let y: float = lumaAt(src, i)
    return vec[y, y, y, 1.0]
}

// The colour with the brightness thrown away: every pixel at the same middle brightness.
kernel func hueOnly(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    return toRgb(0.5, inphaseAt(src, i), quadAt(src, i))
}

// Turn (I, Q) by `opts[2]` radians around the colour wheel.
kernel func rotateHue(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    let ci: float = inphaseAt(src, i)
    let cq: float = quadAt(src, i)
    let turn: float = opts[2]
    return toRgb(lumaAt(src, i), ci * cosf(turn) - cq * sinf(turn), ci * sinf(turn) + cq * cosf(turn))
}

// Multiply (I, Q) by `opts[2]`: 0 is grey, 1 unchanged, above 1 more vivid.
kernel func scaleColour(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    return toRgb(lumaAt(src, i), inphaseAt(src, i) * opts[2], quadAt(src, i) * opts[2])
}

// Average (I, Q) over a square of radius `opts[2]`; the brightness is left alone.
kernel func chromaBlur(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    let r: i32 = opts[2].toI32()
    var si: float = 0.0
    var sq: float = 0.0
    for (dy = 0 - r; dy <= r; dy = dy + 1) {
        for (dx = 0 - r; dx <= r; dx = dx + 1) {
            let p: i32 = neighbour(opts, i, dx, dy)
            si = si + inphaseAt(src, p)
            sq = sq + quadAt(src, p)
        }
    }
    let n: float = ((2 * r + 1) * (2 * r + 1)).toFloat()
    return toRgb(lumaAt(src, i), si / n, sq / n)
}

// Average the brightness over a square of radius `opts[2]`; the colour is left alone.
kernel func lumaBlur(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    let r: i32 = opts[2].toI32()
    var sy: float = 0.0
    for (dy = 0 - r; dy <= r; dy = dy + 1) {
        for (dx = 0 - r; dx <= r; dx = dx + 1) {
            sy = sy + lumaAt(src, neighbour(opts, i, dx, dy))
        }
    }
    let n: float = ((2 * r + 1) * (2 * r + 1)).toFloat()
    return toRgb(sy / n, inphaseAt(src, i), quadAt(src, i))
}

// Unsharp mask on the brightness only: Y + amount * (Y - the average of the 3 x 3 around it).
kernel func sharpenLuma(index i: i32, uniform src: ptr<float>, uniform opts: ptr<float>) -> vec<float, 4> {
    var sy: float = 0.0
    for (dy = 0 - 1; dy <= 1; dy = dy + 1) {
        for (dx = 0 - 1; dx <= 1; dx = dx + 1) {
            sy = sy + lumaAt(src, neighbour(opts, i, dx, dy))
        }
    }
    let y: float = lumaAt(src, i)
    return toRgb(y + opts[2] * (y - sy / 9.0), inphaseAt(src, i), quadAt(src, i))
}

extern func sinf(x: float) -> float
extern func cosf(x: float) -> float

// The test picture: hue sweeps across (a full turn), saturation grows downwards; the lower half
// carries fine brightness stripes and there is a bright disc with a sharp edge.
func testPicture(w: i64, h: i64) -> ptr<float> {
    let img: ptr<float> = calloc(w * h * 4, 4).toPtr()
    for (y = 0; y < h; y = y + 1) {
        for (x = 0; x < w; x = x + 1) {
            let turn: float = 6.2831853 * x.toFloat() / w.toFloat()
            let amount: float = 0.15 + 0.35 * y.toFloat() / h.toFloat()
            var level: float = 0.55
            if (y > h / 2 && x % 6 < 2) { level = 0.25 }
            let dx: float = x.toFloat() - 120.0
            let dy: float = y.toFloat() - 35.0
            if (dx * dx + dy * dy < 400.0) { level = 0.9 }
            let at: i64 = (y * w + x) * 4
            let px: vec<float, 4> = toRgb(level, amount * cosf(turn), amount * sinf(turn))
            for (c = 0; c < 3; c = c + 1) {
                var v: float = px[c]
                if (v < 0.0) { v = 0.0 }
                if (v > 1.0) { v = 1.0 }
                img[at + c] = v
            }
            img[at + 3] = 1.0
        }
    }
    return img
}

func near(a: float, b: float, tolerance: float) -> i64 {
    var gap: float = a - b
    if (gap < 0.0) { gap = 0.0 - gap }
    if (gap <= tolerance) { return 1 }
    return 0
}

func settings(w: i64, h: i64, setting: float) -> ptr<float> {
    let opts: ptr<float> = calloc(4, 4).toPtr()
    opts[0] = w.toFloat()
    opts[1] = h.toFloat()
    opts[2] = setting
    return opts
}

// The same kernel on the CPU for pixel `i`, picked by name (the kernels are ordinary functions).
func cpuPixel(name: string, i: i64, img: ptr<float>, opts: ptr<float>) -> vec<float, 4> {
    let k: i32 = i.toI32()
    if (name == "luma") { return luma(k, img, opts) }
    if (name == "hueOnly") { return hueOnly(k, img, opts) }
    if (name == "rotateHue") { return rotateHue(k, img, opts) }
    if (name == "scaleColour") { return scaleColour(k, img, opts) }
    if (name == "chromaBlur") { return chromaBlur(k, img, opts) }
    if (name == "lumaBlur") { return lumaBlur(k, img, opts) }
    return sharpenLuma(k, img, opts)
}

// Every 7th pixel of the GPU's picture equals the CPU's.
func agrees(name: string, gpu: ptr<float>, img: ptr<float>, opts: ptr<float>, n: i64) -> i64 {
    for (i = 0; i < n; i = i + 7) {
        let cpu: vec<float, 4> = cpuPixel(name, i, img, opts)
        for (c = 0; c < 3; c = c + 1) {
            if (near(gpu[i * 4 + c], cpu[c], 0.01) == 0) { return 0 }
        }
    }
    return 1
}

func properties(results: ptr<i64>, img: ptr<float>, w: i64, h: i64, scopeFile: string) -> i64 {
    let blur: ptr<float> = results[4].toPtr()
    let grey: ptr<float> = results[3].toPtr()
    let turned: ptr<float> = results[7].toPtr()
    for (i = 0; i < w * h; i = i + 5) {
        // The chroma blur never changes a pixel's brightness.
        if (near(lumaAt(blur, i.toI32()), lumaAt(img, i.toI32()), 0.01) == 0) { return 14 }
        // No colour left: red, green and blue are equal.
        if (near(grey[i * 4], grey[i * 4 + 1], 0.01) == 0 || near(grey[i * 4 + 1], grey[i * 4 + 2], 0.01) == 0) { return 14 }
        // A whole turn round the colour wheel is no change.
        for (c = 0; c < 3; c = c + 1) {
            if (near(turned[i * 4 + c], img[i * 4 + c], 0.01) == 0) { return 14 }
        }
    }
    return drawScopes(results, img, w, h, scopeFile)
}

// A VECTORSCOPE: every pixel plotted at its (I, Q) (I across, Q up), one 128 x 128 panel for each picture.
func scope(panel: ptr<float>, left: i64, pic: ptr<float>, w: i64, h: i64) -> i64 {
    for (i = 0; i < w * h; i = i + 1) {
        let x: i64 = 64 + (inphaseAt(pic, i.toI32()) * 100.0).toI64()
        let y: i64 = 64 - (quadAt(pic, i.toI32()) * 100.0).toI64()
        if (x >= 0 && x < 128 && y >= 0 && y < 128) {
            let at: i64 = y * 384 + left + x
            panel[at] = panel[at] + 0.2
        }
    }
    return 0
}

func drawScopes(results: ptr<i64>, img: ptr<float>, w: i64, h: i64, scopeFile: string) -> i64 {
    let panel: ptr<float> = calloc(384 * 128, 4).toPtr()
    scope(panel, 0, img, w, h)
    scope(panel, 128, results[2].toPtr(), w, h)
    scope(panel, 256, results[3].toPtr(), w, h)
    for (y = 0; y < 128; y = y + 1) {
        for (k = 0; k < 3; k = k + 1) {
            panel[y * 384 + k * 128 + 64] = panel[y * 384 + k * 128 + 64] + 0.15
        }
    }
    savePicture(scopeFile, panel, 384, 128)
    return 0
}
