// REDUCTION: turning many numbers into one (a sum, a largest value) on the GPU.
//
// One thread cannot add a million numbers quickly, and a thousand threads cannot all
// add into the same place at once. The trick is a TREE. In each round, every thread
// adds just TWO neighbouring numbers and writes one result, so the list halves:
//
//   1,000,000 numbers -> 500,000 pair sums -> 250,000 -> ... -> 2 -> 1
//
// That is about 20 rounds ("passes") for a million numbers, and inside each pass every
// thread works independently, which is exactly what a GPU is good at. The host runs the
// passes one after another, using each pass's output as the next pass's input.
//
// Both kernels read the whole input list (`uniform src`) and compute output i from
// input slots 2*i and 2*i + 1. `n` is how many numbers are in the input; when it is odd
// the last thread has no partner and just passes its number along.
kernel func pairSum(index i: i32, uniform src: ptr<float>, uniform n: i32) -> float {
    let a: i32 = 2 * i
    var total: float = src[a]
    if (a + 1 < n) { total = total + src[a + 1] }
    return total
}

// The same pair-adding pass for whole numbers (counts), used to add up how many solutions
// each thread of a search found.
kernel func pairSumInt(index i: i32, uniform src: ptr<i32>, uniform n: i32) -> i32 {
    let a: i32 = 2 * i
    var total: i32 = src[a]
    if (a + 1 < n) { total = total + src[a + 1] }
    return total
}

kernel func pairMax(index i: i32, uniform src: ptr<float>, uniform n: i32) -> float {
    let a: i32 = 2 * i
    var best: float = src[a]
    if (a + 1 < n) {
        if (src[a + 1] > best) { best = src[a + 1] }
    }
    return best
}

// The number of passes needed to shrink `n` numbers to one: halve (rounding up) until 1.
func passCount(n: i64) -> i64 {
    var passes: i64 = 0
    var left: i64 = n
    for (k = 0; k < 40; k = k + 1) {
        if (left > 1) {
            left = (left + 1) / 2
            passes = passes + 1
        }
    }
    return passes
}

// The same reduction on the CPU, one number at a time, to check the GPU against.
func cpuSum(values: ptr<float>, n: i64) -> float {
    var total: float = 0.0
    for (i = 0; i < n; i = i + 1) {
        total = total + values[i]
    }
    return total
}

func cpuMax(values: ptr<float>, n: i64) -> float {
    var best: float = values[0]
    for (i = 1; i < n; i = i + 1) {
        if (values[i] > best) { best = values[i] }
    }
    return best
}

// The test data: 0, 1, ..., 6, 0, 1, ... so the sum is a whole number small enough for
// a float to hold exactly (adding in a different order then gives the same answer).
func fillTestData(values: ptr<float>, n: i64) -> i64 {
    for (i = 0; i < n; i = i + 1) {
        values[i] = (i % 7).toFloat()
    }
    values[n / 3] = 1000.0
    return 0
}
