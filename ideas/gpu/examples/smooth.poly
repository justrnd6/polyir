// A stencil kernel on the GPU (Metal), checked against the CPU. Each thread
// averages its element with its two neighbours, so it must read the WHOLE input
// array (`uniform src`) and know which element it is (`index i`).
//
//   polyir --emit-msl smooth.poly > smooth.metal
//   polyir smooth.poly --out smooth && ./smooth        (needs Apple Silicon; run in this folder)
//
// The program exits with 0 when every GPU result equals the CPU result.
import "../Metal.poly"

kernel func smooth(index i: i32, uniform src: ptr<float>, uniform n: i32) -> float {
    if (i == 0) { return src[i] }
    if (i == n - 1) { return src[i] }
    return (src[i - 1] + src[i] + src[i + 1]) / 3.0
}

func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let pipeline: i64 = metalPipeline(device, metalReadFile("smooth.metal"), "smooth")
    if (pipeline == 0) { return 11 }
    return compareWithCpu(device, pipeline)
}

func compareWithCpu(device: i64, pipeline: i64) -> i64 {
    let xs: float[6]
    xs[0] = 3.0
    xs[1] = 9.0
    xs[2] = 0.0
    xs[3] = 6.0
    xs[4] = 12.0
    xs[5] = 3.0
    let count: i32[1]
    count[0] = 6
    let input: i64 = metalBuffer(device, xs.toI64(), 24)
    let size: i64 = metalBuffer(device, count.toI64(), 4)
    let output: i64 = metalEmptyBuffer(device, 24)
    // Buffers go in slot order: src, n, then the result.
    if (metalDispatch(device, pipeline, 6, input, size, output, 0) == 0) { return 12 }
    let results: ptr<float> = metalContents(output).toPtr()
    let cpuInput: ptr<float> = xs.toI64().toPtr()
    for (i = 0; i < 6; i = i + 1) {
        if (results[i] != smooth(i, cpuInput, 6)) { return 13 }
    }
    return 0
}
