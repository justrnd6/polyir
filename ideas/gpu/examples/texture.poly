// TEXTURES AND IMAGES on the GPU (Metal). Four small experiments, each saved as a
// grey picture and checked against the CPU running the same kernel:
//
//   1. magnify: a tiny 8 x 8 picture blown up to 128 x 128 two ways, NEAREST (blocky)
//      and BILINEAR (smooth)                            -> tex-nearest, tex-bilinear
//   2. wrap modes: look at positions OUTSIDE the picture, with clamp, repeat, mirror
//                                                         -> tex-clamp, tex-repeat, tex-mirror
//   3. a textured floor in the ray tracer, seen with nearest, bilinear and mipmapped
//      filtering (look at the far distance)              -> floor-nearest, floor-bilinear, floor-mip
//   4. image processing: blur and edge detection on a 64 x 64 image
//                                                         -> img-source, img-blur, img-edges
//
//   polyir --emit-msl texture.poly > texture.metal
//   polyir texture.poly --out texture && ./texture      (Apple Silicon; run in this folder)
//
// Exit 0 means every picture matched the CPU. 10 no GPU, 11 the Metal source is
// missing, 12 a dispatch failed, 13 a picture differs from the CPU's.
import "../Metal.poly"
import "shared/scene.poly"

extern func sqrtf(x: float) -> float

// ── 1 and 2: resampling an image ─────────────────────────────────────────────
// p: 0 source width   1 output width   2 filter (0 nearest, 1 bilinear)
//    3 wrap (0 clamp, 1 repeat, 2 mirror)   4 first u and v   5 last u and v
// Each output pixel asks the texture for the colour at its own (u, v). The range
// 4 to 5 decides which part of the texture world is shown: 0 to 1 is the picture
// itself, -0.5 to 1.5 also shows what lies outside it.
kernel func resample(index i: i32, uniform tex: ptr<float>, uniform p: ptr<float>) -> float {
    let w: i32 = p[1].toI32()
    let u: float = p[4] + (p[5] - p[4]) * ((i % w).toFloat() + 0.5) / p[1]
    let v: float = p[4] + (p[5] - p[4]) * ((i / w).toFloat() + 0.5) / p[1]
    if (p[2] < 0.5) { return nearest(tex, 0, p[0].toI32(), u, v, p[3].toI32()) }
    return bilinear(tex, 0, p[0].toI32(), u, v, p[3].toI32())
}

// ── 4: image processing. Each is a 3 x 3 "neighbourhood" kernel (a 2D stencil) ──
// p: 0 image width. The neighbours come from `texel`, with clamp so the edges are safe.
kernel func blur(index i: i32, uniform tex: ptr<float>, uniform p: ptr<float>) -> float {
    let size: i32 = p[0].toI32()
    let x: i32 = i % size
    let y: i32 = i / size
    var sum: float = 0.0
    for (dy = 0 - 1; dy <= 1; dy = dy + 1) {
        for (dx = 0 - 1; dx <= 1; dx = dx + 1) {
            sum = sum + texel(tex, 0, size, x + dx, y + dy, 0)
        }
    }
    return sum / 9.0
}

// Sobel edge detection: how fast does the brightness change across and down?
// A big change in either direction means an edge.
kernel func edges(index i: i32, uniform tex: ptr<float>, uniform p: ptr<float>) -> float {
    let size: i32 = p[0].toI32()
    let x: i32 = i % size
    let y: i32 = i / size
    let acrossRight: float = texel(tex, 0, size, x + 1, y - 1, 0) + 2.0 * texel(tex, 0, size, x + 1, y, 0) + texel(tex, 0, size, x + 1, y + 1, 0)
    let acrossLeft: float = texel(tex, 0, size, x - 1, y - 1, 0) + 2.0 * texel(tex, 0, size, x - 1, y, 0) + texel(tex, 0, size, x - 1, y + 1, 0)
    let downBelow: float = texel(tex, 0, size, x - 1, y + 1, 0) + 2.0 * texel(tex, 0, size, x, y + 1, 0) + texel(tex, 0, size, x + 1, y + 1, 0)
    let downAbove: float = texel(tex, 0, size, x - 1, y - 1, 0) + 2.0 * texel(tex, 0, size, x, y - 1, 0) + texel(tex, 0, size, x + 1, y - 1, 0)
    let gx: float = acrossRight - acrossLeft
    let gy: float = downBelow - downAbove
    return sqrtf(gx * gx + gy * gy) * 0.25
}

// ── the CPU side: making the images ──────────────────────────────────────────
// An 8 x 8 smiley. 1 in the pattern means a dark texel (the outline and the features).
func fillSmiley(tex: ptr<float>) -> i64 {
    let rows: i32[8]
    rows[0] = 60
    rows[1] = 66
    rows[2] = 165
    rows[3] = 129
    rows[4] = 165
    rows[5] = 153
    rows[6] = 66
    rows[7] = 60
    for (y = 0; y < 8; y = y + 1) {
        for (x = 0; x < 8; x = x + 1) {
            let bit: i32 = (rows[y] / (1 << (7 - x))) % 2
            tex[y * 8 + x] = 0.9 - 0.8 * bit.toFloat()
        }
    }
    return 0
}

func main() -> i64 {
    let device: i64 = metalDevice()
    if (device == 0) { return 10 }
    let source: string = metalReadFile("texture.metal")
    if (resampleDemos(device, source) != 0) { return 13 }
    if (floorDemos(device, source) != 0) { return 13 }
    return imageDemos(device, source)
}

// Run `kernel` over `n` outputs with two read-only arrays; returns the GPU's results (0 if it failed).
func run(device: i64, source: string, name: string, first: ptr<float>, firstBytes: i64, second: ptr<float>, secondBytes: i64, n: i64) -> ptr<float> {
    let pipeline: i64 = metalPipeline(device, source, name)
    let out: i64 = metalEmptyBuffer(device, n * 4)
    if (pipeline == 0) { return 0.toPtr() }
    if (metalDispatch(device, pipeline, n, metalBuffer(device, first.toI64(), firstBytes), metalBuffer(device, second.toI64(), secondBytes), out, 0) == 0) { return 0.toPtr() }
    return metalContents(out).toPtr()
}

// ── 1 and 2 ──
func resampleDemos(device: i64, source: string) -> i64 {
    let tex: ptr<float> = calloc(64, 4).toPtr()
    fillSmiley(tex)
    if (resampleOne(device, source, tex, "tex-nearest.pgm", 0.0, 0.0, 0.0, 1.0) != 0) { return 1 }
    if (resampleOne(device, source, tex, "tex-bilinear.pgm", 1.0, 0.0, 0.0, 1.0) != 0) { return 1 }
    if (resampleOne(device, source, tex, "tex-clamp.pgm", 0.0, 0.0, 0.0 - 0.5, 1.5) != 0) { return 1 }
    if (resampleOne(device, source, tex, "tex-repeat.pgm", 0.0, 1.0, 0.0 - 0.5, 1.5) != 0) { return 1 }
    return resampleOne(device, source, tex, "tex-mirror.pgm", 0.0, 2.0, 0.0 - 0.5, 1.5)
}

func resampleOne(device: i64, source: string, tex: ptr<float>, name: string, filter: float, wrapMode: float, from: float, to: float) -> i64 {
    let p: ptr<float> = calloc(8, 4).toPtr()
    p[0] = 8.0
    p[1] = 128.0
    p[2] = filter
    p[3] = wrapMode
    p[4] = from
    p[5] = to
    let gpu: ptr<float> = run(device, source, "resample", tex, 256, p, 32, 16384)
    if (gpu.toI64() == 0) { return 1 }
    savePicture(name, gpu, 128, 128)
    for (i = 0; i < 16384; i = i + 1) {
        if (differs(gpu[i], resample(i, tex, p)) == 1) { return 1 }
    }
    return 0
}

func differs(a: float, b: float) -> i64 {
    var gap: float = a - b
    if (gap < 0.0) { gap = 0.0 - gap }
    if (gap > 0.002) { return 1 }
    return 0
}

// ── 3: the textured floor, three filters ──
func floorDemos(device: i64, source: string) -> i64 {
    let pyramid: ptr<float> = calloc(1400, 4).toPtr()
    buildPyramid(pyramid, 32)
    if (floorOne(device, source, pyramid, "floor-nearest.pgm", 1.0) != 0) { return 1 }
    if (floorOne(device, source, pyramid, "floor-bilinear.pgm", 2.0) != 0) { return 1 }
    return floorOne(device, source, pyramid, "floor-mip.pgm", 3.0)
}

func floorOne(device: i64, source: string, pyramid: ptr<float>, name: string, look: float) -> i64 {
    let cam: ptr<float> = calloc(28, 4).toPtr()
    buildCamera(cam, 320, 180)
    cam[24] = look
    let gpu: ptr<float> = run(device, source, "trace", cam, 112, pyramid, 5460, 57600)
    if (gpu.toI64() == 0) { return 1 }
    savePicture(name, gpu, 320, 180)
    // A few pixels on the edge of the sphere or of a texel may round differently.
    var different: i64 = 0
    for (i = 0; i < 57600; i = i + 1) {
        var gap: float = gpu[i] - trace(i, cam, pyramid)
        if (gap < 0.0) { gap = 0.0 - gap }
        if (gap > 0.01) { different = different + 1 }
    }
    if (different > 60) { return 1 }
    return 0
}

// ── 4: blur and edges ──
func imageDemos(device: i64, source: string) -> i64 {
    let img: ptr<float> = calloc(4096, 4).toPtr()
    fillScene(img)
    savePicture("img-source.pgm", img, 64, 64)
    let p: ptr<float> = calloc(2, 4).toPtr()
    p[0] = 64.0
    if (filterOne(device, source, "blur", "img-blur.pgm", img, p) != 0) { return 13 }
    return filterOne(device, source, "edges", "img-edges.pgm", img, p) * 13
}

func filterOne(device: i64, source: string, kernelName: string, name: string, img: ptr<float>, p: ptr<float>) -> i64 {
    let gpu: ptr<float> = run(device, source, kernelName, img, 16384, p, 8, 4096)
    if (gpu.toI64() == 0) { return 1 }
    savePicture(name, gpu, 64, 64)
    for (i = 0; i < 4096; i = i + 1) {
        var expected: float = blur(i, img, p)
        if (kernelName == "edges") { expected = edges(i, img, p) }
        if (differs(gpu[i], expected) == 1) { return 1 }
    }
    return 0
}
