func histTest() -> i64 {
  let hist: i64[4]
  hist[0] = 10
  hist[1] = 20
  hist[2] = 30
  hist[3] = 40
  return hist[1] + hist[2]
}

func lenCheck() -> i64 {
  let hist: i64[4]
  return hist.len()
}

func sumFixed(arr: i64[4]) -> i64 {
  return arr[0] + arr[1] + arr[2] + arr[3]
}

func lenOnParam(arr: i64[4]) -> i64 {
  return arr.len()
}

func callWithLocal() -> i64 {
  let hist: i64[4]
  hist[0] = 1
  hist[1] = 2
  hist[2] = 3
  hist[3] = 4
  return sumFixed(hist) * 100 + lenOnParam(hist)
}
