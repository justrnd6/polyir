func fillToCapacity() -> i64 {
  let arr: buffer<i64, 4> = buffer<i64, 4>()
  arr[0] = 10
  arr[1] = 20
  arr[2] = 30
  arr[3] = 40
  return arr[0] + arr[1] + arr[2] + arr[3]
}

func capacityCheck() -> i64 {
  let arr: buffer<i64, 4> = buffer<i64, 4>()
  arr[0] = 1
  arr[1] = 2
  return arr.capacity()
}

func letBoundIndexedFill() -> i64 {
  let arr: buffer<i64, 3> = buffer<i64, 3>()
  arr[0] = 5
  arr[1] = 6
  arr[2] = 7
  return arr[0] + arr[1] + arr[2]
}

func sumViaLoop(n: i64) -> i64 {
  let arr: buffer<i64, 10> = buffer<i64, 10>()
  for (i = 0; i < n; i = i + 1) {
    arr[i] = i
  }
  var total: i64 = 0
  for (i = 0; i < n; i = i + 1) {
    total = total + arr[i]
  }
  return total
}

func stringElements() -> i64 {
  let names: buffer<string, 2> = buffer<string, 2>()
  names[0] = "first"
  names[1] = "second"
  if (names[0] != "first") {
    return 0
  }
  if (names[1] != "second") {
    return 0
  }
  return 1
}

func sumParam(arr: buffer<i64, 3>) -> i64 {
  return arr[0] + arr[1] + arr[2] + arr.capacity()
}

func viaParam() -> i64 {
  let arr: buffer<i64, 3> = buffer<i64, 3>()
  arr[0] = 100
  arr[1] = 200
  arr[2] = 300
  return sumParam(arr)
}
