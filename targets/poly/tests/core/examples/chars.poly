func literalEqualsItself() -> i64 {
  let c: i8 = 65
  if (c == 65) {
    return 1
  }
  return 0
}

func literalsDistinguishCorrectly() -> i64 {
  let a: i8 = 97
  let b: i8 = 98
  if (a == b) {
    return 0
  }
  return 1
}

func gridOfCharsRoundTrip() -> i64 {
  let g: grid<i8, 1, 3>
  g[0, 0] = 120
  g[0, 1] = 121
  g[0, 2] = 122
  if (g[0, 0] == 120 && g[0, 1] == 121 && g[0, 2] == 122) {
    return 1
  }
  return 0
}

func darrayOfCharsRoundTrip() -> i64 {
  let cs: mutarray<i8> = mutarray<i8>()
  cs.push(104)
  cs.push(105)
  if (cs[0] == 104 && cs[1] == 105) {
    return 1
  }
  return 0
}
