func counterTwice() -> i64 {
  var count: i64 = 0
  let inc: closure() -> i64 = closure() -> i64 {
    count = count + 1
    return count
  }
  let a: i64 = inc()
  let b: i64 = inc()
  return a * 100 + b
}

func makeMultiplier(factor: i64) -> closure(i64) -> i64 {
  let mul: closure(i64) -> i64 = closure(x: i64) -> i64 {
    return x * factor
  }
  return mul
}

func tripleOf(x: i64) -> i64 {
  let triple: closure(i64) -> i64 = makeMultiplier(3)
  return triple(x)
}

func sharedCounter() -> i64 {
  var shared: i64 = 0
  let bumpBy1: closure() -> i64 = closure() -> i64 {
    shared = shared + 1
    return shared
  }
  let bumpBy10: closure() -> i64 = closure() -> i64 {
    shared = shared + 10
    return shared
  }
  let a: i64 = bumpBy1()
  let b: i64 = bumpBy10()
  let c: i64 = bumpBy1()
  return a * 10000 + b * 100 + c
}
