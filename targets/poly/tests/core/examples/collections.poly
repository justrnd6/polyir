struct Point(x: i64, y: i64) {
}

func grow() -> i64 {
  let none: array<i64> = array<i64>()
  let one: array<i64> = none.with(10)
  let two: array<i64> = one.with(20)
  return none.len() * 1000 + one.len() * 100 + two.len() * 10 + two[1] / 10
}

func build() -> array<i64> {
  let xs: mutarray<i64> = mutarray<i64>()
  for (i = 0; i < 5; i = i + 1) {
    xs.push(i * i)
  }
  return xs.freeze()
}

func lookup() -> i64 {
  let ages: map<string, i64> = map<string, i64>().with("ann", 31).with("bo", 27)
  let seen: set<i64> = set<i64>().with(3).with(5).with(3)
  var score: i64 = ages["ann"] + ages["bo"] + seen.len()
  if (ages.has("cy") == false) {
    score = score + 100
  }
  if (seen.has(5)) {
    score = score + 1000
  }
  return score
}

func visited() -> i64 {
  let seen: mutset<Point> = mutset<Point>()
  seen.add(Point(x: 1, y: 2))
  seen.add(Point(x: 3, y: 4))
  seen.add(Point(x: 1, y: 2))
  var score: i64 = seen.len()
  if (seen.has(Point(x: 3, y: 4))) {
    score = score + 10
  }
  return score
}

func sameThings() -> i64 {
  let a: map<i64, string> = map<i64, string>().with(1, "a").with(2, "b")
  let b: map<i64, string> = map<i64, string>().with(2, "b").with(1, "a")
  var score: i64 = 0
  if (a == b) {
    score = score + 1
  }
  if (a === b) {
    score = score + 100
  }
  return score
}

func main() -> i64 {
  return grow() + build()[4] * 10000 + lookup() + visited() + sameThings()
}
