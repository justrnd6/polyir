coro func evens(limit: i64) -> i64 {
  for (i = 0; i < limit; i = i + 2) {
    yield i
  }
}

func sumOfEvens() -> i64 {
  var total: i64 = 0
  let forGen_14_8: coro<i64> = evens(10)
  var forStep_14_8: variant<i64> = forGen_14_8.resume()
  for (; forStep_14_8.isCase(0); ) {
    let n: i64 = forStep_14_8.unwrapAt(0)
    total = total + n
    forStep_14_8 = forGen_14_8.resume()
  }
  return total
}

func firstOver(limit: i64) -> i64 {
  let forGen_22_8: coro<i64> = evens(100)
  var forStep_22_8: variant<i64> = forGen_22_8.resume()
  for (; forStep_22_8.isCase(0); ) {
    let n: i64 = forStep_22_8.unwrapAt(0)
    if (n > limit) {
      forGen_22_8.close()
      return n
    }
    forStep_22_8 = forGen_22_8.resume()
  }
  return -1
}

func pairs() -> i64 {
  var total: i64 = 0
  let forGen_33_8: coro<i64> = evens(6)
  var forStep_33_8: variant<i64> = forGen_33_8.resume()
  for (; forStep_33_8.isCase(0); ) {
    let a: i64 = forStep_33_8.unwrapAt(0)
    let forGen_34_10: coro<i64> = evens(4)
    var forStep_34_10: variant<i64> = forGen_34_10.resume()
    for (; forStep_34_10.isCase(0); ) {
      let b: i64 = forStep_34_10.unwrapAt(0)
      total = total + a * 10 + b
      forStep_34_10 = forGen_34_10.resume()
    }
    forStep_33_8 = forGen_33_8.resume()
  }
  return total
}

func main() -> i64 {
  return sumOfEvens() + firstOver(5) + pairs()
}
