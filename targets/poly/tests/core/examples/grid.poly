func fillAndWeight(scale: i64) -> i64 {
  let g: grid<i64, 3, 4>
  for (r = 0; r < 3; r = r + 1) {
    for (c = 0; c < 4; c = c + 1) {
      g[r, c] = (r * 4 + c) * scale
    }
  }
  var total: i64 = 0
  for (r = 0; r < 3; r = r + 1) {
    for (c = 0; c < 4; c = c + 1) {
      total = total + g[r, c] * (r + 1)
    }
  }
  return total
}

func singleCellRoundTrip() -> i64 {
  let g: grid<i64, 2, 2>
  g[0, 0] = 10
  g[0, 1] = 20
  g[1, 0] = 30
  g[1, 1] = 40
  return g[1, 0] - g[0, 1]
}

func dimsCheck() -> i64 {
  let g: grid<i64, 3, 4>
  return g.rows() * 100 + g.cols()
}
