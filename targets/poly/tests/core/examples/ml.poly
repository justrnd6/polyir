func relu(x: double) -> double {
  if (x < 0.0) {
    return 0.0
  }
  return x
}

func xorForward(x1: double, x2: double) -> double {
  let w1: tensor<double, 2, 2>
  w1[0, 0] = 1.0
  w1[0, 1] = 1.0
  w1[1, 0] = 1.0
  w1[1, 1] = 1.0
  let b1: tensor<double, 2>
  b1[0] = 0.0
  b1[1] = 0.0 - 1.0
  let hidden: tensor<double, 2>
  for (i = 0; i < 2; i = i + 1) {
    var preActivation: double = b1[i]
    preActivation = preActivation + w1[i, 0] * x1
    preActivation = preActivation + w1[i, 1] * x2
    hidden[i] = relu(preActivation)
  }
  let w2: tensor<double, 2>
  w2[0] = 1.0
  w2[1] = 0.0 - 2.0
  let b2: double = 0.0
  var output: double = b2
  for (i = 0; i < 2; i = i + 1) {
    output = output + w2[i] * hidden[i]
  }
  return output
}

func xorPredict(x1: double, x2: double) -> i64 {
  if (xorForward(x1, x2) >= 0.5) {
    return 1
  }
  return 0
}
