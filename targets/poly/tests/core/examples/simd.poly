func vecMulSum(a: double, b: double) -> double {
  let v1: vec<double, 4> = vec[a, a + 1.0, a + 2.0, a + 3.0]
  let v2: vec<double, 4> = vec[b, b, b, b]
  let p: vec<double, 4> = v1 * v2
  return p[0] + p[1] + p[2] + p[3]
}

func sumI64Vec(a: i64, b: i64, c: i64) -> i64 {
  let v: vec<i64, 3> = vec[a, b, c]
  return v[0] + v[1] + v[2]
}

func vecMulSumViaVar(a: double, b: double) -> double {
  let v1: vec<double, 4> = vec[a, a + 1.0, a + 2.0, a + 3.0]
  let v2: vec<double, 4> = vec[b, b, b, b]
  let p: vec<double, 4> = v1 * v2
  var total: double = 0.0
  for (i = 0; i < 4; i = i + 1) {
    total = total + p[i]
  }
  return total
}
