coro func count(n: i64) -> i64 {
  var gone: bool = false
  for (i = 0; i < n; i = i + 1) {
    if (!gone) {
      gone = i.yielded()
    }
  }
}

func main() -> i64 {
  let c: coro<i64> = count(5)
  let first: variant<i64> = c.resume()
  c.close()
  if (c.done()) {
    return first.unwrapAt(0) + 40
  }
  return 1
}
