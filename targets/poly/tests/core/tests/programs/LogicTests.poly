import "Check.poly"
global calls: i64 = 0
global noted: i64 = 0

func tick() -> bool {
  calls = calls + 1
  return true
}

func checkAndSkipsRightSideWhenLeftIsFalse() -> double {
  calls = 0
  if (1 == 2 && tick()) {
    return 1.0
  }
  return offInt(calls, 0)
}

func checkAndRunsRightSideWhenLeftIsTrue() -> double {
  calls = 0
  if (1 == 1 && tick()) {
    return offInt(calls, 1)
  }
  return 1.0
}

func checkOrSkipsRightSideWhenLeftIsTrue() -> double {
  calls = 0
  if (1 == 1 || tick()) {
    return offInt(calls, 0)
  }
  return 1.0
}

func checkOrRunsRightSideWhenLeftIsFalse() -> double {
  calls = 0
  if (1 == 2 || tick()) {
    return offInt(calls, 1)
  }
  return 1.0
}

func checkNullGuardWithAnd() -> double {
  let p: ptr<i64> = 0.toPtr()
  if (p.toI64() != 0 && p[0] == 5) {
    return 1.0
  }
  return 0.0
}

func checkNullGuardWithOr() -> double {
  let p: ptr<i64> = 0.toPtr()
  if (p.toI64() == 0 || p[0] == 5) {
    return 0.0
  }
  return 1.0
}

func checkLoopConditionShortCircuits() -> double {
  calls = 0
  var rounds: i64 = 0
  for (i = 0; i < 5 && tick(); i = i + 1) {
    rounds = rounds + 1
  }
  return offInt(rounds, 5) + offInt(calls, 5)
}

func checkLetShortCircuits() -> double {
  calls = 0
  let ok: bool = 1 == 2 && tick()
  if (ok) {
    return 1.0
  }
  return offInt(calls, 0)
}

func checkVarAndAssignShortCircuit() -> double {
  calls = 0
  var ok: bool = 1 == 2 && tick()
  ok = 1 == 1 || tick()
  if (ok) {
    return offInt(calls, 0)
  }
  return 1.0
}

func bothTrue(a: i64, b: i64) -> bool {
  return a > 0 && b > 0
}

func checkReturnValue() -> double {
  var wrong: i64 = 0
  if (bothTrue(1, 1) == false) {
    wrong = wrong + 1
  }
  if (bothTrue(1, 0)) {
    wrong = wrong + 1
  }
  if (bothTrue(0, 1)) {
    wrong = wrong + 1
  }
  return offInt(wrong, 0)
}

func checkNotOfAnd() -> double {
  let p: ptr<i64> = 0.toPtr()
  if (!(p.toI64() != 0 && p[0] == 5)) {
    return 0.0
  }
  return 1.0
}

func checkAndBindsTighterThanOr() -> double {
  if (1 == 1 || 1 == 2 && 1 == 2) {
    return 0.0
  }
  return 1.0
}

func checkAndBindsTighterThanOrOnTheLeft() -> double {
  if (1 == 2 && 1 == 2 || 1 == 1) {
    return 0.0
  }
  return 1.0
}

func checkChain() -> double {
  var wrong: i64 = 0
  if (!(1 == 1 && 2 == 2 && 3 == 3)) {
    wrong = wrong + 1
  }
  if (1 == 1 && 2 == 2 && 3 == 4) {
    wrong = wrong + 1
  }
  if (1 == 2 || 2 == 3 || 3 == 4) {
    wrong = wrong + 1
  }
  if (!(1 == 2 || 2 == 3 || 3 == 3)) {
    wrong = wrong + 1
  }
  return offInt(wrong, 0)
}

func gradeOf(n: i64) -> i64 {
  if (n > 90) {
    return 4
  } else if (n > 80) {
    return 3
  } else if (n > 70) {
    return 2
  } else {
    return 1
  }
}

func checkElseIfChain() -> double {
  return offInt(gradeOf(95) * 1000 + gradeOf(85) * 100 + gradeOf(75) * 10 + gradeOf(10), 4321)
}

func note(n: i64) -> void {
  if (n < 0) {
    return
  }
  noted = noted + n
}

func checkBareReturn() -> double {
  noted = 0
  note(5)
  note(0 - 3)
  note(7)
  return offInt(noted, 12)
}
