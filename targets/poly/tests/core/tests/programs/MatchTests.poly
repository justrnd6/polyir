func said(xs: array<i64>) -> string {
  var matchValue_161_12: string
  if (xs.len() == 0) {
    matchValue_161_12 = "empty"
  } else if (xs.len() == 1) {
    let x: i64 = xs[0]
    matchValue_161_12 = "just ${x}"
  } else if (xs[0] == 0) {
    matchValue_161_12 = "starts at zero"
  } else {
    let first: i64 = xs[0]
    let rest: mutarray<i64> = drop(xs, 1)
    matchValue_161_12 = "${first}, then ${rest.len()} more"
  }
  return matchValue_161_12
}

func checkLists() -> double {
  let none: array<i64> = array<i64>()
  return offText(said(none) + "; " + said([7]) + "; " + said([0, 1, 2]) + "; " + said([3, 4, 5]), "empty; just 7; starts at zero; 3, then 2 more")
}

func pairOf(xs: mutarray<i64>) -> string {
  var matchValue_176_12: string
  if (xs.len() == 2 && xs[0] == xs[1]) {
