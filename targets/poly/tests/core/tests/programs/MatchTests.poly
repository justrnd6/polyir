func contains(s: string, part: string) -> bool {
  return s.find(part, 0) >= 0
}

func startsWith(s: string, prefix: string) -> bool {
  if (prefix.len() > s.len()) {
    return false
  }
  return s.slice(0, prefix.len()) == prefix
}

func endsWith(s: string, suffix: string) -> bool {
  if (suffix.len() > s.len()) {
    return false
  }
  return s.slice(s.len() - suffix.len(), s.len()) == suffix
}

func join(parts: mutarray<string>, sep: string) -> string {
  var out: string = ""
  for (i = 0; i < parts.len(); i = i + 1) {
    if (i > 0) {
      out = out + sep
    }
    out = out + parts[i]
  }
  return out
}

func offText(got: string, want: string) -> double {
  if (got == want) {
    return 0.0
  }
  return 1.0
}

func sizeOf(n: i64) -> string {
  var matchValue_16_12: string
  switch (n) {
    0 => {
      matchValue_16_12 = "none"
    }
    1 | 2 | 3 => {
      matchValue_16_12 = "a few"
    }
    -1 => {
      matchValue_16_12 = "minus one"
    }
    else => {
      matchValue_16_12 = "many"
    }
  }
  return matchValue_16_12
}

func checkNumbers() -> double {
  return offText(sizeOf(0) + sizeOf(2) + sizeOf(9) + sizeOf(-1), "nonea fewmanyminus one")
}

func signOf(n: i64) -> string {
  var matchValue_30_16: string
  if (n < 0) {
    matchValue_30_16 = "negative"
  } else if (n == 0) {
    matchValue_30_16 = "zero"
  } else if (n >= 100) {
    matchValue_30_16 = "large"
  } else {
    matchValue_30_16 = "positive"
  }
  let sign: string = matchValue_30_16
  return sign
}

func checkComparisons() -> double {
  return offText(signOf(-3) + " " + signOf(0) + " " + signOf(150) + " " + signOf(5), "negative zero large positive")
}

func gradeOf(score: i64) -> string {
  var matchValue_45_12: string
  if (score == 100) {
    matchValue_45_12 = "perfect"
  } else if (score >= 90) {
    let s: i64 = score
    matchValue_45_12 = "A ${s}"
  } else if (score >= 80) {
    matchValue_45_12 = "B"
  } else {
    matchValue_45_12 = "C"
  }
  return matchValue_45_12
}

func checkGuardsOnTheSubject() -> double {
  return offText(gradeOf(100) + gradeOf(93) + gradeOf(85) + gradeOf(10), "perfectA 93BC")
}

