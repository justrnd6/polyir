  } else if (xs.len() == 2) {
    let a: i64 = xs[0]
    let b: i64 = xs[1]
    matchValue_176_12 = "${a} and ${b}"
  } else if (xs.len() >= 1 && xs[0] < 0) {
    matchValue_176_12 = "starts below zero"
  } else {
    matchValue_176_12 = "something else"
  }
  return matchValue_176_12
}

