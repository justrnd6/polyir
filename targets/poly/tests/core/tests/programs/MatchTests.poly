  let low: mutarray<i64> = [-1, 2, 3]
  return offText(pairOf(same) + "; " + pairOf(two) + "; " + pairOf(low) + "; " + pairOf([5]), "a pair of 4; 1 and 2; starts below zero; something else")
}

func command(c: string) -> string {
  var said: string = ""
  if (c == "quit" || c == "exit") {
    return "bye"
  } else if (startsWith(c, "say ")) {
    said = c.slice(4, c.len())
  } else if (c == "noop") {}
  return said
}

func checkStatements() -> double {
  return offText(command("say hi") + "|" + command("quit") + "|" + command("noop") + "|" + command("huh"), "hi|bye||")
}

func checkNested() -> double {
  let a: i64 = 2
  let b: i64 = 5
  var matchValue_212_21: string
  switch (a) {
    1 => {
      matchValue_212_21 = "one"
    }
    2 => {
      var matchValue_212_49: string
      switch (b) {
        5 => {
          matchValue_212_49 = "two-five"
        }
        else => {
          matchValue_212_49 = "two"
        }
      }
      matchValue_212_21 = matchValue_212_49
    }
    else => {
      matchValue_212_21 = "many"
    }
  }
  let text: string = str(matchValue_212_21)
  return offText(text, "two-five")
}

func drop<T>(xs: array<T>, n: i64) -> mutarray<T> {
  let out: mutarray<T> = mutarray<T>()
  for (i = n; i < xs.len(); i = i + 1) {
    out.push(xs[i])
  }
  return out
}
