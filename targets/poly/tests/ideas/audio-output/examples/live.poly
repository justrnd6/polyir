import "../Audio.poly"
import "../../audio/Wave.poly"
import "../../gpu/examples/shared/print.poly"
extern func calloc(count: i64, size: i64) -> i64
extern func floor(x: double) -> double
extern func getenv(name: string) -> i64

func glideRate() -> double {
  return 44100.0
}

func glide(state: i64, buf: ptr<float>, frames: i64, first: i64) -> i64 {
  let phases: ptr<double> = state.toPtr()
  let counters: ptr<i64> = state.toPtr()
  let recording: ptr<float> = counters[4].toPtr()
  for (i = 0; i < frames; i = i + 1) {
    let t: double = (first + i).toDouble() / glideRate()
    let left: double = 220.0 + 220.0 * t
    phases[0] = phases[0] + left / glideRate()
    phases[1] = phases[1] + 1.5 * left / glideRate()
    phases[0] = phases[0] - floor(phases[0])
    phases[1] = phases[1] - floor(phases[1])
    buf[i * 2] = (0.5 * sine(phases[0].toFloat()))
    buf[i * 2 + 1] = (0.5 * sine(phases[1].toFloat()))
    recording[(first + i) * 2] = buf[i * 2]
    recording[(first + i) * 2 + 1] = buf[i * 2 + 1]
  }
  counters[2] = counters[2] + frames
  counters[3] = counters[3] + 1
  return frames
}

func risingCrossings(recording: ptr<float>, frames: i64, channel: i64) -> i64 {
  var count: i64 = 0
  for (i = 1; i < frames; i = i + 1) {
    if (recording[(i - 1) * 2 + channel] < 0.0 && recording[i * 2 + channel] >= 0.0) {
      count = count + 1
    }
  }
  return count
}

func biggestStep(recording: ptr<float>, frames: i64, channel: i64) -> float {
  var biggest: float = 0.0
  for (i = 1; i < frames; i = i + 1) {
    var step: float = recording[i * 2 + channel] - recording[(i - 1) * 2 + channel]
    if (step < 0.0) {
      step = (0.0 - step)
    }
    if (step > biggest) {
      biggest = step
    }
  }
  return biggest
}

func main() -> i64 {
  let state: i64 = calloc(8, 8)
  let counters: ptr<i64> = state.toPtr()
  let recording: ptr<float> = calloc(44100 * 2 + 4, 4).toPtr()
  counters[4] = recording.toI64()
  let volume: float = if (getenv("POLYIR_PLAY") != 0) 1.0 else 0.0
  let started: i64 = wallMs()
  let fill: ptr<func(i64, ptr<float>, i64, i64) -> i64 > = glide
  let status: i64 = audioStreamAt(fill, state, 2, 44100, 1.0, volume)
  let elapsed: i64 = wallMs() - started
  if (status != 0) {
    return reportFailure(status)
  }
  return verify(counters, recording, elapsed)
}

func reportFailure(status: i64) -> i64 {
  say("no audio output available (system code ")
  sayNumber(status)
  say(")")
  newline()
  return 10
}

func verify(counters: ptr<i64>, recording: ptr<float>, elapsed: i64) -> i64 {
  let frames: i64 = counters[2]
  say("fill function called ")
  sayNumber(counters[3])
  say(" times for ")
  sayNumber(frames)
  say(" frames in ")
  sayNumber(elapsed)
  say(" ms")
  newline()
  if (frames != 44100) {
    return 12
  }
  if (biggestStep(recording, frames, 0) > 0.04 || biggestStep(recording, frames, 1) > 0.06) {
    return 13
  }
  return verifyPitch(recording, frames, elapsed)
}

func verifyPitch(recording: ptr<float>, frames: i64, elapsed: i64) -> i64 {
  let left: i64 = risingCrossings(recording, frames, 0)
  let right: i64 = risingCrossings(recording, frames, 1)
  say("cycles counted: left ")
  sayNumber(left)
  say(", right ")
  sayNumber(right)
  newline()
  if (left < 328 || left > 332 || right < 492 || right > 498) {
    return 14
  }
  if (elapsed < 800 || elapsed > 3000) {
    return 15
  }
  return 0
}
