import "Stream.poly"
extern func calloc(count: i64, size: i64) -> i64
extern func AudioQueueNewOutput(format: i64, callback: i64, user: i64, runLoop: i64, runLoopMode: i64, flags: i64, out: i64) -> i32
extern func AudioQueueAllocateBuffer(queue: i64, bytes: i64, out: i64) -> i32
extern func AudioQueueEnqueueBuffer(queue: i64, buf: i64, packets: i64, descriptions: i64) -> i32
extern func AudioQueueStart(queue: i64, startTime: i64) -> i32
extern func AudioQueueStop(queue: i64, immediately: i64) -> i32
extern func AudioQueueDispose(queue: i64, immediately: i64) -> i32
extern func usleep(microseconds: i64) -> i32

func audioFormat(rate: i64, channels: i64) -> i64 {
  let block: i64 = calloc(5, 8)
  let rateField: ptr<double> = block.toPtr()
  rateField[0] = rate.toDouble()
  let fields: ptr<i32> = block.toPtr()
  fields[2] = 1819304813
  fields[3] = 9
  fields[4] = (4 * channels).toI32()
  fields[5] = 1
  fields[6] = (4 * channels).toI32()
  fields[7] = channels.toI32()
  fields[8] = 32
  return block
}

func audioRefill(user: i64, queue: i64, buf: i64) -> i64 {
  let view: ptr<Stream> = user.toPtr()
  let stream: Stream = view[0]
  stream.progress[2] = stream.progress[2] - 1
  if (streamFinished(stream)) {
    return 0
  }
  return audioFillAndQueue(stream, queue, buf)
}

func audioFillAndQueue(stream: Stream, queue: i64, buf: i64) -> i64 {
  let words: ptr<i64> = buf.toPtr()
  let memory: ptr<float> = words[1].toPtr()
  let made: i64 = streamFeed(stream, memory, streamBufferFrames())
  if (made == 0) {
    return 0
  }
  let sizes: ptr<i32> = buf.toPtr()
  sizes[4] = (made * stream.channels * 4).toI32()
  stream.progress[2] = stream.progress[2] + 1
  AudioQueueEnqueueBuffer(queue, buf, 0, 0)
  return made
}

func audioPrime(stream: Stream, queue: i64) -> i64 {
  let slot: ptr<i64> = calloc(1, 8).toPtr()
  let status: i32 = AudioQueueAllocateBuffer(queue, streamBufferFrames() * stream.channels * 4, slot.toI64())
  if (status != 0) {
    return 0
  }
  audioFillAndQueue(stream, queue, slot[0])
  return slot[0]
}

func audioStreamRun(stream: Stream) -> i64 {
  let queueSlot: ptr<i64> = calloc(1, 8).toPtr()
  let streamSlot: ptr<Stream> = calloc(1, 64).toPtr()
  streamSlot[0] = stream
  let refill: ptr<func(i64, i64, i64) -> i64 > = audioRefill
  let format: i64 = audioFormat(stream.rate, stream.channels)
  let status: i32 = AudioQueueNewOutput(format, refill.toI64(), streamSlot.toI64(), 0, 0, 0, queueSlot.toI64())
  if (status != 0) {
    return status.toI64()
  }
  return audioStreamStart(stream, queueSlot[0])
}

func audioStreamStart(stream: Stream, queue: i64) -> i64 {
  for (k = 0; k < streamBufferCount(); k = k + 1) {
    audioPrime(stream, queue)
  }
  let code: i64 = AudioQueueStart(queue, 0).toI64()
  if (code == 0) {
    audioWait(stream)
  }
  AudioQueueStop(queue, 1)
  AudioQueueDispose(queue, 1)
  return code
}

func audioWait(stream: Stream) -> i64 {
  for (nap = 0; nap < 720000; nap = nap + 1) {
    if (streamFinished(stream) && stream.progress[2] <= 0) {
      return 0
    }
    usleep(5000)
  }
  return 1
}
