import "../../../core/tests/programs/Check.poly"
import "../Stream.poly"
import "../../audio/Sound.poly"
extern func calloc(count: i64, size: i64) -> i64

func numbering(state: i64, buf: ptr<float>, frames: i64, first: i64) -> i64 {
  let calls: ptr<i64> = state.toPtr()
  calls[0] = calls[0] + 1
  for (i = 0; i < frames; i = i + 1) {
    buf[i * 2] = (first + i).toFloat()
    buf[i * 2 + 1] = (first + i).toFloat()
  }
  return frames
}

func shortSound(state: i64, buf: ptr<float>, frames: i64, first: i64) -> i64 {
  var made: i64 = frames
  if (first + made > 5) {
    made = 5 - first
  }
  if (made < 0) {
    made = 0
  }
  for (i = 0; i < made; i = i + 1) {
    buf[i] = 1.0
  }
  return made
}

func counting(seconds: float, volume: float) -> Stream {
  let fill: ptr<func(i64, ptr<float>, i64, i64) -> i64 > = numbering
  return streamNew(fill, calloc(1, 8), 2, 1000, seconds, volume)
}

func checkFeedAsksForConsecutiveFrames() -> double {
  let stream: Stream = counting(0.0, 1.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  let first: i64 = streamFeed(stream, buf, 4)
  let second: i64 = streamFeed(stream, buf, 4)
  return offInt(first, 4) + offInt(second, 4) + off(buf[0], 4.0) + off(buf[1], 4.0) + off(buf[6], 7.0)
}

func checkProgressCounts() -> double {
  let stream: Stream = counting(0.0, 1.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  streamFeed(stream, buf, 4)
  streamFeed(stream, buf, 3)
  return offInt(stream.progress[0], 7) + offInt(stream.progress[3], 2)
}

func checkTimeLimitCutsLastBuffer() -> double {
  let stream: Stream = counting(0.01, 1.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  let a: i64 = streamFeed(stream, buf, 4)
  let b: i64 = streamFeed(stream, buf, 4)
  let c: i64 = streamFeed(stream, buf, 4)
  let d: i64 = streamFeed(stream, buf, 4)
  return offInt(a, 4) + offInt(b, 4) + offInt(c, 2) + offInt(d, 0)
}

func checkFinishedOnlyAfterTheEnd() -> double {
  let stream: Stream = counting(0.004, 1.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  var wrong: i64 = 0
  if (streamFinished(stream)) {
    wrong = wrong + 1
  }
  streamFeed(stream, buf, 4)
  if (streamFinished(stream)) {
    wrong = wrong + 1
  }
  streamFeed(stream, buf, 4)
  if (streamFinished(stream) == false) {
    wrong = wrong + 1
  }
  return offInt(wrong, 0)
}

func checkFillFunctionEndsTheSound() -> double {
  let fill: ptr<func(i64, ptr<float>, i64, i64) -> i64 > = shortSound
  let stream: Stream = streamNew(fill, 0, 1, 1000, 0.0, 1.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  let a: i64 = streamFeed(stream, buf, 4)
  let b: i64 = streamFeed(stream, buf, 4)
  let c: i64 = streamFeed(stream, buf, 4)
  return offInt(a, 4) + offInt(b, 1) + offInt(c, 0) + offInt(stream.progress[1], 1)
}

func checkVolumeScales() -> double {
  let stream: Stream = counting(0.0, 0.5)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  streamFeed(stream, buf, 4)
  return off(buf[6], 1.5) + off(buf[7], 1.5)
}

func checkSilentVolume() -> double {
  let stream: Stream = counting(0.0, 0.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  streamFeed(stream, buf, 4)
  return off(buf[6], 0.0)
}

func checkSoundStreamPlaysTheSound() -> double {
  let s: Sound = soundNewChannels(0.005, 1000, 2)
  for (i = 0; i < 5; i = i + 1) {
    s.samples[i * 2] = (i + 1).toFloat()
    s.samples[i * 2 + 1] = (i + 1).toFloat() * 10.0
  }
  let stream: Stream = soundStream(s, 1.0)
  let buf: ptr<float> = calloc(8, 4).toPtr()
  let a: i64 = streamFeed(stream, buf, 4)
  let firstBuffer: double = off(buf[0], 1.0) + off(buf[1], 10.0) + off(buf[6], 4.0) + off(buf[7], 40.0)
  let b: i64 = streamFeed(stream, buf, 4)
  let secondBuffer: double = off(buf[0], 5.0) + off(buf[1], 50.0)
  let c: i64 = streamFeed(stream, buf, 4)
  return offInt(stream.channels, 2) + offInt(stream.rate, 1000) + offInt(a, 4) + offInt(b, 1) + offInt(c, 0) + firstBuffer + secondBuffer
}
