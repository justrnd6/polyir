import "../Metal.poly"
import "shared/picture.poly"
import "shared/scene.poly"
extern func calloc(count: i64, size: i64) -> i64

func main() -> i64 {
  let w: i64 = 320
  let h: i64 = 180
  let n: i64 = w * h
  let cam: ptr<float> = calloc(28, 4).toPtr()
  let tex: ptr<float> = calloc(1, 4).toPtr()
  buildCamera(cam, w, h)
  let device: i64 = metalDevice()
  if (device == 0) {
    return 10
  }
  let pipeline: i64 = metalPipeline(device, metalReadFile("raytrace.metal"), "trace")
  if (pipeline == 0) {
    return 11
  }
  let out: i64 = metalEmptyBuffer(device, n * 4)
  if (metalDispatch(device, pipeline, n, metalBuffer(device, cam.toI64(), 112), metalBuffer(device, tex.toI64(), 4), out, 0) == 0) {
    return 12
  }
  let gpu: ptr<float> = metalContents(out).toPtr()
  savePicture("raytrace.pgm", gpu, w, h)
  return compareWithCpu(gpu, cam, tex, n)
}

func compareWithCpu(gpu: ptr<float>, cam: ptr<float>, tex: ptr<float>, n: i64) -> i64 {
  var differ: i64 = 0
  for (i = 0; i < n; i = i + 1) {
    var gap: float = gpu[i] - trace(i, cam, tex)
    if (gap < 0.0) {
      gap = (0.0 - gap)
    }
    if (gap > 0.01) {
      differ = differ + 1
    }
  }
  if (differ > 20) {
    return 13
  }
  return 0
}
