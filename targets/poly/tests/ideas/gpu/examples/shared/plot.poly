func drawStems(pic: ptr<float>, w: i64, h: i64, values: ptr<float>, n: i64, low: float, high: float) -> i64 {
  for (k = 0; k < w * h; k = k + 1) {
    pic[k] = 0.96
  }
  let zero: i64 = (high / (high - low) * h.toFloat()).toI64()
  for (x = 0; x < w; x = x + 1) {
    pic[zero * w + x] = 0.55
  }
  for (j = 0; j < n; j = j + 1) {
    let column: i64 = ((j.toFloat() + 0.5) * w.toFloat() / n.toFloat()).toI64()
    var top: i64 = ((high - values[j]) / (high - low) * (h - 1).toFloat()).toI64()
    if (top < 0) {
      top = 0
    }
    if (top > h - 1) {
      top = h - 1
    }
    let from: i64 = minOf(top, zero)
    let to: i64 = maxOf(top, zero)
    for (y = from; y <= to; y = y + 1) {
      pic[y * w + column] = 0.1
    }
    for (dy = 0 - 1; dy <= 1; dy = dy + 1) {
      for (dx = 0 - 1; dx <= 1; dx = dx + 1) {
        let yy: i64 = top + dy
        let xx: i64 = column + dx
        if (yy >= 0 && yy < h && xx >= 0 && xx < w) {
          pic[yy * w + xx] = 0.1
        }
      }
    }
  }
  return 0
}

func minOf(a: i64, b: i64) -> i64 {
  if (a < b) {
    return a
  }
  return b
}

func maxOf(a: i64, b: i64) -> i64 {
  if (a > b) {
    return a
  }
  return b
}

func drawWave(pic: ptr<float>, w: i64, h: i64, values: ptr<float>, n: i64, low: float, high: float) -> i64 {
  for (k = 0; k < w * h; k = k + 1) {
    pic[k] = 0.96
  }
  let zero: i64 = (high / (high - low) * h.toFloat()).toI64()
  for (x = 0; x < w; x = x + 1) {
    pic[zero * w + x] = 0.55
  }
  for (x = 0; x < w; x = x + 1) {
    let from: i64 = x * n / w
    var upto: i64 = (x + 1) * n / w
    if (upto <= from) {
      upto = from + 1
    }
    var lowest: float = values[from]
    var highest: float = values[from]
    for (j = from; j < upto; j = j + 1) {
      if (values[j] < lowest) {
        lowest = values[j]
      }
      if (values[j] > highest) {
        highest = values[j]
      }
    }
    var top: i64 = ((high - highest) / (high - low) * (h - 1).toFloat()).toI64()
    var bottom: i64 = ((high - lowest) / (high - low) * (h - 1).toFloat()).toI64()
    if (top < 0) {
      top = 0
    }
    if (bottom > h - 1) {
      bottom = h - 1
    }
    for (y = top; y <= bottom; y = y + 1) {
      pic[y * w + x] = 0.1
    }
  }
  return 0
}

func drawCurve(pic: ptr<float>, w: i64, h: i64, values: ptr<float>, n: i64, low: float, high: float) -> i64 {
  for (k = 0; k < w * h; k = k + 1) {
    pic[k] = 0.96
  }
  let zero: i64 = (high / (high - low) * h.toFloat()).toI64()
  for (x = 0; x < w; x = x + 1) {
    pic[zero * w + x] = 0.55
  }
  var previous: i64 = curveRow(values[0], h, low, high)
  for (x = 0; x < w; x = x + 1) {
    let row: i64 = curveRow(values[x * n / w], h, low, high)
    for (y = minOf(row, previous); y <= maxOf(row, previous); y = y + 1) {
      pic[y * w + x] = 0.1
    }
    previous = row
  }
  return 0
}

func curveRow(value: float, h: i64, low: float, high: float) -> i64 {
  var row: i64 = ((high - value) / (high - low) * (h - 1).toFloat()).toI64()
  if (row < 0) {
    row = 0
  }
  if (row > h - 1) {
    row = h - 1
  }
  return row
}
