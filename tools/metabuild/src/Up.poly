// `poly <goal> [target]`: the runner. It reads the Polyfile, asks the core for the plan, writes the files that
// changed and runs the goal's steps — the only part of meta-build that touches the machine (through the host layer,
// so it runs in the interpreter).
//
//   poly up            gen, check, build every target, then run each and compare  (the default)
//   poly gen           write the generated projects only, to read or to build by hand
//   poly build [T]     build every target, or T
//   poly run [T]       build and run T (the Polyfile's `target` when none is given)
//   poly test          run every target and compare what they give
//   poly tasks         the goals, and each target's steps
//   poly clean         remove build/
//   poly NAME          a goal the project's build.poly adds (Extend.poly)
import "Host.poly"
import "Polyfile.poly"
import "Plan.poly"
import "Extend.poly"

func main() -> i64 {
  let words: mutarray<string> = args()
  let goal: string = firstOr(words, "up")
  let only: string = wordAfterFirst(words)
  return up(goal, only)
}

func up(goal: string, only: string) -> i64 {
  let p: Project = readProject(workingDir())
  if (len(p.problems) > 0) {
    print(p.problems.join("\n"))
    return 2
  }
  let made: Plan = plan(p)
  extend(p, made)
  return runGoal(p, made, goal, only)
}

func readProject(dir: string) -> Project {
  return readPolyfile(readText("${dir}/Polyfile"), dir, Host(os: os(), cpu: cpu()))
}

func runGoal(p: Project, out: Plan, goal: string, only: string) -> i64 {
  if (goal == "tasks") {
    return listTasks(out)
  }
  if (goal == "clean") {
    return cleaned(removePath("build"))
  }
  writeChanged(out)
  if (goal == "gen") {
    return 0
  }
  return runSteps(p, out, goal, only)
}

func cleaned(ok: bool) -> i64 {
  if (ok) {
    return 0
  }
  return 1
}

// Writes each generated file whose text is new, so the tools' own up-to-date checks stay warm.
func writeChanged(out: Plan) -> void {
  for (f in out.files) {
    if (readText(f.path) != f.text) {
      writeText(f.path, f.text)
      say("wrote", f.path, "")
    }
  }
}

// The steps the goal needs, in order; the first to fail stops its target (the other targets go on). `up` and
// `test` then compare what the targets' programs gave.
func runSteps(p: Project, out: Plan, goal: string, only: string) -> i64 {
  if (runTarget(out, "", goal) < 0) {
    return 1
  }
  if (!isGoal(goal)) {
    return 0
  }
  let results: mutarray<string>
  var failed: i64 = 0
  for (t in targetsFor(p, goal, only)) {
    let status: i64 = runTarget(out, t, goal)
    results.push("${t}: ${status}")
    failed = failed + checkFailed(status)
  }
  return failed + compared(goal, results)
}

func targetsFor(p: Project, goal: string, only: string) -> mutarray<string> {
  if (only != "") {
    return [only]
  }
  if (goal == "run") {
    return [p.target]
  }
  return p.targets
}

// The target's checks, then its steps up to the goal: its run step's exit status, or -1 when a step failed. Target
// "" is the whole project's tasks (build.poly's), which run first.
func runTarget(out: Plan, target: string, goal: string) -> i64 {
  var status: i64 = 0
  for (s in out.steps) {
    if (s.target == target && status >= 0 && wanted(s.goal, goal)) {
      status = runStep(s)
    }
  }
  return status
}

func runStep(s: Step) -> i64 {
  if (s.output != "") {
    return written(s)
  }
  say(s.goal, s.target, s.cmd.join(" "))
  if (!located(s)) {
    return 0 - 1
  }
  let status: i64 = showWith(s.cmd, s.dir, toolEnv(s.cmd[0]))
  if (status != 0 && s.goal != "run") {
    print("  failed (${status}): ${s.hint}")
    return 0 - 1
  }
  return status
}

// A step whose output is a file: the program polyir generates for a target.
func written(s: Step) -> i64 {
  if (!located(s)) {
    return 0 - 1
  }
  let r: Ran = run(s.cmd, s.dir)
  if (r.code != 0) {
    print("  ${s.cmd.join(" ")} failed: ${r.err}")
    return 0 - 1
  }
  if (readText(s.output) != r.out) {
    writeText(s.output, r.out)
    say("wrote", s.output, "")
  }
  return 0
}

// Spells the step's tool the way this machine finds it, or says how to get it when it is nowhere.
func located(s: Step) -> bool {
  let tool: string = toolPath(s.cmd[0])
  if (tool == "") {
    print("  ${s.cmd[0]} is not installed: ${s.hint}")
    return false
  }
  s.cmd[0] = tool
  return true
}

// How a tool is spelled on this machine: a path as it is, else what `toolSearch` finds; "" when it is nowhere.
func toolPath(tool: string) -> string {
  if (tool.contains("/")) {
    return tool
  }
  return shellWord(toolSearch(tool))
}

// A tool found off PATH runs with its own folder first on PATH, so what it starts (npm's `node`) is found too.
func toolEnv(tool: string) -> mutarray<string> {
  let folder: string = tool.slice(0, lastSlash(tool))
  return ["PATH=${folder}:${env("PATH")}"]
}

func lastSlash(path: string) -> i64 {
  var at: i64 = 0
  for (i = 0; i < len(path); i = i + 1) {
    if (path[i] == '/') {
      at = i
    }
  }
  return at
}

func shellWord(line: string) -> string {
  return run(["sh", "-c", line], ".").out.trim()
}

func checkFailed(status: i64) -> i64 {
  if (status < 0) {
    return 1
  }
  return 0
}

// After `up` or `test`: one line per target, then whether the ones that ran all gave the same (a target that did not
// build is reported, and counted as a failure by `runSteps`, but is not a disagreement).
func compared(goal: string, results: mutarray<string>) -> i64 {
  if (goal != "up" && goal != "test") {
    return 0
  }
  let ran: mutarray<string>
  for (r in results) {
    if (valueOf(r) == "-1") {
      print("${r.slice(0, r.find(":"))}: did not build")
    } else {
      print(r)
      ran.push(r)
    }
  }
  return agreement(ran)
}

func agreement(ran: mutarray<string>) -> i64 {
  if (len(ran) == 0) {
    print("no target ran")
    return 1
  }
  if (allSame(ran)) {
    print("every target that ran gave ${valueOf(ran[0])}")
    return 0
  }
  print("the targets disagree")
  return 1
}

func allSame(results: mutarray<string>) -> bool {
  for (r in results) {
    if (valueOf(r) != valueOf(results[0])) {
      return false
    }
  }
  return true
}

func valueOf(result: string) -> string {
  return result.slice(result.find(": ") + 2, len(result))
}

func listTasks(out: Plan) -> i64 {
  print("goals: ${allGoals(out).join(" ")}")
  for (s in out.steps) {
    say(s.goal, s.target, s.cmd.join(" "))
  }
  return 0
}

// meta-build's goals, then the ones build.poly's tasks add.
func allGoals(out: Plan) -> mutarray<string> {
  let all: mutarray<string> = goals()
  for (s in out.steps) {
    if (!isGoal(s.goal) && !inList(all, s.goal)) {
      all.push(s.goal)
    }
  }
  return all
}

func inList(words: mutarray<string>, word: string) -> bool {
  for (w in words) {
    if (w == word) {
      return true
    }
  }
  return false
}

// One line of progress: `> build java   gradle -p build/gradle-java installDist`.
func say(what: string, target: string, detail: string) -> void {
  print("> ${what} ${target}   ${detail}".trim())
}

func wordAfterFirst(words: mutarray<string>) -> string {
  if (len(words) < 2) {
    return ""
  }
  return words[1]
}
